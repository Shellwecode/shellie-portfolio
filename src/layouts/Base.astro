---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import TopBar from '../components/TopBar.astro';
import WhisperPill from '../components/WhisperPill.astro';
import NowRail from '../components/NowRail.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** 'pill' (default) floats the whisper pill; 'none' for reading pages that dock their own progress bar. */
  deck?: 'pill' | 'none';
}

const {
  title = 'Shellie Hu',
  description = "Product designer in Boston. Empathetic, quiet interfaces.",
  deck = 'pill',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    {/* Fonts — Inter (variable) + JetBrains Mono. Swap for self-hosted later. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    {/* Set theme + nav state before first paint to avoid flash. */}
    <script is:inline>
      (function () {
        function apply() {
          try {
            var saved = localStorage.getItem('theme');
            var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            if (localStorage.getItem('nav') === 'collapsed') {
              document.documentElement.setAttribute('data-nav', 'collapsed');
            } else {
              document.documentElement.removeAttribute('data-nav');
            }
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <SideNav />
      <div class="shell-main">
        <TopBar />
        <main class="shell-content">
          <slot />
        </main>
      </div>
    </div>
    {deck === 'pill' && (
      <>
        <WhisperPill />
        <NowRail />
      </>
    )}
  </body>
</html>

<style>
  .shell {
    display: flex;
    flex-direction: row;
    width: 100%;
    flex: 1;
    min-height: 100dvh;
  }
  .shell-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    padding: 0 3rem 5.5rem 3rem; /* 48px inline per mock; bottom clears the pill */
  }
  .shell-content { padding-top: 1.75rem; flex: 1; }

  /* Collapsed dock floats — give content room to breathe past it */
  :global(html[data-nav='collapsed']) .shell-main { padding-left: 6.5rem; }

  @media (max-width: 768px) {
    .shell-main { padding: 0 1.5rem 5rem 1.5rem; }
    :global(html[data-nav='collapsed']) .shell-main { padding-left: 1.5rem; }
  }
</style>
