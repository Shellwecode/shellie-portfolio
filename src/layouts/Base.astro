---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import TopBar from '../components/TopBar.astro';
import WhisperPill from '../components/WhisperPill.astro';
import NowRail from '../components/NowRail.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** 'pill' (default) floats the whisper pill; 'none' for reading pages that dock their own progress bar. */
  deck?: 'pill' | 'none';
  /** Edge fog (ol.studio treatment) — reserved for long-scrolling reading pages. */
  fog?: boolean;
}

const {
  title = 'Shellie Hu',
  description = "Product designer in Boston. Empathetic, quiet interfaces.",
  deck = 'pill',
  fog = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    {/* Fonts — Aileron + Junicode VF, fully self-hosted (global.css). */}
    <link rel="preload" href="/fonts/Aileron-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JunicodeVF-Italic.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    {/* Set theme + nav state before first paint to avoid flash. */}
    <script is:inline>
      (function () {
        function apply() {
          try {
            var saved = localStorage.getItem('theme');
            var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            if (localStorage.getItem('nav') === 'open') {
              document.documentElement.setAttribute('data-nav', 'open');
            } else {
              document.documentElement.removeAttribute('data-nav');
            }
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);

        /* Entrance plays once per session, never on in-app navigations. */
        try {
          if (!sessionStorage.getItem('entered')) {
            document.documentElement.setAttribute('data-entrance', '');
            sessionStorage.setItem('entered', '1');
          }
        } catch (e) {}
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.removeAttribute('data-entrance');
        });
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <div class="shell-main">
        <TopBar />
        <main class="shell-content">
          <slot />
        </main>
      </div>
    </div>
    {fog && <div class="edge-fog edge-fog--bottom" aria-hidden="true"></div>}
    <SideNav />
    {deck === 'pill' && <WhisperPill />}
    <NowRail />

    <script>
      // Lenis smooth scroll — the ol.studio glide. Skipped for reduced motion.
      // Exposed on window so floating instruments (chapter player) can scrollTo
      // through Lenis — native smooth scrolling loses to its raf loop.
      import Lenis from 'lenis';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        (window as any).lenis = new Lenis({ autoRaf: true });
      }
    </script>
  </body>
</html>

<style>
  .shell {
    display: flex;
    flex-direction: row;
    width: 100%;
    flex: 1;
    min-height: 100dvh;
  }
  .shell-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    /* Laptop: exactly the 120px dock lane (per the Landing frame);
       wide desktop: true centering takes over. */
    padding: 48px var(--shell-pad-r) 5.5rem var(--shell-pad-l);
  }
  @media (min-width: 1600px) {
    .shell-main {
      padding-left: max(var(--shell-pad-l), calc((100dvw - var(--content-cap)) / 2));
    }
  }
  .shell-main > :global(*) { max-width: var(--content-cap); }
  .shell-content { padding-top: var(--shell-pad-top); flex: 1; }

  @media (max-width: 768px) {
    .shell-main { padding: 0 1.5rem 5rem 1.5rem; }
  }
</style>
