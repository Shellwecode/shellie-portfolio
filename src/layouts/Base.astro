---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import NowPlayer from '../components/NowPlayer.astro';
import MobileDock from '../components/MobileDock.astro';
import { ClientRouter } from 'astro:transitions';
// SideNav (the droplet dock) is parked — the girl + worn word nav carries
// wayfinding now. import SideNav from '../components/SideNav.astro';

interface Props {
  title?: string;
  description?: string;
  /** 'pill' (default) floats the whisper pill (it ducks when idle), matching
      the top bar's "now". 'none' for reading pages (they dock their own
      instrument). 'mobile' for the work shelf: desktop keeps the stage clear
      for the covers, but phones keep the dock's now-seat — without it the
      five icons stretch to fill the pill and the dock reads differently
      page to page. */
  deck?: 'pill' | 'mobile' | 'none';
  /** Edge fog (ol.studio treatment) — reserved for long-scrolling reading pages.
      'thin' starts at the reading-mode strength (case studies get there via
      html[data-reading]; writing pages are born reading). */
  fog?: boolean | 'thin';
  /** Reading pages: the dock recedes when not hovered/focused. */
  quietDock?: boolean;
  /** Voice case studies: once reading, the player's ⏮ owns "back" — the
      top bar's crumb bows out (html[data-reading] + this flag). */
  crumbVoice?: boolean;
  /** Landing only: the galaxy opening plays first and owns the entrance trigger. */
  opening?: boolean;
  /** Phones: the floating menu dock. On everywhere the nav should follow;
      reading pages turn it off — the chapter pill owns their bottom edge. */
  dock?: boolean;
}

const {
  title = 'Shellie Hu',
  description = "Product designer in Boston. Empathetic, quiet interfaces.",
  deck = 'pill',
  fog = false,
  quietDock = false,
  crumbVoice = false,
  opening = false,
  dock = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-quiet-dock={quietDock || undefined} data-crumb-voice={crumbVoice || undefined} data-opening={opening || undefined} data-deck-mobile={deck === 'mobile' || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* the same face for phones — iOS ignores SVG favicons */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph — the shared-link card (iMessage, Slack, socials) wears
        the same face as the tab */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    {/* Fonts — Aileron + Junicode VF, fully self-hosted (global.css). */}
    <link rel="preload" href="/fonts/Aileron-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JunicodeVF-Italic.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    {/* Set theme + nav state before first paint to avoid flash. */}
    <script is:inline>
      (function () {
        function apply() {
          try {
            var saved = localStorage.getItem('theme');
            var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            if (localStorage.getItem('nav') === 'open') {
              document.documentElement.setAttribute('data-nav', 'open');
            } else {
              document.documentElement.removeAttribute('data-nav');
            }
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);

        /* Entrance plays once per session, never on in-app navigations.
           When the galaxy opening owns the page (data-opening), it defers:
           OpeningDirector fires data-entrance + 'entered' at release, so the
           landing rises as the overlay lifts. Reduced motion skips the
           opening, so entrance behaves as before there. */
        try {
          var deferToOpening =
            document.documentElement.hasAttribute('data-opening') &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!sessionStorage.getItem('entered') && !deferToOpening) {
            document.documentElement.setAttribute('data-entrance', '');
            sessionStorage.setItem('entered', '1');
          }
        } catch (e) {}
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.removeAttribute('data-entrance');
        });
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <div class="shell-main">
        <TopBar />
        <main class="shell-content">
          <slot />
        </main>
      </div>
    </div>
    {fog && <div class:list={['edge-fog', 'edge-fog--bottom', { 'edge-fog--thin': fog === 'thin' }]} aria-hidden="true"></div>}
    {/* <SideNav /> — parked for the girl + worn word nav; the dock returns by
        uncommenting this and its import. */}
    {/* deck 'mobile' mounts the player too — html[data-deck-mobile] hides it
        on desktop (an html attribute, not a prop on the persisted element,
        so soft navs re-decide it per page). */}
    {deck !== 'none' && <NowPlayer />}
    {/* phones trade the now pill for the menu dock; where the now player
        lives, the dock's last seat switches over to it (html[data-mpill]).
        Reading pages opt out — the chapter pill owns their bottom edge. */}
    {dock && <MobileDock hasNow={deck !== 'none'} />}

    <script>
      // Lenis smooth scroll — the ol.studio glide. Skipped for reduced motion.
      // Exposed on window so floating instruments (chapter player) can scrollTo
      // through Lenis — native smooth scrolling loses to its raf loop.
      import Lenis from 'lenis';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        (window as any).lenis = new Lenis({ autoRaf: true });
      }

      // Card cover videos play only while hovered; the still cover holds the
      // frame at rest. Leaving pauses without resetting — a return resumes.
      function wireCardVideos() {
        document.querySelectorAll<HTMLVideoElement>('.card-video').forEach((video) => {
          const card = video.closest('.card, .card-link');
          if (!card || (card as HTMLElement).dataset.videoWired) return;
          (card as HTMLElement).dataset.videoWired = '1';
          card.addEventListener('mouseenter', () => video.play().catch(() => {}));
          card.addEventListener('mouseleave', () => video.pause());
        });
      }
      // Videos arriving via a soft nav never start fetching — the ClientRouter
      // parses the next page in a detached document, and media elements
      // adopted from one stay suspended until load() is called. (A hard
      // refresh never hits this; images recover on their own.)
      function reviveSwappedVideos() {
        document.querySelectorAll<HTMLVideoElement>('video[src]').forEach((v) => {
          const started = v.readyState > 0 || v.networkState === HTMLMediaElement.NETWORK_LOADING;
          if (started) return;
          v.load();
          if (v.autoplay) v.play().catch(() => {});
        });
      }
      wireCardVideos();
      document.addEventListener('astro:page-load', () => {
        wireCardVideos();
        reviveSwappedVideos();
      });
    </script>
  </body>
</html>

<style>
  .shell {
    display: flex;
    flex-direction: row;
    width: 100%;
    flex: 1;
    min-height: 100dvh;
  }
  .shell-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    /* Laptop: exactly the 120px dock lane (per the Landing frame);
       wide desktop: true centering takes over. */
    padding: 48px var(--shell-pad-r) 5.5rem var(--shell-pad-l);
  }
  /* 1440px real = 1600px layout px under the baked-in 0.9 zoom; 100% (the
     shell's laid-out width) instead of 100dvw so the centering math sees the
     zoom-stretched width, not the raw viewport. */
  @media (min-width: 1440px) {
    .shell-main {
      padding-left: max(var(--shell-pad-l), calc((100% - var(--content-cap)) / 2));
    }
  }
  .shell-main > :global(*) { max-width: var(--content-cap); }
  .shell-content { padding-top: var(--shell-pad-top); flex: 1; }

  @media (max-width: 768px) {
    .shell-main { padding: 0 1.5rem 5rem 1.5rem; }
  }
</style>
