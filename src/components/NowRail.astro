---
import now from '../data/now.json';

// The deck, opened. Glass rail summoned by the whisper pill (or the "now" link).
// Content passes beneath it — that's what earns the glass. Esc / ✕ / pill closes.
---

<aside class="now-rail glass" id="now-rail" aria-label="Right now" aria-hidden="true">
  <div class="rail-head">
    <span class="rail-label">right now</span>
    <button class="rail-close" data-rail-close aria-label="Close">esc ✕</button>
  </div>
  <div class="rail-playing">
    <div class="rail-art" aria-hidden="true"></div>
    <span class="rail-song">{now.listening.title.toLowerCase()} — {now.listening.artist.toLowerCase()}</span>
    <div class="rail-scrub">
      <span class="rail-time">{now.listening.note}</span>
    </div>
    <div class="rail-track"><span class="rail-needle"></span></div>
  </div>
  <div class="rail-divider"></div>
  <div class="rail-module">
    <span class="rail-label">reading</span>
    <span class="rail-value">{now.reading}</span>
  </div>
  <div class="rail-divider"></div>
  <div class="rail-module">
    <span class="rail-label">building</span>
    <span class="rail-value">
      {now.building.label.split(' ·')[0]} · <a href={now.building.href}>follow along</a>
    </span>
  </div>
  <div class="rail-spacer"></div>
  <p class="rail-thought">"{now.thought}"</p>
</aside>

<style>
  .now-rail {
    position: fixed;
    right: 16px;
    top: 16px;
    bottom: 76px; /* clears the whisper pill's altitude */
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 14px;
    z-index: 45;
    /* closed state */
    opacity: 0;
    transform: translateX(12px);
    pointer-events: none;
    transition:
      opacity var(--motion-content) ease,
      transform var(--motion-content) ease;
  }
  :global(html[data-rail='open']) .now-rail {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .rail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .rail-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }
  .rail-close {
    background: none;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    cursor: pointer;
    padding: 0.25rem;
    transition: color var(--motion-micro) ease;
  }
  .rail-close:hover { color: var(--color-accent); }

  .rail-playing { display: flex; flex-direction: column; gap: 0.625rem; }
  .rail-art {
    width: 100%;
    height: 150px;
    background: var(--color-rule);
    border-radius: 10px;
  }
  .rail-song { font-size: 0.9375rem; font-weight: 500; }
  .rail-scrub { display: flex; justify-content: space-between; }
  .rail-time {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-muted);
  }
  .rail-track {
    width: 100%;
    height: 2px;
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
  }
  .rail-needle {
    display: block;
    width: 55%;
    height: 2px;
    background: var(--color-accent);
  }

  .rail-divider { height: 1px; background: var(--color-rule); }
  .rail-module { display: flex; flex-direction: column; gap: 0.25rem; }
  .rail-value { font-size: 0.875rem; }
  .rail-spacer { flex: 1; }
  .rail-thought {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-ink-muted);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .now-rail { left: 16px; width: auto; top: auto; max-height: 70dvh; }
  }
</style>

<script>
  function setRail(open: boolean) {
    const html = document.documentElement;
    if (open) html.setAttribute('data-rail', 'open');
    else html.removeAttribute('data-rail');
    document.getElementById('now-rail')?.setAttribute('aria-hidden', String(!open));
    document.querySelectorAll('[data-deck-toggle]').forEach((el) =>
      el.setAttribute('aria-expanded', String(open)),
    );
  }
  function railIsOpen() {
    return document.documentElement.getAttribute('data-rail') === 'open';
  }
  function wireRail() {
    // Anything marked data-deck-toggle (whisper pill, topbar "now") toggles the rail.
    document.querySelectorAll('[data-deck-toggle]').forEach((el) =>
      el.addEventListener('click', () => setRail(!railIsOpen())),
    );
    document.querySelectorAll('[data-rail-close]').forEach((el) =>
      el.addEventListener('click', () => setRail(false)),
    );
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && railIsOpen()) setRail(false);
    if ((e.key === 'n' || e.key === 'N') && !e.metaKey && !e.ctrlKey) {
      const target = e.target as HTMLElement;
      if (target.tagName !== 'INPUT' && target.tagName !== 'TEXTAREA') setRail(!railIsOpen());
    }
  });
  wireRail();
  document.addEventListener('astro:after-swap', () => {
    setRail(false); // arriving on a new page closes the rail
    wireRail();
  });
</script>
