---
// The dock's mobile comeback — on phones the floating pill belongs to the
// MENU, not the now player (her call, 2026-08-19). Five Lucide glyphs (the
// parked SideNav's set) ride a paper pill at the pill altitude; the last
// seat wears the now-playing album art and SWITCHES instruments: tap it and
// the dock folds to a small round handle at the left while the now pill
// takes the stage; tap the handle to call the menu back. Desktop never sees
// any of this. Mode rides html[data-mpill] + sessionStorage.
import now from '../data/now.json';

interface Props {
  /** whether this page mounts the now player — without it the switch seat
      would open onto an empty stage, so it stays home */
  hasNow?: boolean;
}
const { hasNow = false } = Astro.props;

const items = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/projects', label: 'work' },
  { href: '/writing', label: 'writing' },
  { href: '/doodles', label: 'doodle' },
];

// 24-viewBox glyphs, ~1.5px optical stroke, round caps (SideNav keeps its
// own copy — it's parked; when it returns, extract both to a shared lib).
const glyphs: Record<string, string> = {
  home:
    '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  about: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  work:
    '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>',
  writing: '<circle cx="8" cy="18" r="4"/><path d="M12 18V2l7 4"/>',
  doodle:
    '<circle cx="11.5" cy="12.5" r="3.5"/><path d="M3 8c0-3.5 2.5-6 6.5-6 5 0 4.83 3 7.5 5s5 2 5 6c0 4.5-2.5 6.5-7 6.5-2.5 0-2.5 2.5-6 2.5s-7-2-7-5.5c0-3 1.5-3 1.5-5C3.5 10 3 9 3 8Z"/>',
};

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav class="mdock" data-mdock aria-label="Site navigation">
  <button type="button" class="mdock-back" data-mpill-nav aria-label="Back to the menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>
  <div class="mdock-row">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={['mdock-item', { active: isActive(item.href) }]}
        aria-label={item.label}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyphs[item.label]} />
      </a>
    ))}
    {hasNow && (
      <span class="mdock-sep" aria-hidden="true"></span>
    )}
    {hasNow && (
      <button type="button" class="mdock-nowseat" data-mpill-now aria-label="Now playing">
        <span class="mdock-art" style={`background-image: url(${now.listening.cover})`} aria-hidden="true"></span>
      </button>
    )}
  </div>
</nav>

<style>
  .mdock {
    display: none; /* phones only — desktop keeps the top bar + now pill */
  }
  @media (max-width: 768px) {
    .mdock {
      position: fixed;
      left: 16px;
      bottom: var(--pill-bottom);
      display: flex;
      align-items: center;
      width: calc(100vw - 32px);
      height: 58px;
      border-radius: 999px;
      z-index: 50;
      /* the pill paper, same recipe as the now player at rest */
      background: color-mix(in oklab, #4c6fa5 9%, var(--color-bg));
      box-shadow:
        0px 1px 2px rgb(0 0 0 / 0.05),
        0px 12px 36px -8px color-mix(in oklab, var(--color-ink) 16%, transparent);
      transition: width 320ms cubic-bezier(0.3, 0, 0.2, 1);
    }
    /* now mode: the menu folds to a round handle; the now pill has the stage */
    :global(html[data-mpill='now']) .mdock { width: 58px; }
    :global(html[data-mpill='now']) .mdock .mdock-row { display: none; }
    .mdock-back { display: none; }
    :global(html[data-mpill='now']) .mdock .mdock-back {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      border-radius: inherit;
      background: none;
      color: var(--color-ink-muted);
      cursor: pointer;
    }
    .mdock-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0 10px 0 6px;
    }
    .mdock-item {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      color: var(--color-ink-muted);
    }
    .mdock-item.active { color: var(--color-accent); }
    .mdock-item:active { scale: 0.94; }
    .mdock-sep {
      width: 1px;
      height: 22px;
      background: color-mix(in oklab, var(--color-ink) 14%, transparent);
    }
    .mdock-nowseat {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .mdock-nowseat:active { scale: 0.94; }
    .mdock-art {
      display: block;
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background-size: cover;
      background-position: center;
      box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 10%, transparent);
    }
  }
</style>

<script>
  function wireMobileDock() {
    const dock = document.querySelector('[data-mdock]') as HTMLElement | null;
    if (!dock || dock.dataset.wired) return;
    dock.dataset.wired = '1';
    const root = document.documentElement;
    const apply = (mode: string) => {
      root.setAttribute('data-mpill', mode);
      try {
        sessionStorage.setItem('mpill', mode);
      } catch {
        /* private mode — the choice just doesn't persist */
      }
    };
    let saved = 'nav';
    try {
      saved = sessionStorage.getItem('mpill') ?? 'nav';
    } catch {
      /* ditto */
    }
    apply(saved);
    document.addEventListener('astro:after-swap', () => apply(root.getAttribute('data-mpill') ?? 'nav'));
    dock.querySelector('[data-mpill-now]')?.addEventListener('click', () => apply('now'));
    dock.querySelector('[data-mpill-nav]')?.addEventListener('click', () => apply('nav'));
  }
  wireMobileDock();
  document.addEventListener('astro:page-load', wireMobileDock);
</script>
