---
// DialKit-style dev panel (vanilla — no React runtime in this site).
// Sliders bind to the layout tokens in global.css and update the live page.
// "copy css" exports the changed values as a :root block ready for @theme.
// Rendered only in dev (see Base.astro).
---

<div class="dials glass" id="dials">
  <div class="dials-head">
    <span>layout dials</span>
    <div class="dials-actions">
      <button data-dials-copy title="Copy changed values as CSS">copy css</button>
      <button data-dials-reset title="Reset all to defaults">reset</button>
      <button data-dials-min title="Collapse">–</button>
    </div>
  </div>
  <div class="dials-body" data-dials-body></div>
</div>

<style>
  .dials {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 264px;
    z-index: 100;
    border-radius: 12px;
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
  }
  .dials.min .dials-body { display: none; }
  .dials-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding-bottom: 6px;
  }
  .dials-actions { display: flex; gap: 6px; }
  .dials button {
    background: none;
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    font: inherit;
    color: var(--color-ink-muted);
    cursor: pointer;
    padding: 2px 6px;
  }
  .dials button:hover { color: var(--color-accent); border-color: var(--color-ink-faint); }
  .dials :global(details) { border-top: 1px solid var(--color-rule); padding: 5px 0; }
  .dials :global(summary) {
    cursor: pointer;
    color: var(--color-ink-muted);
    letter-spacing: 0.04em;
    list-style: none;
    padding: 2px 0;
  }
  .dials :global(summary::before) { content: '▸ '; }
  .dials :global(details[open] summary::before) { content: '▾ '; }
  .dials :global(.dial-row) {
    display: grid;
    grid-template-columns: 82px 1fr 40px;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
  }
  .dials :global(.dial-row label) {
    color: var(--color-ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dials :global(.dial-row output) {
    text-align: right;
    color: var(--color-ink);
  }
  .dials :global(.dial-row.changed output) { color: var(--color-accent); font-weight: 700; }
  .dials :global(input[type='range']) {
    width: 100%;
    accent-color: var(--color-accent);
    height: 2px;
  }
</style>

<script>
  type Dial = { v: string; label: string; def: number; min: number; max: number; step?: number };
  const GROUPS: Record<string, Dial[]> = {
    shell: [
      { v: '--shell-pad-x', label: 'pad-x', def: 48, min: 16, max: 120 },
      { v: '--shell-pad-top', label: 'pad-top', def: 28, min: 0, max: 96 },
      { v: '--nav-w', label: 'nav width', def: 168, min: 120, max: 300 },
      { v: '--nav-inset', label: 'nav inset', def: 16, min: 0, max: 40 },
      { v: '--pill-bottom', label: 'pill bottom', def: 16, min: 0, max: 64 },
    ],
    hero: [
      { v: '--hero-gap', label: 'copy gap', def: 14, min: 4, max: 40 },
      { v: '--hero-pad-b', label: 'pad bottom', def: 28, min: 0, max: 80 },
      { v: '--intro-measure', label: 'intro width', def: 540, min: 360, max: 760 },
      { v: '--illo-w', label: 'illo width', def: 160, min: 80, max: 300 },
      { v: '--illo-mr', label: 'illo right', def: 128, min: 0, max: 400 },
    ],
    cards: [
      { v: '--card-cover-h', label: 'cover height', def: 210, min: 120, max: 400 },
      { v: '--card-gap', label: 'gap', def: 20, min: 4, max: 56 },
      { v: '--radius-md', label: 'radius', def: 16, min: 0, max: 32 },
    ],
    type: [
      { v: '--text-display', label: 'greeting', def: 28, min: 20, max: 44 },
      { v: '--text-section', label: 'section', def: 18, min: 14, max: 26 },
    ],
  };
  const ALL = Object.values(GROUPS).flat();
  const KEY = 'layout-dials';

  function saved(): Record<string, number> {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { return {}; }
  }
  function persist(vals: Record<string, number>) {
    localStorage.setItem(KEY, JSON.stringify(vals));
  }
  function apply(vals: Record<string, number>) {
    for (const d of ALL) {
      if (vals[d.v] !== undefined && vals[d.v] !== d.def) {
        document.documentElement.style.setProperty(d.v, `${vals[d.v]}px`);
      } else {
        document.documentElement.style.removeProperty(d.v);
      }
    }
  }

  function build() {
    const body = document.querySelector('[data-dials-body]');
    if (!body || body.childElementCount) return;
    const vals = saved();
    for (const [group, dials] of Object.entries(GROUPS)) {
      const det = document.createElement('details');
      det.open = group === 'shell';
      const sum = document.createElement('summary');
      sum.textContent = group;
      det.appendChild(sum);
      for (const d of dials) {
        const row = document.createElement('div');
        row.className = 'dial-row';
        const cur = vals[d.v] ?? d.def;
        row.innerHTML = `
          <label title="${d.v}">${d.label}</label>
          <input type="range" min="${d.min}" max="${d.max}" step="${d.step ?? 1}" value="${cur}" data-var="${d.v}" />
          <output>${cur}</output>`;
        if (cur !== d.def) row.classList.add('changed');
        det.appendChild(row);
      }
      body.appendChild(det);
    }
    body.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      if (!input.dataset.var) return;
      const vals2 = saved();
      const def = ALL.find((d) => d.v === input.dataset.var)?.def;
      const num = Number(input.value);
      if (num === def) delete vals2[input.dataset.var];
      else vals2[input.dataset.var] = num;
      persist(vals2);
      apply(vals2);
      const row = input.closest('.dial-row')!;
      row.querySelector('output')!.textContent = input.value;
      row.classList.toggle('changed', num !== def);
    });

    document.querySelector('[data-dials-reset]')?.addEventListener('click', () => {
      persist({});
      apply({});
      body.querySelectorAll<HTMLInputElement>('input[data-var]').forEach((input) => {
        const def = ALL.find((d) => d.v === input.dataset.var)!.def;
        input.value = String(def);
        const row = input.closest('.dial-row')!;
        row.querySelector('output')!.textContent = String(def);
        row.classList.remove('changed');
      });
    });

    document.querySelector('[data-dials-copy]')?.addEventListener('click', async () => {
      const vals3 = saved();
      const lines = Object.entries(vals3).map(([k, v]) => `  ${k}: ${v}px;`);
      const css = lines.length ? `:root {\n${lines.join('\n')}\n}` : '/* no changes */';
      await navigator.clipboard.writeText(css);
      const btn = document.querySelector('[data-dials-copy]')!;
      const old = btn.textContent;
      btn.textContent = 'copied ✓';
      setTimeout(() => (btn.textContent = old), 1200);
    });

    document.querySelector('[data-dials-min]')?.addEventListener('click', () =>
      document.getElementById('dials')?.classList.toggle('min'),
    );
  }

  apply(saved());
  build();
  document.addEventListener('astro:after-swap', () => apply(saved()));
</script>
