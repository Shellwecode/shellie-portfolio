---
// The deck, docked. On reading pages the whisper pill becomes this full-width
// progress bar: mono meta, sienna needle tracking scroll, prev/next at right.
interface Props {
  title: string;
  prevHref?: string | null;
  prevLabel?: string | null;
  nextHref?: string | null;
  nextLabel?: string | null;
}
const { title, prevHref, prevLabel, nextHref, nextLabel } = Astro.props;
---

<div class="reading-bar" data-reading-bar>
  <span class="bar-title">{title.toLowerCase()}</span>
  <span class="bar-section" data-reading-section>reading</span>
  <div class="bar-track" aria-hidden="true">
    <span class="bar-needle" data-reading-needle></span>
  </div>
  {prevHref ? (
    <a href={prevHref} class="bar-nav" title={prevLabel ?? undefined}>← prev</a>
  ) : (
    <span class="bar-nav bar-nav-disabled">← prev</span>
  )}
  {nextHref ? (
    <a href={nextHref} class="bar-nav bar-nav-next" title={nextLabel ?? undefined}>next →</a>
  ) : (
    <span class="bar-nav bar-nav-disabled">next →</span>
  )}
</div>

<style>
  .reading-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    height: 52px;
    padding: 0 1.25rem;
    border-top: 1px solid var(--color-rule);
    background: var(--color-bg);
    z-index: 50;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .bar-title { font-weight: 700; color: var(--color-ink); white-space: nowrap; }
  .bar-section { color: var(--color-ink-muted); white-space: nowrap; }
  .bar-track {
    flex: 1;
    height: 2px;
    background: var(--color-rule);
  }
  .bar-needle {
    display: block;
    width: 0%;
    height: 2px;
    background: var(--color-accent);
    transition: width 200ms ease-out;
  }
  .bar-nav {
    color: var(--color-ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  a.bar-nav:hover, .bar-nav-next { color: var(--color-accent); }
  .bar-nav-disabled { color: var(--color-ink-faint); }
  @media (max-width: 768px) {
    .bar-section { display: none; }
  }
</style>

<script>
  // Needle = scroll progress through the article; section label = nearest heading above.
  function wireReadingBar() {
    const bar = document.querySelector('[data-reading-bar]');
    if (!bar) return;
    const needle = bar.querySelector('[data-reading-needle]') as HTMLElement | null;
    const sectionEl = bar.querySelector('[data-reading-section]') as HTMLElement | null;
    const headings = Array.from(document.querySelectorAll('article h2')) as HTMLElement[];

    function update() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
      if (needle) needle.style.width = `${pct}%`;
      if (sectionEl && headings.length) {
        let current: HTMLElement | null = null;
        for (const h of headings) {
          if (h.getBoundingClientRect().top < window.innerHeight * 0.35) current = h;
        }
        const i = current ? headings.indexOf(current) + 1 : 0;
        sectionEl.textContent = current
          ? `section ${i} of ${headings.length} · ${current.textContent?.toLowerCase()}`
          : `${headings.length} sections`;
      }
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
  wireReadingBar();
  document.addEventListener('astro:page-load', wireReadingBar);
</script>
