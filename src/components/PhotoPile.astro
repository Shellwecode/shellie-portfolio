---
// A small pile of draggable polaroids (after fancycomponents.dev's
// drag-elements, rebuilt vanilla — no framer, no React). Drop photos (or
// short .mp4s) into src/assets/about/photos/ and they appear; the filename
// becomes the caption ("walking-in-auckland.jpg" → "walking in auckland").
// Videos loop mutely in their polaroid; a click plays the full thing.
// Drag has momentum with soft container bounds; the last-touched photo
// stays on top, like a real pile.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const globbed = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/about/photos/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const globbedVideos = import.meta.glob<string>('../assets/about/photos/*.{mp4,webm}', {
  eager: true,
  query: '?url',
  import: 'default',
});
// posters/ carries a first-frame still per video (same basename) — a video
// element paints nothing until its data arrives; the poster holds the frame
const globbedPosters = import.meta.glob<string>('../assets/about/photos/posters/*.{jpg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const basename = (path: string) => (path.split('/').pop() ?? '').replace(/\.[a-z0-9]+$/i, '');
const posterFor = (videoPath: string) =>
  Object.entries(globbedPosters).find(([p]) => basename(p) === basename(videoPath))?.[1] ?? null;
const caption = (path: string) =>
  (path.split('/').pop() ?? '').replace(/\.[a-z0-9]+$/i, '').replace(/[-_]+/g, ' ');
const photos = [
  ...(await Promise.all(
    Object.entries(globbed).map(async ([path, mod]) => ({
      img: mod.default as ImageMetadata | null,
      video: null as string | null,
      poster: null as string | null,
      caption: caption(path),
      // a bigger cut for the click-to-expand view
      full: (await getImage({ src: mod.default, width: 1400 })).src,
    }))
  )),
  ...Object.entries(globbedVideos).map(([path, url]) => ({
    img: null,
    video: url,
    poster: posterFor(path),
    caption: caption(path),
    full: null as string | null,
  })),
];

// seeded scatter, distributed by lane — each piece owns a slice of the
// board's width (jittered), rows alternate, so the pile fills the table
// instead of clumping. Stable across builds (no Math.random).
const seed = (i: number, k: number) => {
  const x = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
  return x - Math.floor(x);
};
const n = Math.max(1, photos.length);
const placed = photos.map((p, i) => {
  const lane = (i + 0.5) / n; // 0..1 across the board
  const left = Math.min(74, Math.max(1, lane * 74 + (seed(i, 1) - 0.5) * 16));
  const row = i % 2 === 0 ? 6 : 32; // alternating shelves + jitter
  const top = row + seed(i, 2) * 16;
  return { ...p, left, top, rot: (seed(i, 3) - 0.5) * 14 };
});
---

{
  placed.length > 0 && (
    <section class="pile-wrap" aria-label="Photos">
      <p class="pile-whisper">
        <span class="whisper-wide">drag to see corners of my life</span>
        <span class="whisper-narrow">swipe through corners of my life</span>
      </p>
      <div class="pile" data-drag-zone>
        {placed.map((p) => (
          <figure
            class="polaroid"
            data-draggable
            data-full={p.full ?? undefined}
            data-video={p.video ?? undefined}
            data-caption={p.caption}
            style={`--pl: ${p.left}%; top: ${p.top}%; --rot: ${p.rot.toFixed(1)}deg`}
          >
            {/* eager — the pile is the page's moment; blank polaroids flashing in undercut it */}
            {p.img && (
              <Image src={p.img} alt={p.caption} widths={[320, 640]} sizes="230px" loading="eager" draggable={false} />
            )}
            {p.video && (
              /* the moving polaroid — loops mutely in the pile; click for sound.
                 The poster paints the first frame instantly, before video data lands. */
              <video src={p.video} poster={p.poster ?? undefined} muted loop autoplay playsinline preload="metadata" aria-label={p.caption}></video>
            )}
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
      {/* click (a drag that never travelled) expands the photo — or plays the video */}
      <div class="pile-lightbox" data-pile-lightbox role="dialog" aria-modal="true" aria-label="Photo" hidden>
        <figure>
          <img alt="" />
          <video controls playsinline hidden></video>
          <figcaption></figcaption>
        </figure>
      </div>
    </section>
  )
}

<style>
  .pile-whisper {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    margin-bottom: 0.5rem;
  }
  .whisper-narrow { display: none; }
  .pile {
    position: relative;
    height: 480px; /* the wider stage earns a taller table */
    border-radius: 20px;
    overflow: hidden;
    /* the pinboard is barely there — a breath of tint, no box */
    background: color-mix(in oklab, var(--color-rule) 30%, transparent);
  }
  .polaroid {
    position: absolute;
    /* the seeded seat, clamped so no card's right edge leaves the table —
       the scatter was tuned wide; narrow boards squeeze it back in */
    left: min(var(--pl, 0%), calc(100% - 238px));
    width: 230px;
    padding: 8px 8px 6px;
    background: #fffdf9;
    border-radius: 4px;
    box-shadow: var(--shadow-card);
    rotate: var(--rot, 0deg);
    cursor: grab;
    touch-action: none;
    user-select: none;
    will-change: translate;
  }
  :root[data-theme='dark'] .polaroid { background: #26221d; }
  .polaroid.dragging {
    cursor: grabbing;
    box-shadow: var(--shadow-card-hover);
    rotate: calc(var(--rot, 0deg) * 0.4); /* eases toward level in the hand */
    transition: rotate 200ms ease;
  }
  .polaroid :global(img),
  .polaroid video {
    display: block;
    width: 100%;
    height: 172px;
    object-fit: cover;
    border-radius: 2px;
    pointer-events: none;
  }
  .polaroid figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-align: center;
    padding-top: 5px;
    line-height: 1.3;
  }
  /* Narrow screens: the pile becomes a strip — dragging fought the page's
     scroll under a thumb, and a 300px board left no room to wander anyway.
     A swipe is the gesture the thumb already knows; native scroll brings
     the momentum for free. Full-bleed, so the photos run past the page
     edge and say so. */
  @media (max-width: 768px) {
    .whisper-wide { display: none; }
    .whisper-narrow { display: inline; }
    .pile {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      height: auto;
      margin-inline: -1.5rem; /* the shell's mobile pad — the band runs edge to edge */
      padding: 20px 1.5rem 24px;
      border-radius: 0;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.5rem;
      scrollbar-width: none;
    }
    .pile::-webkit-scrollbar { display: none; }
    .polaroid {
      position: static;
      flex: 0 0 auto;
      width: 190px;
      rotate: calc(var(--rot, 0deg) * 0.6); /* looser than level, calmer than the pile */
      cursor: default;
      touch-action: auto; /* the thumb scrolls the strip; cards stay seated */
      scroll-snap-align: center;
    }
    .polaroid:nth-child(even) { margin-top: 18px; } /* a strewn line, not a ruled one */
    .polaroid :global(img),
    .polaroid video { height: 142px; }
  }

  /* the expanded view — paper veil, the photo held up to the light */
  .pile-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: zoom-out;
    opacity: 1;
    transition: opacity 180ms ease;
  }
  .pile-lightbox[hidden] {
    display: none;
  }
  .pile-lightbox figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 88vw;
  }
  .pile-lightbox img,
  .pile-lightbox video {
    max-width: 88vw;
    max-height: 78vh;
    border-radius: 6px;
    box-shadow: var(--shadow-card-hover);
    outline: 1px solid oklch(0 0 0 / 0.08);
    outline-offset: -1px;
  }
  .pile-lightbox video { cursor: default; } /* clicks here are for the controls, not closing */
  .pile-lightbox figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>

<script>
  // Drag with momentum — velocity carries after release, decays with
  // friction, and the zone's bounds catch the slide with a soft bounce.
  // Generic: any [data-drag-zone] container with [data-draggable] children
  // (the pile here, the hero doodles on the about page).
  // Below the strip breakpoint the cards don't drag at all — the strip
  // scrolls natively and a tap expands.
  const strip = window.matchMedia('(max-width: 768px)');
  strip.addEventListener('change', () => {
    if (!strip.matches) return;
    // offsets dragged on the wide board are stale seats in the strip
    document.querySelectorAll<HTMLElement>('[data-draggable]').forEach((c) => {
      c.style.translate = '';
      c.style.zIndex = '';
    });
  });
  function wireDragZones() {
    document.querySelectorAll<HTMLElement>('[data-drag-zone]').forEach(wireZone);
  }
  function wireZone(pile: HTMLElement) {
    if (pile.dataset.wired) return;
    pile.dataset.wired = '1';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let zTop = 10;

    pile.querySelectorAll<HTMLElement>('[data-draggable]').forEach((card) => {
      let x = 0, y = 0; // translate offset from the seeded seat
      let vx = 0, vy = 0;
      let dragging = false;
      let lastX = 0, lastY = 0, lastT = 0;
      let raf = 0;

      const bounds = () => {
        const p = pile.getBoundingClientRect();
        const c = card.getBoundingClientRect();
        // how far translate may go in each direction, from current position
        return {
          minX: x + (p.left - c.left) - 8,
          maxX: x + (p.right - c.right) + 8,
          minY: y + (p.top - c.top) - 8,
          maxY: y + (p.bottom - c.bottom) + 8,
        };
      };

      const apply = () => {
        card.style.translate = `${x}px ${y}px`;
      };

      const settle = () => {
        const b = bounds();
        const friction = 0.94;
        const bounce = -0.4; // soft — the edge absorbs most of the slide
        const step = () => {
          vx *= friction;
          vy *= friction;
          x += vx;
          y += vy;
          if (x < b.minX) { x = b.minX; vx *= bounce; }
          if (x > b.maxX) { x = b.maxX; vx *= bounce; }
          if (y < b.minY) { y = b.minY; vy *= bounce; }
          if (y > b.maxY) { y = b.maxY; vy *= bounce; }
          apply();
          if (Math.hypot(vx, vy) > 0.3) raf = requestAnimationFrame(step);
        };
        raf = requestAnimationFrame(step);
      };

      let travelled = 0; // a "drag" that never travels is a click → expand
      card.addEventListener('click', () => {
        // strip mode's expand — a scroll-flick suppresses the click, so
        // only a true tap lands here
        if (!strip.matches) return;
        if (card.dataset.full || card.dataset.video) openLightbox(card);
      });
      card.addEventListener('pointerdown', (e) => {
        if (strip.matches) return;
        dragging = true;
        travelled = 0;
        cancelAnimationFrame(raf);
        card.setPointerCapture(e.pointerId);
        card.classList.add('dragging');
        card.style.zIndex = String(++zTop); // last touched rides the top of the pile
        lastX = e.clientX;
        lastY = e.clientY;
        lastT = performance.now();
        vx = vy = 0;
      });
      card.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const now = performance.now();
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        travelled += Math.hypot(dx, dy);
        const dt = Math.max(1, now - lastT);
        // clamp the hand inside the pile as it moves
        const b = bounds();
        x = Math.min(b.maxX, Math.max(b.minX, x + dx));
        y = Math.min(b.maxY, Math.max(b.minY, y + dy));
        vx = (dx / dt) * 12; // velocity in px/frame-ish
        vy = (dy / dt) * 12;
        lastX = e.clientX;
        lastY = e.clientY;
        lastT = now;
        apply();
      });
      const release = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        card.classList.remove('dragging');
        if (e.type === 'pointerup' && travelled < 6 && (card.dataset.full || card.dataset.video)) {
          openLightbox(card); // a click, not a drag
          return;
        }
        if (!reduced) settle(); // momentum — reduced motion rests where dropped
      };
      card.addEventListener('pointerup', release);
      card.addEventListener('pointercancel', release);
    });
  }

  // ── the expanded view ─────────────────────────────────────────────
  function openLightbox(card: HTMLElement) {
    const box = document.querySelector<HTMLElement>('[data-pile-lightbox]');
    if (!box) return;
    const img = box.querySelector('img')!;
    const vid = box.querySelector('video')!;
    const cap = box.querySelector('figcaption')!;
    const isVideo = Boolean(card.dataset.video);
    img.hidden = isVideo;
    vid.hidden = !isVideo;
    if (isVideo) {
      img.removeAttribute('src');
      vid.src = card.dataset.video ?? '';
      vid.play().catch(() => {}); // held up? the controls are right there
    } else {
      img.src = card.dataset.full ?? '';
      img.alt = card.dataset.caption ?? '';
    }
    cap.textContent = card.dataset.caption ?? '';
    box.hidden = false;
  }
  function wireLightbox() {
    const box = document.querySelector<HTMLElement>('[data-pile-lightbox]');
    if (!box || box.dataset.wired) return;
    box.dataset.wired = '1';
    // out from under the pile stage — its entrance animation holds a
    // translate/filter (fill: both), which quietly becomes the containing
    // block for fixed descendants: the veil centers on the pile, not the
    // screen, and ducks under the dock. At body level, fixed means the
    // viewport again and z-index 200 outranks the dock's 50.
    document.body.appendChild(box);
    const vid = box.querySelector('video')!;
    const close = () => {
      box.hidden = true;
      vid.pause();
      vid.removeAttribute('src'); // the pile's mute loop keeps playing; this one lets go
    };
    box.addEventListener('click', () => close());
    vid.addEventListener('click', (e) => e.stopPropagation()); // the controls are not the exit
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.hidden) close();
    });
  }
  // reduced motion: the moving polaroid holds its frame (click still plays)
  function stillPolaroids() {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLVideoElement>('.polaroid video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }
  wireLightbox();
  document.addEventListener('astro:page-load', wireLightbox);
  wireDragZones();
  document.addEventListener('astro:page-load', wireDragZones);
  stillPolaroids();
  document.addEventListener('astro:page-load', stillPolaroids);
</script>
