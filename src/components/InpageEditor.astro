---
// Dev-only: a quiet pill that makes the page's prose editable in place and
// saves text changes back to the source MDX via the inpage-edit middleware.
// Render it conditionally at the call site: {import.meta.env.DEV && <InpageEditor …/>}
interface Props {
  sourceFile?: string;
}
const { sourceFile } = Astro.props;
---

{
  sourceFile && (
    <div class="ie-root" data-inpage-editor data-file={sourceFile}>
      <span class="ie-hint" data-ie-hint hidden>esc cancels · headings rename their track</span>
      <button type="button" class="ie-btn" data-ie-btn>edit copy</button>
      <div class="ie-toast" data-ie-toast hidden />
    </div>
  )
}

<style>
  .ie-root {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ie-btn {
    height: 30px;
    padding: 0 14px;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-ink-muted);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }
  .ie-btn:hover {
    color: var(--color-accent);
    border-color: color-mix(in oklab, var(--color-accent) 40%, var(--color-rule));
  }
  :global(html[data-inpage-editing]) .ie-btn {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .ie-hint,
  .ie-toast {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }
  .ie-toast {
    position: fixed;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    padding: 6px 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
  /* while editing, show which blocks are grabbable */
  :global(html[data-inpage-editing] .prose :is(p, li, h2, h3, h4, figcaption):hover) {
    outline: 1px dashed var(--color-ink-faint);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>

<script>
  function wireInpageEditor() {
    if (!import.meta.env.DEV) return;
    const root = document.querySelector<HTMLElement>('[data-inpage-editor]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';

    const btn = root.querySelector<HTMLButtonElement>('[data-ie-btn]')!;
    const hint = root.querySelector<HTMLElement>('[data-ie-hint]')!;
    const toastEl = root.querySelector<HTMLElement>('[data-ie-toast]')!;
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!prose) return;

    // editable text blocks — skip file-reader dialogs (their text belongs to
    // another file) and the page footer nav
    const SEL = 'p, li, h2, h3, h4, figcaption';
    const blocks = () =>
      [...prose.querySelectorAll<HTMLElement>(SEL)].filter(
        (el) => !el.closest('dialog') && !el.closest('footer') && !el.closest('[data-ie-fm]')
      );
    // header title/summary render from frontmatter, not the body — they carry
    // data-ie-fm="<key>" (and may sit outside .prose, e.g. the album header)
    const fmEls = () => [...document.querySelectorAll<HTMLElement>('[data-ie-fm]')];

    let editing = false;
    let snapshot = new Map<HTMLElement, string>();
    let toastTimer: ReturnType<typeof setTimeout> | undefined;

    const toast = (msg: string) => {
      toastEl.textContent = msg;
      toastEl.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (toastEl.hidden = true), 3200);
    };

    const enter = () => {
      editing = true;
      snapshot = new Map(
        [...blocks(), ...fmEls()].map((el) => [el, el.textContent ?? ''])
      );
      prose.setAttribute('contenteditable', 'plaintext-only');
      if (!prose.isContentEditable) prose.setAttribute('contenteditable', 'true');
      fmEls().forEach((el) => {
        el.setAttribute('contenteditable', 'plaintext-only');
        if (!el.isContentEditable) el.setAttribute('contenteditable', 'true');
      });
      document.documentElement.setAttribute('data-inpage-editing', '');
      btn.textContent = 'save copy';
      hint.hidden = false;
    };

    const exit = () => {
      editing = false;
      prose.removeAttribute('contenteditable');
      fmEls().forEach((el) => el.removeAttribute('contenteditable'));
      document.documentElement.removeAttribute('data-inpage-editing');
      btn.textContent = 'edit copy';
      hint.hidden = true;
    };

    const cancel = () => {
      snapshot.forEach((orig, el) => {
        if ((el.textContent ?? '') !== orig) el.textContent = orig;
      });
      exit();
      toast('changes discarded');
    };

    const changed = () => {
      const dirty = new Set<HTMLElement>();
      snapshot.forEach((orig, el) => {
        if ((el.textContent ?? '') !== orig) dirty.add(el);
      });
      // leaf-most only: a loose list renders li > p, and both would report
      // the same change — keep the inner one
      return [...dirty].filter(
        (el) => ![...dirty].some((other) => other !== el && el.contains(other))
      );
    };

    const save = async () => {
      const dirty = changed();
      const edits = dirty
        .filter((el) => !el.dataset.ieFm)
        .map((el) => ({
          original: snapshot.get(el) ?? '',
          edited: el.textContent ?? '',
        }));
      // e.g. the album header shows only the short title — data-ie-suffix
      // carries the hidden " — …" remainder so the full title survives
      const fmEdits = dirty
        .filter((el) => el.dataset.ieFm)
        .map((el) => ({
          key: el.dataset.ieFm,
          value: (el.textContent ?? '').replace(/\s+/g, ' ').trim() + (el.dataset.ieSuffix ?? ''),
        }));
      if (edits.length === 0 && fmEdits.length === 0) {
        exit();
        toast('no changes');
        return;
      }
      btn.disabled = true;
      try {
        const res = await fetch('/__inpage-edit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ file: root.dataset.file, edits, fmEdits }),
        });
        // a stale dev server (started before the integration) has no
        // endpoint and answers with the 404 page — say so, plainly
        const text = await res.text();
        let out;
        try {
          out = JSON.parse(text);
        } catch {
          throw new Error('endpoint missing — restart the dev server to load the editor');
        }
        if (out.error) throw new Error(out.error);
        const file = (root.dataset.file ?? '').split('/').pop();
        toast(
          `${out.applied} edit${out.applied === 1 ? '' : 's'} saved to ${file}` +
            (out.skipped ? ` · ${out.skipped} skipped (formatted text — edit in source)` : '')
        );
        exit();
      } catch (e) {
        toast(`save failed: ${e instanceof Error ? e.message : e}`);
      } finally {
        btn.disabled = false;
      }
    };

    btn.addEventListener('click', () => (editing ? save() : enter()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && editing) cancel();
    });
  }
  wireInpageEditor();
  document.addEventListener('astro:page-load', wireInpageEditor);
</script>
