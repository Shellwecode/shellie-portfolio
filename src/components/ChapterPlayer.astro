---
// The chapter player — the landing's now-player pill, in reading mode. Same
// anatomy and paper material (art · title · sub-line · hairline track ·
// place-voice meta), with one difference: the hairline is a REAL progress
// bar. Without a recording it's segmented — sections sized by length,
// filling as you read, hover names them, click jumps. With a recording the
// segments give way to one continuous audio bar (the recording is a free
// preview, not chapter-synced): it fills with playback, hover names the
// timestamp, press-and-drag scrubs. Clicking the art plays/pauses (or
// returns to the cover when there's no recording).
import { Image } from 'astro:assets';

interface Track {
  slug: string;
  title: string;
  seconds: number;
  label: string;
}
interface Props {
  title: string;
  cover?: ImageMetadata | null;
  coverZoom?: number;
  voice?: string | null;
  tracks: Track[];
  totalLabel: string;
}
const { title, cover, coverZoom, voice, tracks, totalLabel } = Astro.props;
---

<div
  class="chapter-player"
  data-chapter-player
  data-cp-sections={JSON.stringify(tracks.map((t) => ({ slug: t.slug, seconds: t.seconds })))}
>
  {cover && (
    <span class="cp-wash" aria-hidden="true">
      <Image src={cover} alt="" width={520} height={152} />
    </span>
  )}
  <button
    type="button"
    class="cp-art"
    data-cp-art
    data-voice-src={voice ?? undefined}
    aria-label={voice ? 'Play the voice note' : 'Back to the album cover'}
    aria-pressed={voice ? 'false' : undefined}
  >
    <span class="cp-thumb" aria-hidden="true" style={coverZoom ? `--cover-zoom: ${coverZoom}` : undefined}>
      {cover && <Image src={cover} alt="" width={104} height={104} />}
      {voice && (
        <span class="cp-art-scrim">
          <svg class="cp-glyph-play" width="14" height="14" viewBox="0 0 10 10" fill="currentColor"><path d="M1.5 0.8 9 5 1.5 9.2Z" /></svg>
          <svg class="cp-glyph-pause" width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M2.5 1.5h2.4v9H2.5zM7.1 1.5h2.4v9H7.1z" /></svg>
        </span>
      )}
    </span>
  </button>

  <div class="cp-song">
    <span class="cp-title">{title}</span>
    <span class="cp-section" data-cp-section>{tracks.length} sections</span>
    <div class="cp-track">
      {voice ? (
        <button type="button" class="cp-seg cp-seg--audio" data-cp-audiobar aria-label="Seek within the voice note">
          <span class="cp-seg-fill"></span>
        </button>
      ) : (
        tracks.map((t) => (
          <button
            type="button"
            class="cp-seg"
            data-cp-seg
            data-slug={t.slug}
            data-seconds={t.seconds}
            style={`flex-grow: ${t.seconds}`}
            aria-label={`Jump to ${t.title}`}
          >
            <span class="cp-seg-fill"></span>
          </button>
        ))
      )}
    </div>
  </div>

  {/* transport — voice-mode furniture: fifteen seconds either way, the
      podcast gesture. Projects without a recording keep the quieter
      reading pill. */}
  {voice && (
  <span class="cp-controls">
    {/* Spotify's grammar: an open ring whose gap seats the number at the
        lower corner, a stroked arrow riding the arc's end — left-turning
        to rewind, right-turning to skip — drawn at the pill's hairline */}
    <button type="button" class="cp-btn" data-cp-skip="-15" data-peek="back 15s" aria-label="Back 15 seconds">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8.55 12.39A5.2 5.2 0 1 0 4.82 3.86" />
        <path d="M3.68 2.26 3.28 5.7 6.6 4.7" />
        <text x="4" y="15.3" text-anchor="middle" font-size="6.5" font-weight="700" fill="currentColor" stroke="none">15</text>
      </svg>
    </button>
    <button type="button" class="cp-btn" data-cp-skip="15" data-peek="forward 15s" aria-label="Forward 15 seconds">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7.45 12.39A5.2 5.2 0 1 1 11.18 3.86" />
        <path d="M12.32 2.26 12.72 5.7 9.4 4.7" />
        <text x="12" y="15.3" text-anchor="middle" font-size="6.5" font-weight="700" fill="currentColor" stroke="none">15</text>
      </svg>
    </button>
  </span>
  )}

  <span class="cp-time">
    {voice && (
      <span class="cp-time-mode" aria-hidden="true">
        {/* which clock is this? book = reading progress, speaker = the recording */}
        <svg class="cp-mode-book" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M6 2.3C5 1.5 3.5 1.2 1.6 1.5v8.1c1.9-.3 3.4 0 4.4.8 1-.8 2.5-1.1 4.4-.8V1.5C8.5 1.2 7 1.5 6 2.3Z" /><path d="M6 2.3v8.1" stroke-linecap="round" /></svg>
        <svg class="cp-mode-speaker" width="11" height="10" viewBox="0 0 13 11" fill="currentColor"><path d="M1 3.6h2.2L6.4 1v9L3.2 7.4H1z" /><path d="M8.4 3.2c1.5 1.2 1.5 3.4 0 4.6M10 1.6c2.6 2 2.6 5.8 0 7.8" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" /></svg>
      </span>
    )}
    <span data-cp-time>0:00 / {totalLabel}</span>
  </span>

  {/* the paper's tooth — same whisper grain as the landing pill */}
  <span class="cp-grain" aria-hidden="true"></span>

  {/* the floating section title — perches above the pill over whichever
      segment the cursor (or focus) is resting on */}
  <span class="cp-peek" data-cp-peek aria-hidden="true"></span>
</div>

<style>
  .chapter-player {
    --cp-ink: #4c6fa5; /* the landing pill's album ink — one material family */
    position: fixed;
    left: 50%;
    bottom: var(--pill-bottom);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    height: 76px;
    padding: 12px 22px 12px 12px;
    border-radius: 24px;
    z-index: 50;
    width: min(520px, calc(100vw - 32px));
    font-family: var(--font-sans);
    color: var(--color-ink);
    /* paper material, locked aug 2 on the landing: flat album-ink-tinted
       paper, soft elevation — identical recipe here */
    background: color-mix(in oklab, var(--cp-ink) 9%, var(--color-bg));
    box-shadow:
      0px 1px 2px rgb(0 0 0 / 0.05),
      0px 12px 36px -8px color-mix(in oklab, var(--color-ink) 16%, transparent);
    /* gravity: the spring (script) drives the scale property from here,
       growing upward off the bottom edge */
    transform-origin: 50% 100%;
  }
  /* The player waits until the album has folded and reading has begun.
     The page's switch script grants data-visible; without one it shows. */
  :global(html[data-album-fold]) .chapter-player:not([data-visible]) {
    opacity: 0;
    translate: 0 8px;
    pointer-events: none;
  }
  .chapter-player {
    transition: opacity var(--motion-content) ease, translate var(--motion-content) ease;
  }
  /* with a cover wash the paper goes neutral — the art supplies the tint,
     so the stock album-blue doesn't fight it */
  .chapter-player:has(.cp-wash) {
    background: color-mix(in oklab, var(--cp-ink) 3%, var(--color-bg));
  }
  /* ducked — sustained scrolling says "I'm reading": the pill sinks almost
     off-stage, leaving a 10px sliver riding the viewport edge as the recall
     handle. Full opacity — absence with a handle, not a ghost over prose.
     (No opacity here: the hidden-state rule's opacity must still win.) */
  .chapter-player[data-ducked]:not(:hover):not(:focus-within) {
    translate: 0 calc(100% + var(--pill-bottom) - 10px);
  }

  /* Ambient wash — the album art itself, blurred wide and masked so its
     color pours out of the thumb and dissolves before the time. Keeps the
     pill's tint consistent with whatever cover it carries. */
  .cp-wash {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }
  .cp-wash :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.7); /* pull sampled edges past the clip so the blur has no pale halo */
    filter: blur(24px) saturate(1.2);
    opacity: 0.32;
    -webkit-mask-image: linear-gradient(100deg, #000 25%, transparent 92%);
    mask-image: linear-gradient(100deg, #000 25%, transparent 92%);
  }
  :root[data-theme='dark'] .cp-wash :global(img) { opacity: 0.2; }
  .cp-art,
  .cp-song,
  .cp-controls,
  .cp-time {
    position: relative; /* seat content above the wash layer */
  }

  .cp-controls {
    display: flex;
    align-items: center;
    gap: 8px; /* wide enough that the extended hit areas touch, not overlap */
    flex-shrink: 0;
  }
  .cp-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
    border-radius: 10px;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--motion-micro) ease, background-color var(--motion-micro) ease,
      scale var(--motion-micro) ease;
  }
  .cp-btn text { font-family: inherit; }
  .cp-btn::after {
    content: '';
    position: absolute;
    inset: -4px; /* 40px hit area around the 32px face */
  }
  .cp-btn:hover {
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  .cp-btn:active { scale: 0.96; }

  .cp-art {
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: scale var(--motion-micro) ease;
  }
  .cp-art:hover { scale: 1.04; }
  .cp-art:active { scale: 0.96; }
  .cp-thumb {
    display: block;
    width: 52px;
    height: 52px;
    background: var(--color-rule);
    border-radius: 13px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  .cp-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--cover-zoom, 1));
  }
  /* voice affordance — a quiet scrim on the art; play at rest, pause while
     the recording runs (both glyphs stay mounted, cross-faded) */
  .cp-thumb { position: relative; }
  .cp-art-scrim {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    background: rgb(16 15 15 / 0.26);
    color: #fffcf0;
  }
  .cp-art-scrim svg {
    grid-area: 1 / 1;
    transition: opacity var(--motion-micro) ease, scale var(--motion-micro) ease;
  }
  .cp-glyph-play { translate: 1px 0; /* optical center for the triangle */ }
  .cp-glyph-pause { opacity: 0; scale: 0.25; }
  .chapter-player[data-voice-playing] .cp-glyph-play { opacity: 0; scale: 0.25; }
  .chapter-player[data-voice-playing] .cp-glyph-pause { opacity: 1; scale: 1; }

  .cp-song {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }
  .cp-title {
    font-weight: 600; /* the pill's song-title voice */
    font-size: var(--text-lg);
    line-height: 22px;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cp-section {
    font-weight: 400;
    font-size: var(--text-xs);
    line-height: 15px;
    color: var(--color-ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The hairline, made real: segments sized by section length, gaps as
     chapter marks, accent fill tracking the read. */
  .cp-track {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    height: 8px; /* hit area around the 2px hairline */
  }
  .cp-seg {
    position: relative;
    height: 2px;
    min-width: 6px;
    padding: 0;
    border: 0;
    border-radius: 1px;
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
    cursor: pointer;
    overflow: hidden;
    transition: height var(--motion-micro) ease;
  }
  .cp-track:hover .cp-seg { height: 4px; }
  /* one continuous bar when a recording exists — no chapter marks */
  .cp-seg--audio { flex: 1; touch-action: none; /* the bar owns its drags on touch */ }
  .cp-seg--audio .cp-seg-fill { transition: width 260ms linear; /* rides ~4Hz timeupdates smoothly */ }
  /* while scrubbing the fill glues to the pointer — no easing lag — and
     the bar keeps its raised posture even if the cursor drifts off it */
  .chapter-player[data-scrubbing] .cp-seg--audio { height: 4px; }
  .chapter-player[data-scrubbing] .cp-seg--audio .cp-seg-fill { transition: none; }
  .cp-seg-fill {
    display: block;
    width: 0%;
    height: 100%;
    background: var(--color-accent);
    transition: width 200ms ease-out;
  }

  .cp-time {
    /* the place-voice — same seat as "Boston, 16:33" on the landing */
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    font-weight: 400;
    font-size: var(--text-xs);
    line-height: 16px;
    color: var(--color-ink-muted);
    white-space: nowrap;
    /* Aileron ships no tabular figures — reserve width so the pill holds still */
    min-width: 74px;
    text-align: right;
  }
  .cp-time-mode {
    display: grid;
    place-items: center;
    color: var(--color-ink-faint);
  }
  .cp-time-mode svg {
    grid-area: 1 / 1;
    transition: opacity var(--motion-micro) ease;
  }
  .cp-mode-speaker { opacity: 0; }
  .chapter-player[data-voice-playing] .cp-mode-book { opacity: 0; }
  .chapter-player[data-voice-playing] .cp-mode-speaker { opacity: 1; }

  .cp-grain {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='5' height='5'><circle cx='1' cy='1' r='0.55' fill='%234C6FA5'/></svg>");
    opacity: 0.1;
  }

  /* The peek — a small paper callout that floats above the pill, naming
     the segment under the cursor. Same material family as the pill, a
     touch more solid so type stays legible over prose. */
  .cp-peek {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0; /* JS sets --peek-x to the hovered segment's center */
    translate: calc(var(--peek-x, 50%) - 50%) 4px;
    padding: 5px 10px;
    border-radius: 10px;
    white-space: nowrap;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-ink) 5%, transparent);
    box-shadow: 0 6px 20px color-mix(in oklab, var(--color-ink) 7%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-micro) ease, translate var(--motion-micro) ease;
  }
  @supports (backdrop-filter: blur(1px)) {
    .cp-peek { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  }
  .chapter-player[data-peek-open] .cp-peek {
    opacity: 1;
    translate: calc(var(--peek-x, 50%) - 50%) 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .cp-peek { transition: opacity var(--motion-micro) ease; translate: calc(var(--peek-x, 50%) - 50%) 0; }
  }

  @media (max-width: 768px) {
    .chapter-player { height: 72px; gap: 12px; padding: 10px 16px 10px 10px; border-radius: 22px; }
    .cp-thumb { width: 52px; height: 52px; border-radius: 12px; }
    .cp-time { display: none; }
  }
</style>

<script>
  // Segments fill as you read; the needle logic mirrors ReadingBar's 35% marker.
  function wireChapterPlayer() {
    const player = document.querySelector('[data-chapter-player]') as HTMLElement | null;
    if (!player || player.dataset.wired) return;
    player.dataset.wired = '1';

    const segs = Array.from(player.querySelectorAll('[data-cp-seg]')) as HTMLElement[];
    const sectionEl = player.querySelector('[data-cp-section]') as HTMLElement | null;
    const timeEl = player.querySelector('[data-cp-time]') as HTMLElement | null;
    const artBtn = player.querySelector('[data-cp-art]') as HTMLElement | null;
    const peek = player.querySelector('[data-cp-peek]') as HTMLElement | null;
    const audioBar = player.querySelector('[data-cp-audiobar]') as HTMLElement | null;
    const audioFill = audioBar?.querySelector('.cp-seg-fill') as HTMLElement | null;

    // Section geometry rides the player's own data — the segments carry it
    // only in reading mode, and the audio bar has none.
    const sections = JSON.parse(player.dataset.cpSections ?? '[]') as {
      slug: string;
      seconds: number;
    }[];
    const seconds = sections.map((s) => s.seconds || 60);
    const total = seconds.reduce((a, b) => a + b, 0);
    const heads = sections
      .map((s) => document.getElementById(s.slug))
      .filter(Boolean) as HTMLElement[];
    if (!heads.length) return;

    const fmt = (s: number) =>
      `${Math.floor(s / 60)}:${String(Math.round(s) % 60).padStart(2, '0')}`;

    let current = -1;
    let frac = 0;
    let voicePlaying = false; // while true, the audio owns the time readout

    function update() {
      const marker = window.scrollY + window.innerHeight * 0.35;
      const tops = heads.map((h) => h.getBoundingClientRect().top + window.scrollY);
      const docEnd = document.documentElement.scrollHeight;

      current = -1;
      for (let i = 0; i < tops.length; i++) if (tops[i] <= marker) current = i;
      frac = 0;
      if (current >= 0) {
        const start = tops[current];
        const end = tops[current + 1] ?? docEnd - window.innerHeight * 0.65;
        frac = end > start ? Math.min(1, Math.max(0, (marker - start) / (end - start))) : 1;
      }

      segs.forEach((seg, i) => {
        const fill = seg.querySelector('.cp-seg-fill') as HTMLElement | null;
        if (fill) fill.style.width = i < current ? '100%' : i === current ? `${frac * 100}%` : '0%';
      });
      if (sectionEl) {
        sectionEl.textContent =
          current >= 0
            ? `${current + 1} · ${heads[current].textContent?.toLowerCase().trim()}`
            : `${heads.length} sections`;
      }
      if (timeEl && !voicePlaying) {
        const elapsed =
          current < 0
            ? 0
            : seconds.slice(0, current).reduce((a, b) => a + b, 0) + frac * seconds[current];
        timeEl.textContent = `${fmt(elapsed)} / ${fmt(total)}`;
      }
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let near = false; // cursor is closing in on the pill (set by the gravity spring)
    let noDuckUntil = 0; // self-initiated smooth scrolls shouldn't duck the pill
    const jump = (i: number) => {
      noDuckUntil = Date.now() + 1200;
      const el = heads[Math.max(0, Math.min(heads.length - 1, i))];
      if (!el) return;
      /* Seat the heading at the viewport's vertical center — a top-anchored
         jump left sections floating wherever the offset happened to land.
         Floored below the switch's exit point so an early section can't
         scroll the reader back out of the article. */
      const r = el.getBoundingClientRect();
      const y = Math.max(
        48,
        r.top + window.scrollY - Math.max(0, (window.innerHeight - r.height) / 2)
      );
      const lenis = (window as any).lenis;
      if (lenis && !reduced) lenis.scrollTo(y);
      else window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
    };

    segs.forEach((seg, i) => seg.addEventListener('click', () => jump(i)));

    // The peek: name whatever the cursor (or keyboard focus) is resting on —
    // a segment or a transport button — seated over its center, clamped
    // inside the pill.
    // The gravity spring (and the duck) scale the whole pill, so screen-space
    // rects and the peek's local translate disagree — and keep disagreeing
    // while the spring moves. Place the peek every frame it's open: divide
    // the instant's scale back out and clamp in the pill's own (unscaled)
    // coordinates, re-reading the target so it rides the swell.
    let peekTrack: (() => number) | null = null; // target screen-x, re-read per frame
    let peekRaf = 0;
    const placePeek = () => {
      if (!peek || !peekTrack || !player.hasAttribute('data-peek-open')) {
        peekRaf = 0;
        return;
      }
      const pr = player.getBoundingClientRect();
      const s = pr.width / player.offsetWidth || 1;
      const half = peek.offsetWidth / 2;
      const x = Math.min(
        player.offsetWidth - half - 6,
        Math.max(half + 6, (peekTrack() - pr.left) / s)
      );
      player.style.setProperty('--peek-x', `${x}px`);
      peekRaf = requestAnimationFrame(placePeek);
    };
    const openPeek = (track: () => number) => {
      peekTrack = track;
      player.setAttribute('data-peek-open', '');
      if (!peekRaf) peekRaf = requestAnimationFrame(placePeek);
    };
    const showPeek = (text: string, anchor: HTMLElement) => {
      if (!peek || !text) return;
      peek.textContent = text;
      openPeek(() => {
        const ar = anchor.getBoundingClientRect();
        return ar.left + ar.width / 2;
      });
    };
    const hidePeek = () => player.removeAttribute('data-peek-open');
    segs.forEach((seg) => {
      const name = () => heads[segs.indexOf(seg)]?.textContent?.trim().toLowerCase() ?? '';
      seg.addEventListener('pointerenter', () => showPeek(name(), seg));
      seg.addEventListener('focus', () => showPeek(name(), seg));
      seg.addEventListener('blur', hidePeek);
    });
    player.querySelector('.cp-track')?.addEventListener('pointerleave', hidePeek);
    player.querySelectorAll('[data-peek]').forEach((el) => {
      const btn = el as HTMLElement;
      btn.addEventListener('pointerenter', () => showPeek(btn.dataset.peek ?? '', btn));
      btn.addEventListener('pointerleave', hidePeek);
      btn.addEventListener('focus', () => showPeek(btn.dataset.peek ?? '', btn));
      btn.addEventListener('blur', hidePeek);
    });

    // The art: with a voice note it's the play/pause for the recording;
    // without one it returns you to the cover (fly-back in reverse).
    const voiceSrc = artBtn?.dataset.voiceSrc;
    let audio: HTMLAudioElement | null = null;
    const setVoiceState = (playing: boolean) => {
      voicePlaying = playing;
      player.toggleAttribute('data-voice-playing', playing);
      artBtn?.setAttribute('aria-pressed', String(playing));
      document
        .querySelector('[data-voice-toggle]')
        ?.setAttribute('aria-pressed', String(playing));
      if (!playing) update(); // hand the time readout back to reading progress
    };
    const ensureAudio = () => {
      if (audio || !voiceSrc) return audio;
      audio = new Audio(voiceSrc);
      audio.preload = 'metadata';
      audio.addEventListener('timeupdate', () => {
        if (!Number.isFinite(audio!.duration)) return;
        // the bar is the recording's — it holds its place through pauses
        if (audioFill) audioFill.style.width = `${(audio!.currentTime / audio!.duration) * 100}%`;
        if (timeEl && voicePlaying) {
          timeEl.textContent = `${fmt(audio!.currentTime)} / ${fmt(audio!.duration)}`;
        }
      });
      audio.addEventListener('ended', () => {
        setVoiceState(false);
        if (audioFill) audioFill.style.width = '0%'; // rewind the bar for next time
      });
      audio.addEventListener('pause', () => setVoiceState(false));
      audio.addEventListener('play', () => setVoiceState(true));
      return audio;
    };
    const toggleVoice = () => {
      if (!ensureAudio()) return;
      if (audio!.paused) audio!.play();
      else audio!.pause();
    };

    // The transport: fifteen seconds either way, clamped to the recording's
    // ends. Skipping moves the needle without changing play/pause.
    player.querySelectorAll('[data-cp-skip]').forEach((el) => {
      const btn = el as HTMLElement;
      const delta = Number(btn.dataset.cpSkip);
      btn.addEventListener('click', () => {
        const a = ensureAudio();
        if (!a) return;
        const apply = () =>
          (a.currentTime = Math.min(a.duration, Math.max(0, a.currentTime + delta)));
        if (Number.isFinite(a.duration)) apply();
        else a.addEventListener('loadedmetadata', apply, { once: true });
      });
    });

    // The audio bar is a scrubber: press seeks to the press point, dragging
    // follows the pointer (captured, so a drag past either edge clamps to
    // 0:00 or the end), release resumes if the recording was at rest.
    // Hovering names the timestamp the way segments name their sections.
    if (audioBar && voiceSrc) {
      const barFrac = (e: PointerEvent | MouseEvent) => {
        const r = audioBar.getBoundingClientRect();
        return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      };
      const seekTo = (f: number) => {
        const a = ensureAudio();
        if (!a) return;
        const apply = () => (a.currentTime = f * a.duration);
        if (Number.isFinite(a.duration)) apply();
        else a.addEventListener('loadedmetadata', apply, { once: true });
      };
      let scrubbing = false;
      audioBar.addEventListener('pointerdown', (e) => {
        scrubbing = true;
        player.setAttribute('data-scrubbing', '');
        seekTo(barFrac(e));
        try {
          audioBar.setPointerCapture(e.pointerId);
        } catch {
          /* no live pointer to capture — pointermove still scrubs while over the bar */
        }
      });
      const endScrub = () => {
        if (!scrubbing) return;
        scrubbing = false;
        player.removeAttribute('data-scrubbing');
        if (audio?.paused) audio.play(); // a tap or a settled drag plays from here
      };
      audioBar.addEventListener('pointerup', endScrub);
      audioBar.addEventListener('pointercancel', endScrub);
      audioBar.addEventListener('pointerenter', () => ensureAudio()); // warm the metadata for the peek
      audioBar.addEventListener('pointermove', (e) => {
        if (scrubbing) seekTo(barFrac(e));
        if (!peek || !audio || !Number.isFinite(audio.duration)) return;
        peek.textContent = fmt(barFrac(e) * audio.duration);
        peekAt(e.clientX);
      });
      audioBar.addEventListener('pointerleave', hidePeek);
    }
    artBtn?.addEventListener('click', () => {
      if (voiceSrc) {
        toggleVoice();
        return;
      }
      noDuckUntil = Date.now() + 1200;
      const lenis = (window as any).lenis;
      if (lenis && !reduced) lenis.scrollTo(0);
      else window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
    // The album header's "listen" button drives the same recording.
    document.querySelector('[data-voice-toggle]')?.addEventListener('click', toggleVoice);

    // Gravity — the pill swells as the cursor closes in and again under a
    // press, driven by a real underdamped spring (k below critical damping),
    // so every release settles with a small, honest wobble.
    if (!reduced) {
      let cur = 1;
      let vel = 0;
      let prox = 0;
      let pressed = false;
      let raf = 0;
      let rect = player.getBoundingClientRect();
      const K = 170; // stiffness
      const C = 14; // damping — critical is ~26, so it wobbles
      const DT = 1 / 60;
      const tick = () => {
        const target = 1 + 0.03 * prox + (pressed ? 0.035 : 0);
        vel += (K * (target - cur) - C * vel) * DT;
        cur += vel * DT;
        if (Math.abs(target - cur) < 0.0004 && Math.abs(vel) < 0.004) {
          cur = target;
          vel = 0;
          raf = 0;
        } else raf = requestAnimationFrame(tick);
        player.style.scale = cur === 1 ? '' : String(cur);
      };
      const wake = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };
      window.addEventListener(
        'pointermove',
        (e) => {
          const dx = Math.max(rect.left - e.clientX, 0, e.clientX - rect.right);
          const dy = Math.max(rect.top - e.clientY, 0, e.clientY - rect.bottom);
          const t = Math.max(0, 1 - Math.hypot(dx, dy) / 160);
          prox = t * t; /* eased ramp — it only swells once you're really closing in */
          near = prox > 0.1;
          if (near) player.removeAttribute('data-ducked');
          wake();
        },
        { passive: true }
      );
      document.documentElement.addEventListener('mouseleave', () => {
        prox = 0;
        wake();
      });
      player.addEventListener('pointerdown', () => {
        pressed = true;
        wake();
      });
      window.addEventListener('pointerup', () => {
        pressed = false;
        wake();
      });
      window.addEventListener('pointercancel', () => {
        pressed = false;
        wake();
      });
      window.addEventListener('resize', () => {
        rect = player.getBoundingClientRect();
      });
    }

    // Duck on sustained scroll — reading owns the viewport; the pill sinks
    // out of the essay's last lines and resurfaces when the scroll rests.
    // The entrance owns the first beat: when the switch grants visibility
    // (playlist → overview), the pill arrives at full height and holds the
    // stage — ducking waits until the reader scrolls on past the landing.
    let duckTimer = 0;
    let wasVisible = player.hasAttribute('data-visible');
    new MutationObserver(() => {
      const visible = player.hasAttribute('data-visible');
      if (visible && !wasVisible) {
        // the switch re-asserts the attribute on every scroll tick — only
        // the hidden → visible TRANSITION restarts the grace window
        clearTimeout(duckTimer);
        player.removeAttribute('data-ducked');
        noDuckUntil = Date.now() + 1600;
      }
      wasVisible = visible;
    }).observe(player, { attributes: true, attributeFilter: ['data-visible'] });
    window.addEventListener(
      'scroll',
      () => {
        if (near || Date.now() < noDuckUntil) return;
        player.setAttribute('data-ducked', '');
        clearTimeout(duckTimer);
        duckTimer = window.setTimeout(() => player.removeAttribute('data-ducked'), 900);
      },
      { passive: true }
    );
    player.addEventListener('focusin', () => player.removeAttribute('data-ducked'));

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
  wireChapterPlayer();
  document.addEventListener('astro:page-load', wireChapterPlayer);
</script>
