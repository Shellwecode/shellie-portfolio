---
// The chapter player — the landing's now-player pill, in reading mode. Same
// anatomy and paper material (art · title · sub-line · hairline track ·
// place-voice meta), with one difference: the hairline is a REAL segmented
// progress bar — six segments sized by section length, filling as you read.
// Clicking the art opens the queue; segments jump to sections.
import { Image } from 'astro:assets';

interface Track {
  slug: string;
  title: string;
  seconds: number;
  label: string;
}
interface Props {
  title: string;
  cover?: ImageMetadata | null;
  tracks: Track[];
  totalLabel: string;
  nextHref?: string | null;
  nextLabel?: string | null;
}
const { title, cover, tracks, totalLabel, nextHref, nextLabel } = Astro.props;
---

<div class="chapter-player" data-chapter-player>
  <button
    type="button"
    class="cp-queue-toggle"
    data-cp-queue-toggle
    aria-expanded="false"
    aria-controls="cp-queue"
    aria-label="Sections"
  >
    <span class="cp-thumb" aria-hidden="true">
      {cover && <Image src={cover} alt="" width={104} height={104} />}
    </span>
  </button>

  <div class="cp-song">
    <span class="cp-title">{title}</span>
    <span class="cp-section" data-cp-section>{tracks.length} sections</span>
    <div class="cp-track">
      {tracks.map((t) => (
        <button
          type="button"
          class="cp-seg"
          data-cp-seg
          data-slug={t.slug}
          data-seconds={t.seconds}
          style={`flex-grow: ${t.seconds}`}
          title={`${t.title} · ${t.label}`}
          aria-label={`Jump to ${t.title}`}
        >
          <span class="cp-seg-fill"></span>
        </button>
      ))}
    </div>
  </div>

  <span class="cp-time" data-cp-time>0:00 / {totalLabel}</span>

  {/* the paper's tooth — same whisper grain as the landing pill */}
  <span class="cp-grain" aria-hidden="true"></span>

  <nav class="cp-queue" id="cp-queue" data-cp-queue aria-label="Sections">
    <span class="cp-queue-head">queue · {title.toLowerCase()} — {tracks.length} sections, {totalLabel}</span>
    {tracks.map((t, i) => (
      <button type="button" class="cp-row" data-cp-row data-slug={t.slug}>
        <span class="cp-row-n">{i + 1}</span>
        <span class="cp-row-title">{t.title.toLowerCase()}</span>
        <span class="cp-row-time">{t.label}</span>
      </button>
    ))}
    {nextHref && (
      <a href={nextHref} class="cp-up-next">
        up next · {nextLabel?.toLowerCase()} →
      </a>
    )}
  </nav>
</div>

<style>
  .chapter-player {
    --cp-ink: #4c6fa5; /* the landing pill's album ink — one material family */
    position: fixed;
    left: 50%;
    bottom: var(--pill-bottom);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    height: 76px;
    padding: 12px 22px 12px 12px;
    border-radius: 24px;
    z-index: 50;
    width: min(520px, calc(100vw - 32px));
    font-family: var(--font-sans);
    color: var(--color-ink);
    /* paper material, locked aug 2 on the landing: flat album-ink-tinted
       paper, soft elevation — identical recipe here */
    background: color-mix(in oklab, var(--cp-ink) 9%, var(--color-bg));
    box-shadow:
      0px 1px 2px rgb(0 0 0 / 0.05),
      0px 12px 36px -8px color-mix(in oklab, var(--color-ink) 16%, transparent);
  }
  /* The player waits until the album has folded and reading has begun.
     The page's switch script grants data-visible; without one it shows. */
  :global(html[data-album-fold]) .chapter-player:not([data-visible]) {
    opacity: 0;
    translate: 0 8px;
    pointer-events: none;
  }
  .chapter-player {
    transition: opacity var(--motion-content) ease, translate var(--motion-content) ease;
  }

  .cp-queue-toggle {
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: scale var(--motion-micro) ease;
  }
  .cp-queue-toggle:hover { scale: 1.04; }
  .cp-queue-toggle:active { scale: 0.96; }
  .cp-thumb {
    display: block;
    width: 52px;
    height: 52px;
    background: var(--color-rule);
    border-radius: 13px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  .cp-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cp-song {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }
  .cp-title {
    font-weight: 600; /* the pill's song-title voice */
    font-size: var(--text-lg);
    line-height: 22px;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cp-section {
    font-weight: 400;
    font-size: var(--text-xs);
    line-height: 15px;
    color: var(--color-ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The hairline, made real: segments sized by section length, gaps as
     chapter marks, accent fill tracking the read. */
  .cp-track {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    height: 8px; /* hit area around the 2px hairline */
  }
  .cp-seg {
    position: relative;
    height: 2px;
    min-width: 6px;
    padding: 0;
    border: 0;
    border-radius: 1px;
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
    cursor: pointer;
    overflow: hidden;
    transition: height var(--motion-micro) ease;
  }
  .cp-track:hover .cp-seg { height: 4px; }
  .cp-seg-fill {
    display: block;
    width: 0%;
    height: 100%;
    background: var(--color-accent);
    transition: width 200ms ease-out;
  }

  .cp-time {
    /* the place-voice — same seat as "Boston, 16:33" on the landing */
    flex-shrink: 0;
    font-weight: 400;
    font-size: var(--text-xs);
    line-height: 16px;
    color: var(--color-ink-muted);
    white-space: nowrap;
    /* Aileron ships no tabular figures — reserve width so the pill holds still */
    min-width: 74px;
    text-align: right;
  }

  .cp-grain {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='5' height='5'><circle cx='1' cy='1' r='0.55' fill='%234C6FA5'/></svg>");
    opacity: 0.1;
  }

  /* Queue — the tracklist as a popover above the pill. A touch more solid
     than the pill so type stays legible over prose. */
  .cp-queue {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    translate: -50% 6px;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.75rem;
    border-radius: 16px;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 86%, transparent),
      color-mix(in srgb, var(--color-bg) 96%, transparent)
    );
    border: 1px solid color-mix(in oklab, var(--color-ink) 5%, transparent);
    box-shadow: 0 10px 32px color-mix(in oklab, var(--color-ink) 7%, transparent);
    transition: opacity var(--motion-content) ease, translate var(--motion-content) ease;
  }
  @supports (backdrop-filter: blur(1px)) {
    .cp-queue { backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .cp-queue { background: var(--color-bg); }
  }
  .chapter-player[data-queue-open] .cp-queue {
    opacity: 1;
    pointer-events: auto;
    translate: -50% 0;
  }
  .cp-queue-head {
    font-weight: 300;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-faint);
    padding: 0.25rem 0.625rem 0.5rem;
  }
  .cp-row {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.45rem 0.625rem;
    border: 0;
    border-radius: 8px;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--motion-micro) ease, color var(--motion-micro) ease;
  }
  .cp-row:hover {
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
    color: var(--color-ink);
  }
  .cp-row-n {
    width: 1rem;
    flex-shrink: 0;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }
  .cp-row-title { flex: 1; }
  .cp-row-time {
    font-family: var(--font-serif);
    font-style: italic;
    font-stretch: 87.5%;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
  .cp-row[aria-current] .cp-row-n { font-weight: 600; color: var(--color-accent); }
  .cp-row[aria-current] .cp-row-title { color: var(--color-ink); }
  .cp-row[aria-current] .cp-row-time { color: var(--color-accent); }
  .cp-up-next {
    margin-top: 0.375rem;
    padding: 0.5rem 0.625rem 0.25rem;
    border-top: 1px solid var(--color-rule);
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .cp-up-next:hover { color: var(--color-accent); }

  @media (max-width: 768px) {
    .chapter-player { height: 72px; gap: 12px; padding: 10px 16px 10px 10px; border-radius: 22px; }
    .cp-thumb { width: 52px; height: 52px; border-radius: 12px; }
    .cp-time { display: none; }
  }
</style>

<script>
  // Segments fill as you read; the needle logic mirrors ReadingBar's 35% marker.
  function wireChapterPlayer() {
    const player = document.querySelector('[data-chapter-player]') as HTMLElement | null;
    if (!player || player.dataset.wired) return;
    player.dataset.wired = '1';

    const segs = Array.from(player.querySelectorAll('[data-cp-seg]')) as HTMLElement[];
    const rows = Array.from(player.querySelectorAll('[data-cp-row]')) as HTMLElement[];
    const sectionEl = player.querySelector('[data-cp-section]') as HTMLElement | null;
    const timeEl = player.querySelector('[data-cp-time]') as HTMLElement | null;
    const queueToggle = player.querySelector('[data-cp-queue-toggle]') as HTMLElement | null;

    const seconds = segs.map((s) => Number(s.dataset.seconds ?? 60));
    const total = seconds.reduce((a, b) => a + b, 0);
    const heads = segs
      .map((s) => document.getElementById(s.dataset.slug ?? ''))
      .filter(Boolean) as HTMLElement[];
    if (!heads.length) return;

    const fmt = (s: number) =>
      `${Math.floor(s / 60)}:${String(Math.round(s) % 60).padStart(2, '0')}`;

    let current = -1;
    let frac = 0;

    function update() {
      const marker = window.scrollY + window.innerHeight * 0.35;
      const tops = heads.map((h) => h.getBoundingClientRect().top + window.scrollY);
      const docEnd = document.documentElement.scrollHeight;

      current = -1;
      for (let i = 0; i < tops.length; i++) if (tops[i] <= marker) current = i;
      frac = 0;
      if (current >= 0) {
        const start = tops[current];
        const end = tops[current + 1] ?? docEnd - window.innerHeight * 0.65;
        frac = end > start ? Math.min(1, Math.max(0, (marker - start) / (end - start))) : 1;
      }

      segs.forEach((seg, i) => {
        const fill = seg.querySelector('.cp-seg-fill') as HTMLElement | null;
        if (fill) fill.style.width = i < current ? '100%' : i === current ? `${frac * 100}%` : '0%';
      });
      rows.forEach((row, i) => {
        if (i === current) row.setAttribute('aria-current', 'true');
        else row.removeAttribute('aria-current');
      });
      if (sectionEl) {
        sectionEl.textContent =
          current >= 0
            ? `${current + 1} · ${heads[current].textContent?.toLowerCase().trim()}`
            : `${heads.length} sections`;
      }
      if (timeEl) {
        const elapsed =
          current < 0
            ? 0
            : seconds.slice(0, current).reduce((a, b) => a + b, 0) + frac * seconds[current];
        timeEl.textContent = `${fmt(elapsed)} / ${fmt(total)}`;
      }
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const jump = (i: number) => {
      const el = heads[Math.max(0, Math.min(heads.length - 1, i))];
      if (!el) return;
      const lenis = (window as any).lenis;
      if (lenis && !reduced) lenis.scrollTo(el, { offset: -40 });
      else el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
    };

    segs.forEach((seg, i) => seg.addEventListener('click', () => jump(i)));
    rows.forEach((row, i) =>
      row.addEventListener('click', () => {
        jump(i);
        player.removeAttribute('data-queue-open');
        queueToggle?.setAttribute('aria-expanded', 'false');
      })
    );

    queueToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = player.hasAttribute('data-queue-open');
      player.toggleAttribute('data-queue-open', !open);
      queueToggle.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('click', (e) => {
      if (!player.contains(e.target as Node)) {
        player.removeAttribute('data-queue-open');
        queueToggle?.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        player.removeAttribute('data-queue-open');
        queueToggle?.setAttribute('aria-expanded', 'false');
      }
    });

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
  wireChapterPlayer();
  document.addEventListener('astro:page-load', wireChapterPlayer);
</script>
