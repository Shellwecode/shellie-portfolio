---
/* The front door, idea 4 — the color load. Her mark is the loading bar:
   the gray girl stands alone while color pours in from the hem, and the
   fill itself is one of the pack's animated texture loops (b/w mp4,
   blended into the riso tint, masked to her silhouette). A wobbly
   shoreline rides the fill line; an honest mono loading log writes
   itself in the corner. When she's full the boil settles into flat ink,
   gold sparks flick off her, and the landing rises.

   PRODUCTION BAKE (2026-08-18): the DialKit rig is retired — the tuned
   timeline lives in this file's script as real Motion animations, and
   the feel dials are baked into the CSS custom-property fallbacks
   below. The full authoring rig (OpeningFillDirector.tsx) lives in git
   history before this commit if the door ever needs re-tuning.

   Storyboard (seconds):
     0.00  the gray girl drops in from above (y −19, opacity .12→1)
           on an overshoot ease — a little landing
     0.43  the pour — fill level springs 0→1 in 1.02s (bounce .2, the
           waterline laps back); shoreline + counter + log ride it
     1.58  the settle — the boil drains out of the ink (0.45s)
     1.96  sparks — six gold ticks flick outward and fade
     2.58  release — the veil fades (0.56s), data-entrance fires, the
           landing performs its rise (the landing's own greeting is
           the hello — the door doesn't repeat it). Click/key/wheel
           skips straight to the release.

   The girl is TopBar's `face` glyph verbatim (viewBox 0 0 150 150) —
   two inks: body rides currentColor, features ride --shade. She's
   drawn twice (gray under, tinted over) and the tinted copy + texture
   video live inside .fg-level, whose clip-path is the fill line.

   NOTE(prod): the *-small.mp4 loops in public/textures/opening/ are
   avconvert 640px re-encodes of the pack's 64-second masters (~15 MB
   each — working, not ideal). Still worth a ffmpeg pass: trim to a
   ~6s seamless loop + crop to the girl's box (~1 MB). */

/* TopBar's face glyph — body + the four shade features. Kept in sync by
   hand; the top bar stays the source of truth for the drawing. */
const BODY =
  'M118.4 50L116.9 45C116.5 44.1 112.5 47.2 109.6 48.8C108.1 49.5 106.4 50.1 105.5 50.6C104.4 51.4 100.8 53.1 99.8 53.5C96.5 54.6 93.4 55.8 90 57.1C87.6 58 85.5 58.4 84.9 59C83.9 59.4 83 60.1 82 60.4C79.8 60.6 77.5 61.8 75.7 62.2C72.8 62.9 70.5 63.6 68.1 65C66.9 65.8 66.9 69 66.2 71C64.4 76.2 63 82.4 60.8 90.6C60.1 93.1 58.9 96 58.7 98.6C58.1 104.4 56.2 111.5 55.6 116.9C54.6 124.9 54.6 125.5 52.2 128C51.5 128.6 50.4 128.5 49.5 128.5C46.9 128.5 43.1 128.5 43 128.4C41.5 128 39.5 127.8 36.9 127.9C31.4 127.9 29 128.2 25 128C23.9 128 22.4 127.2 17.4 127.5L12 127.9C10 127.9 8 126.5 7.6 124.1C6.8 120.2 7.5 116.1 7.8 112.1C7.8 107.4 9.8 91.9 12.1 84.6C15.5 72.6 18.9 64.2 21.6 57.8C23.4 53.5 25.4 49.8 27.6 45.4C28.6 43.4 30.9 40.5 34 36.6C34.9 35.5 36.5 34.4 37.2 33.4L37.6 31.5C38.9 29.5 45.1 26.8 46.5 26.2C49.1 25.2 49.5 25.4 51.8 24.5C57.1 23 61.2 22 67.4 21.6C74.6 21.1 79.4 21.4 85 21.9L94 23.1C96.9 23.6 103.9 24.5 106.5 25.4L113.4 27.6C117 29 128 32.6 129.6 34.1C130.9 35.4 131.6 35.4 132.4 36.1C134 37.4 134.5 39 137.2 43.4L138.6 46.9C139.1 49.9 140.5 55.5 140.8 57.5L141.5 62.5C141.6 64.6 142.1 67.8 142.1 69.9L142.8 76C142.9 78.2 142.6 90.8 142.6 92.6C141.2 114.5 139.8 119.2 137.6 121.6C135.6 123.6 136.5 124.4 133.5 125C132 125.4 131.3 125.2 129.2 125.2C126 125.2 122 125.2 118.8 125.5C117.2 125.7 116 125.7 114.4 125.7C113 125.7 113.3 126.5 109.8 126.5C106.3 126.5 105.7 126.1 105.8 124.6C105.9 122.5 105.4 121.6 106 120.8C108.6 117.2 114.4 114.4 117.8 108.6C121.6 102.5 123.9 94.6 124.1 86C124.4 77.2 122 61.4 118.4 50Z';
const SHADES = [
  'M105.5 70C105 69.2 103.4 68.6 101.9 69.9L100.5 74.5C100 76 99.6 78.4 99.6 79.5C99.1 84.5 98.6 87.5 99.4 88.9C100.9 91 102.1 92 104.4 91.5C106.9 91.4 107.9 90 107.9 87.5C107.9 85 107.7 83.9 107.5 81.4C107.4 79 105.6 76.1 105.6 75.6L105.6 74C105.1 71.1 104.9 70.5 105.5 70Z',
  'm105 100.5c-0.9-0.6-1.6-0.7-3.1-0.6h-2.6c-3.5-0.1-5.9 0.2-6.9 0.7-1.3 0.6-1.8 1.2-1.8 1.4-0.1 0.6 0.4 1.1 0.8 1.5 1.5 1.7 3.2 2.6 5.2 3.6 0.9 0.4 1.9 0.3 5.3 0.1 2.2 0 2.7-0.6 2.7-0.6 0.9-0.6 1.3-3 1.3-3 0.1-1.1 0.7-2.4-0.9-2.6v-0.5z',
  'm116.5 71c-0.1-0.1 0-1.5-2.9-1.1-2.6 0.5-2 1.2-2.1 3.6 0 1.6-0.5 3.1-0.3 4.1 0.3 1.4 1.6 2 2.8 1.6 1.5-0.4 2-0.7 2.5-3.1 0.3-1.2 0-3.1 0-5.1z',
  'm87.5 72.1c-0.4-1.2-1.4-1.1-2.9-1-1.7 0.3-2.1 0-2.2 2.5v3.8c0 0.5 0.5 1.2 1.1 1.2s1.6-0.1 3.4-0.2c1 0 0.7-1.2 0.6-2.8 0-2.1 0.1-2.6 0-3.5z',
];

const girlPaths = () =>
  `<path fill="currentColor" d="${BODY}"/>` +
  SHADES.map((d) => `<path fill="var(--shade)" d="${d}"/>`).join('');

/* Silhouette mask for the texture video — every path solid, one shape. */
const maskSvg =
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 150 150">` +
  `<path d="${BODY}"/>` +
  SHADES.map((d) => `<path d="${d}"/>`).join('') +
  `</svg>`;
const maskUri = `url("data:image/svg+xml;utf8,${encodeURIComponent(maskSvg)}")`;

/* Dev-only: the DialKit rig (re-raised 2026-08-19 to retune the pour).
   When it mounts it drives the door instead of the baked script below;
   prod never ships it. */
import OpeningFillDirector from './OpeningFillDirector';
---

<div id="fg-opening" aria-hidden="true" style={`--fg-mask: ${maskUri}`}>
  <div class="fg-wall"></div>
  {/* One anchored scene: the girl and her counter move as one. */}
  <div class="fg-scene">
  <div class="fg-stack">
    <svg class="fg-girl fg-gray" viewBox="0 0 150 150"><Fragment set:html={girlPaths()} /></svg>
    <div class="fg-level">
      <svg class="fg-girl fg-color" viewBox="0 0 150 150"><Fragment set:html={girlPaths()} /></svg>
      <div class="fg-texwrap">
        <video class="fg-tex" src="/textures/opening/doodles-small.mp4" muted loop playsinline autoplay preload="auto"></video>
      </div>
    </div>
    <svg class="fg-shore" viewBox="0 0 150 14" preserveAspectRatio="none">
      <path d="M2 7 C 14 3, 26 11, 40 7 C 54 3, 66 11, 80 7 C 94 3, 106 11, 120 7 C 132 4, 142 9, 148 7" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" fill="none" />
    </svg>
    <svg class="fg-sparks" viewBox="0 0 190 190">
      <g stroke="#D9A441" stroke-width="4" stroke-linecap="round">
        <path d="M26 40 L 35 30" /><path d="M16 88 L 6 86" /><path d="M158 34 L 168 24" />
        <path d="M172 96 L 183 96" /><path d="M42 156 L 32 166" /><path d="M150 148 L 160 158" />
      </g>
    </svg>
  </div>
  <div class="fg-counter">0%</div>
  </div>
  <pre class="fg-log"></pre>
</div>

{import.meta.env.DEV && <OpeningFillDirector client:only="react" />}

{/* Pre-paint guard — same contract as the other openings: repeat visitors
    and reduced-motion skip the door entirely; dev always plays. */}
<script is:inline data-astro-rerun define:vars={{ dev: import.meta.env.DEV }}>
  try {
    var fgSkip =
      !dev &&
      (sessionStorage.getItem('entered') ||
        matchMedia('(prefers-reduced-motion: reduce)').matches);
    var fgEl = document.getElementById('fg-opening');
    if (fgEl && fgSkip) fgEl.style.display = 'none';
    else if (fgEl) document.documentElement.style.overflow = 'hidden';
  } catch (e) {}
</script>
<noscript>
  <style>
    #fg-opening {
      display: none;
    }
  </style>
</noscript>

<script>
  import { animate } from 'motion';

  /* The tuned timeline, baked (her DialKit session, 2026-08-18). Times in
     seconds; TEX_O is the boil strength the settle drains from. */
  const T = {
    girlMs: 0.54,
    pourAt: 0.43,
    pourS: 1.02,
    settleAt: 1.58,
    sparksAt: 1.96,
    releaseAt: 2.58,
    veilS: 0.56,
  };
  const TEX_O = 0.45;

  /* The honest part of the theater — these are real files this page loads. */
  const LOG_LINES = [
    '> fetch junicode.woff2 … ok',
    '> fetch riso-icons.svg … ok',
    '> fetch textures/doodles.mp4 … ok',
    '> fetch voice/greeting-en.mp3 … ok',
  ];

  const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

  function openFillDoor() {
    const overlay = document.getElementById('fg-opening');
    if (!overlay || overlay.style.display === 'none') return; // guard sat us out
    const stack = overlay.querySelector<HTMLElement>('.fg-stack');
    const shore = overlay.querySelector<SVGSVGElement>('.fg-shore');
    const sparks = overlay.querySelector<SVGSVGElement>('.fg-sparks');
    const counter = overlay.querySelector<HTMLElement>('.fg-counter');
    const log = overlay.querySelector<HTMLElement>('.fg-log');
    const video = overlay.querySelector<HTMLVideoElement>('.fg-tex');
    if (!stack || !shore || !sparks || !counter || !log || !video) return;

    let level = 0;
    let settled = false;
    let released = false;
    const anims: { stop: () => void }[] = [];
    const timers: ReturnType<typeof setTimeout>[] = [];

    const paint = () => {
      const lv = clamp01(level);
      overlay.style.setProperty('--fg-level', String(lv));
      const edge = clamp01(Math.min(lv / 0.06, (1 - lv) / 0.06));
      shore.style.opacity = String(edge);
      const showCnt = lv > 0.01 && !settled;
      counter.style.opacity = showCnt ? '1' : '0';
      counter.textContent = `${Math.round(lv * 100)}%`;
      const shown = Math.floor(lv * LOG_LINES.length);
      const lines = LOG_LINES.slice(0, shown);
      if (lv > 0.01 && lv < 1) lines.push(`> pour ink … ${Math.round(lv * 100)}%`);
      if (settled) lines.push('> ready.');
      log.textContent = lv > 0.01 ? lines.join('\n') : 'waking up…';
      log.style.opacity = settled ? '0.45' : '1';
    };
    paint();

    /* the drop-in — she lands from a touch above on an overshoot ease */
    anims.push(
      animate(
        stack,
        { opacity: [0.12, 1], y: [-19, 0], scale: [0.98, 1] },
        { duration: T.girlMs, ease: [0.5, 1.38, 0.36, 1] },
      ),
    );

    /* the pour — a springing waterline, everything else rides its level */
    anims.push(
      animate(0, 1, {
        delay: T.pourAt,
        type: 'spring',
        duration: T.pourS,
        bounce: 0.2,
        onUpdate: (v) => {
          level = v;
          paint();
        },
      }),
    );

    const settleBeat = () => {
      settled = true;
      level = 1;
      paint();
      anims.push(
        animate(1, 0, {
          duration: 0.45,
          ease: [0.33, 1, 0.68, 1],
          onUpdate: (v) => overlay.style.setProperty('--fg-tex-o', String(TEX_O * v)),
        }),
      );
      timers.push(setTimeout(() => video.pause(), 600)); // boil's gone; save the cycles
    };

    const sparksBeat = () => {
      anims.push(
        animate(
          sparks,
          { opacity: [0, 1, 1, 0] },
          { duration: 0.67, times: [0, 0.27, 0.48, 1], ease: [0.4, 0, 0.6, 1] },
        ),
      );
      anims.push(
        animate(
          sparks,
          { scale: [0.6, 1, 1.1] },
          { duration: 0.67, times: [0, 0.45, 1], ease: [0.34, 1.56, 0.64, 1] },
        ),
      );
    };

    const finish = () => {
      document.documentElement.style.overflow = '';
      overlay.style.display = 'none';
    };

    const release = () => {
      if (released) return;
      released = true;
      try {
        sessionStorage.setItem('entered', '1');
      } catch {
        /* private mode — the door just replays next visit */
      }
      overlay.style.pointerEvents = 'none';
      document.documentElement.setAttribute('data-entrance', '');
      removeListeners();
      animate(overlay, { opacity: 0 }, { duration: T.veilS, ease: [0.4, 0, 0.2, 0.72] }).then(
        finish,
      );
    };

    /* A click is impatience, not magic: jump to the finished pose, release. */
    const skip = () => {
      if (released) return;
      for (const t of timers) clearTimeout(t);
      for (const a of anims) a.stop();
      settled = true;
      level = 1;
      paint();
      overlay.style.setProperty('--fg-tex-o', '0');
      stack.style.opacity = '1';
      stack.style.transform = 'none';
      sparks.style.opacity = '0';
      video.pause();
      release();
    };

    const removeListeners = () => {
      overlay.removeEventListener('pointerdown', skip);
      window.removeEventListener('keydown', skip);
      window.removeEventListener('wheel', skip);
    };
    overlay.addEventListener('pointerdown', skip);
    window.addEventListener('keydown', skip);
    window.addEventListener('wheel', skip, { passive: true });

    timers.push(setTimeout(settleBeat, T.settleAt * 1000));
    timers.push(setTimeout(sparksBeat, T.sparksAt * 1000));
    timers.push(setTimeout(release, T.releaseAt * 1000));
  }

  // Dev hands the door to the DialKit rig (OpeningFillDirector); this baked
  // driver is what ships.
  if (!import.meta.env.DEV) {
    openFillDoor();
    document.addEventListener('astro:after-swap', openFillDoor);
  }
</script>

<style>
  #fg-opening {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    cursor: pointer;
    /* The baked feel — these fallbacks ARE the tuned values */
    --fg-level: 0;
    --fg-size: 260px;
    --fg-scene-x: 5px;
    --fg-scene-y: 3px;
    --fg-gray: #a8a39c;
    --fg-gray-shade: #8a857e;
    --fg-tint: #d36b41;
    --fg-tint-shade: #b15c35;
    --fg-tex-o: 0.45;
    --fg-tex-s: 0.93;
    --fg-blend: screen;
    --fg-cnt-x: 41px;
    --fg-cnt-y: 5px;
    --fg-cnt-size: 16px;
  }
  .fg-wall {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
  }
  /* The scene is the composition anchor. */
  .fg-scene {
    position: relative;
    width: var(--fg-size);
    aspect-ratio: 1;
    translate: var(--fg-scene-x, 0px) var(--fg-scene-y, 0px);
  }
  .fg-stack {
    position: absolute;
    inset: 0;
    transform-origin: center;
  }
  .fg-girl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .fg-gray {
    color: var(--fg-gray);
    --shade: var(--fg-gray-shade);
  }
  .fg-color {
    color: var(--fg-tint);
    --shade: var(--fg-tint-shade);
  }
  /* The fill window — everything colored lives inside this clip. isolation
     keeps the video's blend against the tinted girl, not the wall. */
  .fg-level {
    position: absolute;
    inset: 0;
    isolation: isolate;
    clip-path: inset(calc((1 - var(--fg-level, 0)) * 100%) 0 0 0);
  }
  /* The blend lives HERE, on the masked element itself — a blended CHILD
     escapes an ancestor's mask in Chromium (blending composites at the
     isolation-context level), which leaked texture dashes below her hem. */
  .fg-texwrap {
    position: absolute;
    inset: 0;
    mask-image: var(--fg-mask);
    -webkit-mask-image: var(--fg-mask);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    overflow: hidden;
    mix-blend-mode: var(--fg-blend, multiply);
  }
  .fg-tex {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--fg-tex-s, 1));
    opacity: var(--fg-tex-o, 0.85);
  }
  /* The ink shoreline rides the fill line; the script fades it near 0/1. */
  .fg-shore {
    position: absolute;
    left: -4%;
    width: 108%;
    height: 14px;
    top: calc((1 - var(--fg-level, 0)) * 100%);
    translate: 0 -50%;
    color: var(--fg-tint-shade);
    opacity: 0;
  }
  .fg-sparks {
    position: absolute;
    inset: -14%;
    opacity: 0;
    transform-origin: center;
  }
  /* Anchored off her right edge, vertically centered. */
  .fg-counter {
    position: absolute;
    left: calc(100% + var(--fg-cnt-x, 22px));
    top: calc(50% + var(--fg-cnt-y, 0px));
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: var(--fg-cnt-size, 13px);
    color: var(--fg-tint-shade);
    opacity: 0;
  }
  .fg-log {
    position: absolute;
    left: 28px;
    bottom: 22px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--color-ink-faint);
    white-space: pre;
  }
  /* Phones: the girl was filling two-thirds of the screen — she's a mark,
     not a poster. Smaller scene, counter tucked closer so it can't run off
     the right edge, log eases toward the corner. */
  @media (max-width: 768px) {
    #fg-opening {
      --fg-size: 176px;
      --fg-cnt-x: 24px;
      --fg-cnt-size: 13px;
    }
    .fg-log {
      left: 20px;
      bottom: 18px;
      font-size: 9.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #fg-opening {
      display: none;
    }
  }
</style>
