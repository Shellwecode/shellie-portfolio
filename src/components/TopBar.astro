---
import ThemeToggle from './ThemeToggle.astro';
---

<div class="topbar">
  <div class="topbar-spacer"></div>
  <nav class="topbar-mobile-nav">
    <a href="/">home</a>
    <a href="/about">about</a>
    <a href="/projects">work</a>
    <a href="/writing">writing</a>
    <a href="/doodles">doodles</a>
  </nav>
  <button type="button" class="topbar-link" data-np-open aria-haspopup="dialog" aria-expanded="false">now</button>
  <ThemeToggle />
</div>

<style>
  .topbar {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    height: 52px;
  }
  .topbar-spacer { flex: 1; }
  .topbar-link {
    position: relative;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    transition: color var(--motion-micro) ease;
  }
  /* text link, 40px hit area (stays clear of the theme toggle's) */
  .topbar-link::after {
    content: '';
    position: absolute;
    inset: -11px -6px;
  }
  .topbar-link:hover { color: var(--color-accent); }
  /* "now" + the theme toggle ride the top bar on every primary-menu page.
     Reading pages keep the top clean — the toggle leaves with "now" (alone
     in the corner it reads stranded) and reseats in the crumb row. */
  :global(html[data-quiet-dock]) .topbar-link[data-np-open],
  :global(html[data-quiet-dock]) .topbar :global(.theme-toggle) { display: none; }
  .topbar-mobile-nav { display: none; }
  @media (max-width: 768px) {
    .topbar-mobile-nav {
      display: flex;
      gap: 0.875rem;
      font-size: 0.875rem;
    }
    .topbar-mobile-nav a {
      color: var(--color-ink-muted);
      text-decoration: none;
    }
  }
</style>
