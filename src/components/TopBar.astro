// Top bar — nav E, the girl + worn word (the picked direction): her mark
// top-left is home, the text menu keeps the right with "now" and the theme
// toggle, and the active page's word wears its little drawing. At rest she
// faces you; hover, she turns and says hi. Every distance and duration rides
// a --gn-* var whose fallback IS the shipped value (the TopNavDirector rig
// that dialed them is gone — rebuild it to re-tune).
//
// Icons: Shellie's vectors from the Paper board "riso new icons / vector".
// Two tones each: the main body rides currentColor, the darker riso accent
// (chimney shade, note flag, egg ring, tree trunk, face features) rides
// --shade — both recolor together. The charcoal webps rest on in public/icons.
import ThemeToggle from './ThemeToggle.astro';

// opt: per-glyph optical factor — the wide house reads big at a shared
// height while the narrow note reads small; these equalize perceived weight.
