---
import ThemeToggle from './ThemeToggle.astro';
---

<div class="topbar">
  <button class="search-pill" title="Search (⌘K) — coming soon">
    <span class="search-dot" aria-hidden="true"></span>
    <span>search</span>
  </button>
  <div class="topbar-spacer"></div>
  <nav class="topbar-mobile-nav">
    <a href="/about">about</a>
    <a href="/projects">work</a>
    <a href="/workshop">workshop</a>
    <a href="/writing">writing</a>
    <a href="/doodles">doodles</a>
  </nav>
  <button type="button" class="topbar-link" data-deck-toggle aria-expanded="false">now</button>
  <ThemeToggle />
</div>

<style>
  .topbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0 0 0;
  }
  .search-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 32px;
    padding: 0 0.875rem;
    background: none;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-ink-faint);
    font-size: 0.8125rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color var(--motion-micro) ease, color var(--motion-micro) ease;
  }
  .search-pill:hover { border-color: var(--color-ink-faint); color: var(--color-ink-muted); }
  .search-dot {
    width: 12px;
    height: 12px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
  }
  .topbar-spacer { flex: 1; }
  .topbar-link {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    transition: color var(--motion-micro) ease;
  }
  .topbar-link:hover { color: var(--color-accent); }
  .topbar-mobile-nav { display: none; }
  @media (max-width: 768px) {
    .topbar-mobile-nav {
      display: flex;
      gap: 0.875rem;
      font-size: 0.875rem;
    }
    .topbar-mobile-nav a {
      color: var(--color-ink-muted);
      text-decoration: none;
    }
    .search-pill span:last-child { display: none; }
  }
</style>
