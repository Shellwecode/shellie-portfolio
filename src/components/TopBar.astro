const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
const menuItems = items.filter((i) => i.href !== '/');

// Reading pages (header direction A): the menu words step aside and the
// way back rides beside her mark. Only nested routes wear a crumb.
const crumb = pathname.startsWith('/projects/')
  ? { href: '/projects', label: 'work' }
  : pathname.startsWith('/writing/')
    ? { href: '/writing', label: 'writing' }
    : null;
---

<div class="topbar">
  {/* her mark is home. At rest she faces you; hover, she turns and says hi —
      the side face sits stacked over the front and turns in. */}
  <a class="gn-mark" href="/" aria-label="home">
    <svg class="gn-face gn-front" viewBox={glyphs.face.vb} aria-hidden="true" set:html={glyphs.face.svg} />
    <span class="gn-side-wrap" aria-hidden="true">
      <svg class="gn-face gn-side" viewBox={glyphs.faceSide.vb} set:html={glyphs.faceSide.svg} />
    </span>
  </a>
  {crumb && (
    <a href={crumb.href} class="gn-crumb">
      <svg class="gn-crumb-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.5 6H1.5" /><path d="M5.5 2 1.5 6l4 4" />
      </svg>
      <span>{crumb.label}</span>
    </a>
  )}
  <div class="topbar-spacer"></div>
  <nav class="topbar-mobile-nav">
    <a href="/">home</a>
    <a href="/about">about</a>
    <a href="/projects">work</a>
    <a href="/writing">writing</a>
    <a href="/doodles">doodles</a>
  </nav>
  <nav class="gn-menu" aria-label="Site navigation">
    {menuItems.map((item) => (
      <a href={item.href} class:list={['gn-item', { active: isActive(item.href) }]}>
        <svg class="gn-ico" viewBox={glyphs[item.glyph].vb} style={`--opt: ${item.opt}`} aria-hidden="true" set:html={glyphs[item.glyph].svg} />
        <span>{item.label}</span>
      </a>
    ))}
    <span class="gn-divider" aria-hidden="true"></span>
  </nav>
  <button type="button" class="topbar-link" data-np-open aria-haspopup="dialog" aria-expanded="false">now</button>
  <ThemeToggle />
</div>

<style>
  .topbar {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    height: 52px;
    /* the riso rust pair — currentColor carries the body, --shade the darker
       accent, so the whole nav has exactly two inks */
    --gn-rust: #D36B41;
    --gn-rust-shade: #A1512D;
  }
  .topbar-spacer { flex: 1; }

  /* ── the mark ── */
  .gn-mark {
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: scale var(--motion-micro) ease;
  }
  .gn-mark:active { scale: 0.93; } /* a small bow, then home */
  .gn-face {
    height: var(--gn-logo, 48px);
    width: auto;
    color: var(--gn-rust);
    --shade: var(--gn-rust-shade);
  }
  /* the turned head rides absolutely over the front face, so the swap never
     shifts the bar; its size is a ratio dial because the two drawings weigh
     differently at equal heights */
  .gn-side-wrap {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    display: flex;
    align-items: center;
    opacity: 0;
    rotate: calc(var(--gn-turn, 10deg) * -1);
    transform-origin: 40% 75%; /* she turns from the neck, not the frame corner */
    transition:
      opacity var(--gn-swap-ms, 270ms) var(--gn-ease, cubic-bezier(0.34, 1.56, 0.64, 1)),
      rotate var(--gn-swap-ms, 270ms) var(--gn-ease, cubic-bezier(0.34, 1.56, 0.64, 1));
    pointer-events: none;
  }
  .gn-side { height: calc(var(--gn-logo, 48px) * var(--gn-side-scale, 0.93)); }
  .gn-front {
    transition: opacity var(--gn-swap-ms, 270ms) var(--gn-ease, cubic-bezier(0.34, 1.56, 0.64, 1));
  }
  .gn-mark:hover .gn-front,
  .gn-mark:focus-visible .gn-front { opacity: 0; }
  .gn-mark:hover .gn-side-wrap,
  .gn-mark:focus-visible .gn-side-wrap {
    opacity: 1;
    rotate: 0deg;
  }

  /* ── the worn word menu ── */
  .gn-menu {
    display: flex;
    align-items: center;
    gap: var(--gn-menu-gap, 24px);
  }
  .gn-item {
    display: flex;
    align-items: center;
    gap: var(--gn-ico-gap, 8px);
    font-family: var(--font-sans);
    font-size: var(--gn-menu-size, 14px);
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--motion-micro) ease;
  }
  .gn-item:hover,
  .gn-item:focus-visible { color: var(--gn-rust); }
  .gn-item.active {
    color: var(--gn-rust-shade);
    font-weight: 600;
  }
  /* the active word wears its drawing — one icon at a time, settling on from
     a little above, like it was just set down */
  .gn-ico {
    display: none;
    height: calc(var(--gn-ico, 24px) * var(--opt, 1));
    width: auto;
    color: var(--gn-rust);
    --shade: var(--gn-rust-shade);
  }
  .gn-item.active .gn-ico {
    display: block;
    animation: gn-wear-in var(--gn-worn-ms, 570ms) var(--gn-ease, cubic-bezier(0.34, 1.56, 0.64, 1)) both;
  }
  @keyframes gn-wear-in {
    from {
      opacity: 0;
      translate: 0 calc(var(--gn-worn-drop, 6px) * -1);
    }
  }

  .gn-divider {
    width: 1px;
    height: 14px;
    background: var(--color-rule);
  }

  .topbar-link {
    position: relative;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    transition: color var(--motion-micro) ease;
  }
  /* text link, 40px hit area (stays clear of the theme toggle's) */
  .topbar-link::after {
    content: '';
    position: absolute;
    inset: -11px -6px;
  }
  .topbar-link:hover { color: var(--color-accent); }
  /* ── the reading crumb (header direction A, picked 2026-08-19) ──
     On nested pages the way back rides beside her mark, dressed like the
     old crumb row's pill: quiet at rest, surfacing under the cursor. */
  .gn-crumb {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    margin-left: -6px; /* optical: tuck toward her mark, pill overhangs on hover */
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition:
      color var(--motion-micro) ease,
      background-color var(--motion-fade) ease,
      opacity 200ms ease,
      translate 240ms ease;
  }
  .gn-crumb:hover {
    color: var(--color-accent);
    background: color-mix(in oklab, var(--color-rule) 55%, transparent);
  }
  .gn-crumb-arrow { flex-shrink: 0; transition: translate var(--motion-micro) ease; }
  .gn-crumb:hover .gn-crumb-arrow { translate: -2px 0; }
  /* ~40px hit area without visual weight */
  .gn-crumb::after {
    content: '';
    position: absolute;
    inset: -6px 0;
  }
  /* once reading starts on voice projects, the player's ⏮ owns "back" */
  :global(html[data-reading][data-crumb-voice]) .gn-crumb {
    opacity: 0;
    translate: -6px 0;
    pointer-events: none;
  }

  /* Reading pages, direction A: "now" leaves; the toggle KEEPS its corner
     seat; her mark stays full ink with the crumb beside her; the menu words
     step aside entirely — and whisper back whenever the bar is hovered or
     focused (the flourish: reach for where nav always lives, it appears). */
  :global(html[data-quiet-dock]) .topbar-link[data-np-open] { display: none; }
  :global(html[data-quiet-dock]) .gn-menu {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-content) ease 400ms;
  }
  :global(html[data-quiet-dock]) .topbar:hover .gn-menu,
  :global(html[data-quiet-dock]) .topbar:focus-within .gn-menu {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0ms;
  }

  .topbar-mobile-nav { display: none; }
  @media (max-width: 768px) {
    .gn-mark,
    .gn-crumb,
    .gn-menu { display: none; } /* phase 1: text links carry mobile */
    .topbar-mobile-nav {
      display: flex;
      gap: 0.875rem;
      font-size: 0.875rem;
    }
    .topbar-mobile-nav a {
      color: var(--color-ink-muted);
      text-decoration: none;
    }
  }
</style>
