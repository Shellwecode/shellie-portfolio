---
import now from '../data/now.json';

// The deck at rest. Phase 2 morphs this into the now rail; for now it links to /now.
// Data is manual (src/data/now.json); the Spotify serverless swap keeps this shape.
---

<button type="button" class="whisper-pill glass" data-deck-toggle transition:persist="whisper-pill" aria-label="What Shellie is up to right now" aria-expanded="false">
  <span class="pill-thumb" aria-hidden="true"></span>
  <span class="pill-song">{now.listening.title} — {now.listening.artist}</span>
  <span class="pill-meta">building {now.building.label.split(' ·')[0].replace(/^./, (c) => c.toUpperCase())}</span>
  <span class="pill-track" aria-hidden="true"><span class="pill-needle"></span></span>
  <span class="pill-time" data-pill-time data-location={now.location}>· {now.location}</span>
</button>

<style>
  .whisper-pill {
    position: fixed;
    left: 50%;
    bottom: var(--pill-bottom);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 48px;
    padding: 0 1.125rem;
    border-radius: 999px;
    z-index: 50;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-ink);
    transition: box-shadow var(--motion-micro) ease, scale var(--motion-micro) ease;
  }
  .whisper-pill:active { scale: 0.96; }
  .whisper-pill:hover {
    color: var(--color-ink);
    box-shadow: 0 10px 36px color-mix(in oklab, var(--color-ink) 14%, transparent);
  }
  .pill-thumb {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    background: var(--color-rule);
    border-radius: 6px;
  }
  .pill-song {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 20px;
    white-space: nowrap;
  }
  .pill-meta {
    font-weight: 300;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
  .pill-time {
    font-weight: 300;
    /* Aileron ships no tabular figures — reserve the widest plausible width
       so the centered pill doesn't breathe on each minute tick */
    min-width: 78px;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
  .pill-track {
    width: 90px;
    height: 2px;
    flex-shrink: 0;
    background: color-mix(in oklab, var(--color-ink) 14%, transparent);
  }
  .pill-needle {
    display: block;
    width: 55%;
    height: 2px;
    background: var(--color-accent);
  }
  @media (max-width: 768px) {
    .pill-meta, .pill-track { display: none; }
  }
</style>

<script>
  // Benji-style signature: live local time in Boston.
  function tickPillTime() {
    const els = document.querySelectorAll('[data-pill-time]');
    if (!els.length) return;
    const time = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'America/New_York',
    }).format(new Date());
    els.forEach((el) => {
      const location = (el as HTMLElement).dataset.location ?? '';
      el.textContent = `${time} ${location}`.trim();
    });
  }
  tickPillTime();
  setInterval(tickPillTime, 30_000);
  document.addEventListener('astro:after-swap', tickPillTime);
</script>
