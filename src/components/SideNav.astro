---
import { getCollection } from 'astro:content';

// Two states, one rule: expanded = docked paper (reserves space, no glass);
// collapsed = floating glass dock (content flows beneath). User toggle persists.
const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
const workshop = (await getCollection('workshop')).filter((w) => !w.data.draft);
const writing = (await getCollection('writing')).filter((w) => !w.data.draft);
const doodles = (await getCollection('doodles')).filter((d) => !d.data.draft);

const items = [
  { href: '/about', label: 'about', count: null },
  { href: '/projects', label: 'work', count: projects.length },
  { href: '/workshop', label: 'workshop', count: workshop.length },
  { href: '/writing', label: 'writing', count: writing.length },
  { href: '/doodles', label: 'doodles', count: doodles.length },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<aside class="sidenav" transition:persist="sidenav">
  {/* Expanded — docked paper panel */}
  <div class="nav-expanded">
    <div class="nav-head">
      <a href="/" class="nav-name">Shellie Hu</a>
      <button class="nav-toggle" data-nav-collapse aria-label="Collapse navigation">⟨</button>
    </div>
    <nav class="nav-list">
      {items.map((item) => (
        <a href={item.href} class:list={['nav-row', { active: isActive(item.href) }]}>
          <span class="nav-thumb" aria-hidden="true"></span>
          <span class="nav-label">{item.label}</span>
          {item.count !== null && <span class="nav-count">{item.count}</span>}
        </a>
      ))}
    </nav>
    <div class="nav-foot">
      <a href="mailto:shelliehxx@outlook.com">email</a>
      <a href="https://www.linkedin.com/in/shelliehu/">linkedin</a>
      <a href="https://www.instagram.com/shellwedraw/">instagram</a>
    </div>
  </div>

  {/* Collapsed — floating glass dock */}
  <div class="nav-dock glass">
    <button class="nav-toggle" data-nav-expand aria-label="Expand navigation">⟩</button>
    {items.map((item) => (
      <a
        href={item.href}
        class:list={['dock-item', { active: isActive(item.href) }]}
        title={item.count !== null ? `${item.label} · ${item.count}` : item.label}
      >
        <span class="dock-glyph" aria-hidden="true"></span>
      </a>
    ))}
    <div class="dock-spacer"></div>
    <a href="/about" class="dock-avatar" title="Shellie Hu · about" aria-label="About Shellie Hu"></a>
  </div>
</aside>

<style>
  /* Expanded state — in-flow (content reflows beside it), styled as the
     soft inset panel from the canonical mock: 168px, 16px inset, radius 14. */
  .nav-expanded {
    display: flex;
    flex-direction: column;
    width: 168px;
    height: calc(100dvh - 32px);
    position: sticky;
    top: 16px;
    margin: 16px 0 16px 16px;
    padding: 1.125rem 0.75rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--color-bg) 66%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-bg) 95%, transparent);
    box-shadow: 0 8px 32px color-mix(in oklab, var(--color-ink) 10%, transparent);
  }
  @supports (backdrop-filter: blur(1px)) {
    .nav-expanded { backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
  }
  .nav-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.625rem 1rem 0.625rem;
  }
  .nav-name {
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .nav-name:hover { color: var(--color-accent); }
  .nav-toggle {
    background: none;
    border: none;
    color: var(--color-ink-faint);
    font-size: 0.8125rem;
    cursor: pointer;
    padding: 0.25rem 0.375rem;
    border-radius: 6px;
    transition: color var(--motion-micro) ease;
  }
  .nav-toggle:hover { color: var(--color-accent); }
  .nav-list { display: flex; flex-direction: column; gap: 2px; }
  .nav-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    transition: color var(--motion-micro) ease, background var(--motion-micro) ease;
  }
  .nav-row:hover { color: var(--color-ink); }
  .nav-row.active {
    color: var(--color-ink);
    font-weight: 500;
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }
  .nav-thumb {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background: var(--color-rule);
    border-radius: 6px;
  }
  .nav-label { flex: 1; }
  .nav-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }
  .nav-row.active .nav-count { color: var(--color-ink-muted); }
  .nav-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 0.625rem 0 0.625rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.8125rem;
  }
  .nav-foot a { color: var(--color-ink-muted); }

  /* Collapsed state — glass capsule */
  .nav-dock {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: fixed;
    left: 16px;
    top: 16px;
    bottom: 16px;
    width: 56px;
    padding: 0.875rem 0;
    border-radius: 999px;
    z-index: 40;
  }
  .nav-dock .nav-toggle { padding-bottom: 0.375rem; }
  .dock-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    transition: background var(--motion-micro) ease;
  }
  .dock-item:hover,
  .dock-item.active {
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }
  .dock-glyph {
    width: 32px;
    height: 32px;
    background: var(--color-rule);
    border-radius: 8px;
  }
  .dock-spacer { flex: 1; }
  .dock-avatar {
    width: 26px;
    height: 26px;
    background: var(--color-rule);
    border-radius: 999px;
  }

  /* State switch — driven by data-nav on <html>, set pre-paint */
  :global(html[data-nav='collapsed']) .nav-expanded { display: none; }
  :global(html:not([data-nav='collapsed'])) .nav-dock { display: none; }

  /* Mobile: no sidebar in phase 1 — TopBar carries the links */
  @media (max-width: 768px) {
    .nav-expanded, .nav-dock { display: none !important; }
  }
</style>

<script>
  function wireNav() {
    document.querySelectorAll('[data-nav-collapse]').forEach((el) =>
      el.addEventListener('click', () => {
        document.documentElement.setAttribute('data-nav', 'collapsed');
        localStorage.setItem('nav', 'collapsed');
      }),
    );
    document.querySelectorAll('[data-nav-expand]').forEach((el) =>
      el.addEventListener('click', () => {
        document.documentElement.removeAttribute('data-nav');
        localStorage.setItem('nav', 'expanded');
      }),
    );
  }
  wireNav();
  document.addEventListener('astro:after-swap', wireNav);
</script>
