---
// One element, two shapes: at rest a small glass capsule sits bottom-left
// holding the library (menu) button; open, the capsule grows to full height
// and the nav icons appear above it. The trigger never moves — the capsule
// morphs around it. Glass floats over the page margin; content never reflows.

const items = [
  { href: '/about', label: 'about' },
  { href: '/projects', label: 'work' },
  { href: '/workshop', label: 'workshop' },
  { href: '/writing', label: 'writing' },
  { href: '/doodles', label: 'doodle' },
];

// 24-viewBox glyphs, 1.5px optical stroke at rendered size, round caps.
const glyphs: Record<string, string> = {
  about:
    '<circle cx="12" cy="8.5" r="3.25"/><path d="M5.5 19.5c.9-3.7 3.5-5.6 6.5-5.6s5.6 1.9 6.5 5.6"/>',
  work:
    '<circle cx="12" cy="12" r="8.25"/><circle cx="12" cy="12" r="1.4"/><path d="M12 7.75a4.25 4.25 0 0 1 4.25 4.25"/>',
  workshop: '<path d="M6.5 8.5l4.5 3.5-4.5 3.5"/><path d="M13.5 16.5H18"/>',
  writing: '<path d="M16.7 3.8a2 2 0 0 1 2.8 2.8L8 18l-4.2 1.4L5.2 15 16.7 3.8z"/>',
  doodle:
    '<path d="M4 15.5c1.6-5.5 3.6-7 4.6-4.2s.6 6.9 2.6 5 .9-7.5 3.4-6.4 3 4.6 5.4 3.6"/>',
  library: '<path d="M6.5 5v14"/><path d="M10.5 5v14"/><path d="M14 5.5l4.5 13"/>',
};

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav class="dock glass" transition:persist="sidenav" aria-label="Site navigation">
  <div class="dock-items">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={['dock-item', { active: isActive(item.href) }]}
        aria-label={item.label}
        title={item.label}
      >
        <svg
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.125"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={glyphs[item.label]}
        />
      </a>
    ))}
  </div>
  <button
    type="button"
    class="dock-library"
    data-nav-toggle
    aria-label="Toggle navigation menu"
    aria-expanded="false"
  >
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.385"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={glyphs.library}
    />
  </button>
</nav>

<style>
  .dock {
    position: fixed;
    left: var(--nav-inset);
    bottom: var(--nav-inset);
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: 56px;
    height: 56px; /* closed: capsule around the library button */
    padding: 0.875rem 0;
    border-radius: 999px;
    overflow: hidden;
    transition: height var(--motion-content) cubic-bezier(0.2, 0, 0, 1);
  }
  /* Hover peek — the capsule stretches upward, hinting at the expansion. */
  :global(html:not([data-nav='open'])) .dock:hover { height: 79px; }
  :global(html[data-nav='open']) .dock {
    height: calc(100dvh - 2 * var(--nav-inset));
  }

  .dock-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-height: 0;
    opacity: 0;
    visibility: hidden; /* removes hidden links from the tab order */
    pointer-events: none;
    transition:
      opacity var(--motion-fade) ease-out,
      visibility 0s linear var(--motion-fade);
  }
  /* Container grows first, then contents arrive; on close they leave first. */
  :global(html[data-nav='open']) .dock-items {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 120ms, 120ms;
  }

  .dock-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--color-ink-muted);
    transition:
      background var(--motion-micro) ease,
      color var(--motion-micro) ease;
  }
  .dock-item:hover {
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }
  .dock-item.active {
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }

  .dock-library {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    color: var(--color-ink);
    cursor: pointer;
    transition: scale var(--motion-micro) ease;
  }
  /* 26px glyph, 40px hit area */
  .dock-library::after {
    content: '';
    position: absolute;
    inset: -7px;
  }
  .dock-library:active { scale: 0.96; }

  @media (prefers-reduced-motion: reduce) {
    .dock { transition: none; }
    .dock-items { transition: opacity var(--motion-micro) ease; transition-delay: 0ms; }
  }

  /* Mobile: no dock in phase 1 — TopBar carries the links */
  @media (max-width: 768px) {
    .dock { display: none !important; }
  }
</style>

<script>
  function wireNav() {
    document.querySelectorAll('[data-nav-toggle]').forEach((el) => {
      el.addEventListener('click', () => {
        const open = document.documentElement.getAttribute('data-nav') === 'open';
        if (open) {
          document.documentElement.removeAttribute('data-nav');
          localStorage.setItem('nav', 'closed');
        } else {
          document.documentElement.setAttribute('data-nav', 'open');
          localStorage.setItem('nav', 'open');
        }
        el.setAttribute('aria-expanded', String(!open));
      });
    });
  }
  wireNav();
  document.addEventListener('astro:after-swap', wireNav);
</script>
