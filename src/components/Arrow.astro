---
// The site's one arrow, in three directions. Every arrow used to be a font
// glyph (←, →, ↗) except the crumb's drawn SVG — so arrows changed weight
// and posture from seat to seat. This is the crumb's drawing (stroke 1.25,
// round caps), inherited color, baseline-tucked. Use it everywhere.
// (TopBar's crumb keeps its own inline copy — scoped styles ride it there.)
// Template is one contiguous line: newlines around inline markup render as
// stray spaces beside punctuation (the FileChip lesson).
interface Props {
  dir?: 'left' | 'right' | 'out';
  size?: number;
  class?: string;
}
const { dir = 'right', size = 12, class: className } = Astro.props;
---
<svg class:list={['arrow-glyph', className]} width={size} height={size} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{dir === 'left' ? <><path d="M10.5 6H1.5" /><path d="M5.5 2 1.5 6l4 4" /></> : dir === 'right' ? <><path d="M1.5 6h9" /><path d="M6.5 2 10.5 6l-4 4" /></> : <><path d="M3.2 8.8 8.8 3.2" /><path d="M4.4 3.2h4.4v4.4" /></>}</svg><style>
  .arrow-glyph {
    display: inline-block;
    vertical-align: -1px; /* optical seat beside lowercase text */
    flex-shrink: 0;
  }
</style>
