---
/* A repo cited in prose — the GitHub mark + mono name as a small inline
   object, sibling to FileChip's attachment chip. Just the name; the repo
   speaks for itself on the other side of the click. */
interface Props {
  repo: string;
  href: string;
}
const { repo, href } = Astro.props;
/* Markup stays newline-free — a stray text node around an inline component
   renders as a space before the sentence's next punctuation mark. */
---
<a class="repo-chip paper" href={href} target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg><span class="repo-chip-name">{repo}</span></a><style>
  .repo-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 1px 9px 1px 7px;
    border: 0; /* paper is cut, not outlined */
    border-radius: 8px;
    color: var(--color-ink-muted);
    text-decoration: none;
    vertical-align: baseline;
    /* chip-scale elevation — .paper's card shadow is too deep for inline */
    box-shadow:
      0px 1px 2px rgb(0 0 0 / 0.04),
      0px 2px 6px -2px color-mix(in oklab, var(--color-ink) 8%, transparent);
    transition: box-shadow var(--motion-micro) ease, color var(--motion-micro) ease;
  }
  .repo-chip:hover {
    color: var(--color-accent);
    box-shadow:
      0px 1px 2px rgb(0 0 0 / 0.04),
      0px 3px 9px -2px color-mix(in oklab, var(--color-ink) 12%, transparent);
  }
  :global(html[data-theme='dark']) .repo-chip,
  :global(html[data-theme='dark']) .repo-chip:hover {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08); /* the ring, like every dark card */
  }
  .repo-chip-name {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--color-ink);
    line-height: 1.5;
  }
</style>
