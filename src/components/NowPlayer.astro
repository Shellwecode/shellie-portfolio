---
import now from '../data/now.json';

// The floaty player — the whisper pill grown into an instrument (Paper: "now
// player" frame, aug 2). At rest: album art, song, hairline progress, Boston
// time + temperature. Click anywhere on it and the pill inflates into a
// near-full now-playing sheet (Spotify rise): song on the left, the Now panel
// (reading / listening / pondering / cooking) on the right. The ▶ stays inert
// until the Spotify swap lands. Exits: ✕, Esc, scrim, handle, navigation.
---

<div class="now-player" transition:persist="now-player" data-now-player>
  <button
    type="button"
    class="np-pill glass"
    data-np-open
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="Now playing — open"
  >
    <span
      class="np-art np-art-sm"
      style={`background-image: url(${now.listening.cover})`}
      aria-hidden="true"
    ></span>
    <span class="np-pill-song">
      <span class="np-pill-title">{now.listening.title}</span>
      <span class="np-pill-artist">{now.listening.artist}</span>
      <span class="np-pill-track" aria-hidden="true"><span class="np-pill-needle"></span></span>
    </span>
    <span class="np-pill-place">
      <span class="np-pill-city">{now.location.toUpperCase()}</span>
      <span class="np-pill-clock" data-np-clock>16:33</span>
    </span>
  </button>

  <div class="np-scrim" data-np-close aria-hidden="true"></div>

  <section class="np-sheet" role="dialog" aria-modal="true" aria-label="Now playing" aria-hidden="true">
    {/* the album leaks into the room — oversized cover, heavily blurred */}
    <div
      class="np-reflection"
      style={`background-image: url(${now.listening.cover})`}
      aria-hidden="true"
    ></div>

    <button type="button" class="np-handle" data-np-close aria-label="Close now playing"></button>
    <button type="button" class="np-x" data-np-close aria-label="Close now playing">
      <svg width="12" height="12" viewBox="0 0 12 12"><path d="M1 1 L11 11 M11 1 L1 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    </button>

    <div class="np-cols">
      <div class="np-left">
        <div
          class="np-art np-art-xl"
          style={`background-image: url(${now.listening.cover})`}
          aria-hidden="true"
        ></div>
        <div class="np-song">
          <span class="np-song-title">{now.listening.title}</span>
          <span class="np-song-artist">{now.listening.artist}</span>
        </div>
        <div class="np-progress">
          <div class="np-progress-track"><span class="np-progress-fill"></span></div>
          <div class="np-progress-times">
            <span>2:24</span>
            <span>−1:54</span>
          </div>
        </div>
        <div class="np-transport">
          <button type="button" class="np-skip" title="voice notes — some day" aria-label="Previous">
            <svg width="22" height="14" viewBox="0 0 22 14"><path d="M10 1 L2 7 L10 13 Z M20 1 L12 7 L20 13 Z" fill="currentColor"/></svg>
          </button>
          <button type="button" class="np-play" title="the real stream — some day" aria-label="Play">
            <svg width="18" height="20" viewBox="0 0 18 20"><path d="M2 1.5 L16.5 10 L2 18.5 Z" fill="#FAF8F5"/></svg>
          </button>
          <button type="button" class="np-skip" title="voice notes — some day" aria-label="Next">
            <svg width="22" height="14" viewBox="0 0 22 14"><path d="M2 1 L10 7 L2 13 Z M12 1 L20 7 L12 13 Z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>

      <div class="np-right">
        <div class="np-now-head">
          <span class="np-now-title">Now</span>
          <span class="np-now-meta" data-np-meta>Boston, 16:33</span>
        </div>

        <div class="np-module">
          <span class="np-label">Reading</span>
          <div class="np-book">
            <span
              class="np-book-cover"
              style={`background-image: url(${now.reading.cover})`}
              aria-hidden="true"
            ></span>
            <span class="np-book-id">
              <span class="np-book-title">{now.reading.title}</span>
              <span class="np-book-author">{now.reading.author}</span>
            </span>
          </div>
        </div>

        <div class="np-module">
          <span class="np-label">Listening</span>
          <div class="np-queue">
            {now.podcasts.map((p, i) => (
              <a class="np-row" href={p.href} target="_blank" rel="noopener noreferrer">
                <span class="np-row-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="np-row-title">{p.title}</span>
                <span class="np-row-kind">{p.show}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="np-module">
          <span class="np-label">Pondering</span>
          <p class="np-thought">{now.thought}</p>
        </div>

        <div class="np-module">
          <span class="np-label">Cooking</span>
          <div class="np-dishes">
            {now.cooked.photos.map((photo, i) => (
              <button
                type="button"
                class="np-dish"
                style={`background-image: url(${photo})`}
                data-np-view={photo}
                aria-label={`View cooking photo ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>

    {/* photo viewer — click a dish, see it big; click anywhere / Esc tucks it away */}
    <div class="np-lightbox" data-np-lightbox aria-hidden="true">
      <img class="np-lightbox-img" alt="Cooking photo, enlarged" />
    </div>
  </section>
</div>

<style>
  .now-player {
    /* one source for the album's color — pill art, sheet art, reflection */
    --np-art-grad: linear-gradient(145deg, #d9c9b2 0%, #c4ae92 55%, #a98f72 100%);
  }

  /* -------------------------------------------------------------------------
     The pill at rest
  ------------------------------------------------------------------------- */
  .np-pill {
    position: fixed;
    left: 50%;
    bottom: var(--pill-bottom);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 16px;
    width: min(520px, calc(100vw - 32px));
    height: 76px;
    padding: 12px 22px 12px 12px;
    border-radius: 24px;
    z-index: 50;
    cursor: pointer;
    text-align: left;
    transition:
      opacity var(--motion-micro) ease-out,
      scale var(--motion-micro) ease-out,
      box-shadow var(--motion-micro) ease;
  }
  .np-pill:hover {
    box-shadow: 0 10px 36px color-mix(in oklab, var(--color-ink) 14%, transparent);
  }
  .np-pill:active { scale: 0.96; }

  .np-art {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--np-art-grad); /* stand-in while a cover loads */
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  .np-art-sm { width: 52px; height: 52px; border-radius: 13px; }

  .np-pill-song {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }
  .np-pill-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 22px;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .np-pill-artist {
    font-weight: 300;
    font-size: 0.75rem;
    line-height: 15px;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
  .np-pill-track {
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
  }
  .np-pill-needle {
    display: block;
    width: 55%;
    height: 2px;
    border-radius: 1px;
    background: var(--color-accent);
  }

  .np-pill-place {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    flex-shrink: 0;
  }
  .np-pill-city {
    font-size: 0.625rem;
    line-height: 12px;
    letter-spacing: 0.08em;
    color: var(--color-ink-faint);
  }
  .np-pill-clock {
    font-weight: 300;
    font-size: 0.8125rem;
    line-height: 16px;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  /* pill recedes while the sheet is up */
  :global(html[data-np='open']) .np-pill {
    opacity: 0;
    scale: 1.06;
    pointer-events: none;
  }

  /* -------------------------------------------------------------------------
     Scrim + sheet — the Spotify rise
  ------------------------------------------------------------------------- */
  .np-scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: color-mix(in oklab, #1b1815 45%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms ease-out,
      visibility 0s linear 400ms;
  }
  :global(html[data-np='open']) .np-scrim {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s;
  }

  .np-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: min(860px, calc(100dvh - 64px));
    z-index: 95;
    border-radius: 28px 28px 0 0;
    /* translucent paper — the page stays present through it */
    background: color-mix(in oklab, var(--color-bg) 72%, transparent);
    box-shadow: 0 -18px 60px -12px rgb(0 0 0 / 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* closed */
    translate: 0 103%;
    visibility: hidden;
    transition:
      translate 550ms cubic-bezier(0.2, 0, 0, 1),
      visibility 0s linear 550ms;
  }
  @supports (backdrop-filter: blur(1px)) {
    .np-sheet {
      backdrop-filter: blur(40px);
      -webkit-backdrop-filter: blur(40px);
    }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .np-sheet { background: var(--color-bg); }
  }
  :global(html[data-np='open']) .np-sheet {
    translate: 0 0;
    visibility: visible;
    transition-delay: 0s, 0s;
  }
  /* closing is softer and quicker than opening */
  :global(html:not([data-np='open'])) .np-sheet {
    transition-duration: 380ms, 0s;
    transition-timing-function: ease-out, linear;
  }
  :global(html:not([data-np='open'])) .np-scrim {
    transition-duration: 300ms, 0s;
  }

  /* the album reflected into the room */
  .np-reflection {
    position: absolute;
    left: -12%;
    top: -30%;
    width: 70%;
    height: 120%;
    background: var(--np-art-grad);
    background-size: cover;
    background-position: center;
    border-radius: 50%;
    filter: blur(110px) saturate(1.15);
    opacity: 0.5;
    pointer-events: none;
  }

  .np-handle {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
    width: 120px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .np-handle::before {
    content: '';
    width: 44px;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in oklab, var(--color-ink) 16%, transparent);
    transition: background var(--motion-micro) ease;
  }
  .np-handle:hover::before {
    background: color-mix(in oklab, var(--color-ink) 32%, transparent);
  }

  .np-x {
    position: absolute;
    top: 18px;
    right: 22px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-ink-muted);
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
    cursor: pointer;
    transition:
      background var(--motion-micro) ease,
      color var(--motion-micro) ease,
      scale var(--motion-micro) ease;
  }
  .np-x:hover {
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 9%, transparent);
  }
  .np-x:active { scale: 0.96; }

  /* -------------------------------------------------------------------------
     Sheet content
  ------------------------------------------------------------------------- */
  .np-cols {
    position: relative;
    display: flex;
    gap: clamp(48px, 8vw, 110px);
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding: 66px 40px 40px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .np-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    width: 480px;
    flex-shrink: 0;
  }
  .np-art-xl {
    width: min(420px, 100%);
    aspect-ratio: 1;
    border-radius: 22px;
    box-shadow:
      0 1px 2px -1px rgb(0 0 0 / 0.06),
      0 24px 64px -16px color-mix(in oklab, var(--color-ink) 28%, transparent);
  }
  .np-song {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .np-song-title {
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 24px;
    color: var(--color-ink);
  }
  .np-song-artist {
    font-size: 1rem;
    line-height: 19px;
    color: var(--color-ink-muted);
  }
  .np-progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(420px, 100%);
  }
  .np-progress-track {
    width: 100%;
    height: 7px;
    border-radius: 3px;
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
    display: flex;
  }
  .np-progress-fill {
    width: 55%;
    height: 7px;
    border-radius: 3px;
    background: var(--color-accent);
  }
  .np-progress-times {
    display: flex;
    justify-content: space-between;
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .np-transport {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .np-skip {
    color: var(--color-ink-muted);
    cursor: pointer;
    padding: 10px;
    transition: color var(--motion-micro) ease, scale var(--motion-micro) ease;
  }
  .np-skip:hover { color: var(--color-ink); }
  .np-skip:active { scale: 0.96; }
  .np-play {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    background: var(--color-accent);
    box-shadow: 0 8px 22px -6px color-mix(in oklab, var(--color-accent) 45%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px; /* optical center for the triangle */
    cursor: pointer;
    transition: scale var(--motion-micro) ease;
  }
  .np-play:active { scale: 0.96; }

  .np-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
    min-width: 0;
    padding-top: 8px;
  }
  .np-now-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .np-now-title {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 22px;
    color: var(--color-ink);
  }
  .np-now-meta {
    font-weight: 300;
    font-size: 0.75rem;
    line-height: 16px;
    color: var(--color-ink-muted);
  }

  .np-module {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .np-label {
    font-size: 0.875rem;
    line-height: 18px;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .np-book {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .np-book-cover {
    width: 94px;
    height: 127px;
    flex-shrink: 0;
    border-radius: 6px;
    background: linear-gradient(160deg, #8a9b8e 0%, #6e8173 100%); /* stand-in */
    background-size: cover;
    background-position: center;
    box-shadow:
      inset 2px 0 0 rgb(42 40 36 / 0.18),
      0 6px 16px -6px rgb(42 40 36 / 0.3);
  }
  .np-book-id {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .np-book-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 21px;
    color: var(--color-ink);
  }
  .np-book-author {
    font-size: 1rem;
    line-height: 19px;
    color: var(--color-ink-muted);
  }

  .np-queue { display: flex; flex-direction: column; }
  .np-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 11px;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 6%, transparent);
    text-decoration: none;
  }
  .np-row:last-child { border-bottom: none; }
  .np-row-n {
    width: 20px;
    flex-shrink: 0;
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .np-row-title {
    flex: 1;
    min-width: 0;
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 20px;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--motion-micro) ease;
  }
  .np-row:hover .np-row-title { color: var(--color-accent); }
  .np-row-kind {
    flex-shrink: 0;
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .np-thought {
    font-size: 0.875rem;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .np-dishes { display: flex; gap: 18px; }
  .np-dish {
    flex: 1;
    min-width: 0;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    background: linear-gradient(160deg, #8a9b8e 0%, #6e8173 100%); /* stand-in */
    background-size: cover;
    background-position: center;
    box-shadow: 0 6px 16px -6px rgb(42 40 36 / 0.3);
    cursor: zoom-in;
    padding: 0;
    transition: box-shadow var(--motion-micro) ease, scale var(--motion-micro) ease;
  }
  .np-dish:hover { box-shadow: 0 10px 24px -8px rgb(42 40 36 / 0.4); }
  .np-dish:active { scale: 0.96; }

  .np-lightbox {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, #1b1815 55%, transparent);
    cursor: zoom-out;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms ease-out,
      visibility 0s linear 250ms;
  }
  .np-lightbox.open {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s;
  }
  .np-lightbox-img {
    max-width: min(860px, 86%);
    max-height: 86%;
    border-radius: 12px;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.5);
    scale: 0.96;
    transition: scale 250ms cubic-bezier(0.2, 0, 0, 1);
  }
  .np-lightbox.open .np-lightbox-img { scale: 1; }
  @media (prefers-reduced-motion: reduce) {
    .np-lightbox-img { scale: 1; }
  }

  /* -------------------------------------------------------------------------
     Small screens: single column, pill slims down
  ------------------------------------------------------------------------- */
  /* dark glass eats the faint tier — one step up for legibility */
  :global(html[data-theme='dark']) .np-label,
  :global(html[data-theme='dark']) .np-progress-times,
  :global(html[data-theme='dark']) .np-row-n {
    color: var(--color-ink-muted);
  }

  @media (max-width: 768px) {
    .np-pill { height: 72px; gap: 12px; padding: 10px 16px 10px 10px; border-radius: 22px; }
    .np-art-sm { width: 52px; height: 52px; border-radius: 12px; }
    .np-pill-place { display: none; }
    .np-sheet { height: calc(100dvh - 40px); }
    .np-cols { flex-direction: column; gap: 40px; padding: 56px 24px 40px; }
    .np-left { width: 100%; }
    .np-art-xl { width: min(320px, 78vw); }
    .np-reflection { width: 130%; left: -15%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-sheet {
      translate: 0 0;
      opacity: 0;
      transition: opacity 150ms ease, visibility 0s linear 150ms;
    }
    :global(html[data-np='open']) .np-sheet { opacity: 1; }
  }
</style>

<script>
  // Open/close is a class flip on <html>; every motion is a CSS transition,
  // so a mid-flight reversal just retargets (make-interfaces-feel-better).
  function setPlayer(open: boolean) {
    if (open && !document.querySelector('.np-sheet')) return; // page without the player
    const html = document.documentElement;
    if (open) html.setAttribute('data-np', 'open');
    else {
      html.removeAttribute('data-np');
      setLightbox(null); // the viewer never outlives the sheet
    }
    document.querySelector('.np-sheet')?.setAttribute('aria-hidden', String(!open));
    document
      .querySelectorAll('[data-np-open]')
      .forEach((el) => el.setAttribute('aria-expanded', String(open)));
    // Lenis keeps scrolling through overflow:hidden — stop the instrument itself.
    const lenis = (window as any).lenis;
    if (lenis) open ? lenis.stop() : lenis.start();
    if (open) (document.querySelector('.np-x') as HTMLElement | null)?.focus();
  }
  const playerIsOpen = () => document.documentElement.getAttribute('data-np') === 'open';

  function setLightbox(src: string | null) {
    const box = document.querySelector('[data-np-lightbox]');
    if (!box) return;
    const img = box.querySelector('img');
    if (src && img) img.src = src;
    box.classList.toggle('open', Boolean(src));
    box.setAttribute('aria-hidden', String(!src));
  }
  const lightboxIsOpen = () =>
    document.querySelector('[data-np-lightbox]')?.classList.contains('open') ?? false;

  function wirePlayer() {
    // The pill persists across view transitions while this re-runs per page —
    // the guard keeps listeners from stacking.
    const wire = (el: Element, fn: () => void) => {
      if ((el as HTMLElement).dataset.wired) return;
      (el as HTMLElement).dataset.wired = '1';
      el.addEventListener('click', fn);
    };
    document.querySelectorAll('[data-np-open]').forEach((el) => wire(el, () => setPlayer(true)));
    document.querySelectorAll('[data-np-close]').forEach((el) => wire(el, () => setPlayer(false)));
    document
      .querySelectorAll('[data-np-view]')
      .forEach((el) =>
        wire(el, () => setLightbox((el as HTMLElement).dataset.npView ?? null)),
      );
    const box = document.querySelector('[data-np-lightbox]');
    if (box) wire(box, () => setLightbox(null));
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightboxIsOpen()) {
      setLightbox(null);
      return; // one layer at a time — the sheet stays up
    }
    if (e.key === 'Escape' && playerIsOpen()) setPlayer(false);
    // 'n' toggles the sheet (inherited from the retired now rail); only where
    // the player exists, never while typing.
    if ((e.key === 'n' || e.key === 'N') && !e.metaKey && !e.ctrlKey) {
      if (!document.querySelector('.np-sheet')) return;
      const target = e.target as HTMLElement;
      if (target.tagName !== 'INPUT' && target.tagName !== 'TEXTAREA') setPlayer(!playerIsOpen());
    }
  });

  // Live Boston time + temperature. Time ticks locally; temperature comes from
  // open-meteo (no key), cached for 30 minutes, and simply absent on failure.
  const BOSTON = { lat: 42.36, lon: -71.06 };
  let temp: string | null = null;

  function paintClock() {
    const time = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'America/New_York',
    }).format(new Date());
    const withTemp = temp ? `${time} · ${temp}` : time;
    document.querySelectorAll('[data-np-clock]').forEach((el) => (el.textContent = withTemp));
    document
      .querySelectorAll('[data-np-meta]')
      .forEach((el) => (el.textContent = `Boston, ${time}${temp ? `, ${temp}` : ''}`));
  }

  async function fetchTemp() {
    try {
      const cached = sessionStorage.getItem('np-temp');
      if (cached) {
        const { value, at } = JSON.parse(cached);
        if (Date.now() - at < 30 * 60_000) {
          temp = value;
          return;
        }
      }
      const res = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${BOSTON.lat}&longitude=${BOSTON.lon}&current=temperature_2m&temperature_unit=fahrenheit`,
      );
      const data = await res.json();
      const t = data?.current?.temperature_2m;
      if (typeof t === 'number') {
        temp = `${Math.round(t)}°`;
        sessionStorage.setItem('np-temp', JSON.stringify({ value: temp, at: Date.now() }));
      }
    } catch {
      /* no temperature is a fine temperature */
    }
  }

  wirePlayer();
  paintClock();
  fetchTemp().then(paintClock);
  setInterval(paintClock, 30_000);
  document.addEventListener('astro:after-swap', () => {
    setPlayer(false); // arriving on a new page closes the sheet
    wirePlayer();
    paintClock();
  });
</script>
