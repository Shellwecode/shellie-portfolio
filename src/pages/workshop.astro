---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const items = (await getCollection('workshop'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.year - a.data.year);

const statusLabel = (s: string) => (s === 'in-dev' ? 'in dev' : s);
---

<Base
  title="Workshop — Shellie Hu"
  description="Side projects, experiments, and half-built things."
>
  <section class="mb-10" style="max-width: var(--measure);">
    <h2 class="section-label">workshop</h2>
    <h1 class="text-xl font-medium mb-3">Workshop</h1>
    <p class="text-[var(--color-ink-muted)] leading-relaxed">
      Side projects and experiments. Some live, some half-built, some
      still just a sketch. This is where I try things on.
    </p>
  </section>

  <ul class="workshop-list" style="max-width: var(--measure-wide);">
    {items.map((w) => (
      <li class="workshop-card">
        {w.data.hero && (
          w.data.live ? (
            <a href={w.data.live} target="_blank" rel="noopener noreferrer" class="card-link">
              <div class="card-hero">
                <Image
                  src={w.data.hero}
                  alt={`${w.data.title} cover`}
                  widths={[600, 900, 1200]}
                  sizes="(max-width: 768px) 100vw, 768px"
                />
                <span class="card-veil" aria-hidden="true"></span>
                <span class="card-overlay">
                  <span class="card-tag">{statusLabel(w.data.status)}</span>
                  <span class="card-ov-title">{w.data.title}</span>
                </span>
                <span class="card-go" aria-hidden="true">↗</span>
              </div>
            </a>
          ) : (
            <div class="card-link">
              <div class="card-hero">
                <Image
                  src={w.data.hero}
                  alt={`${w.data.title} cover`}
                  widths={[600, 900, 1200]}
                  sizes="(max-width: 768px) 100vw, 768px"
                />
                <span class="card-veil" aria-hidden="true"></span>
                <span class="card-overlay">
                  <span class="card-tag">{statusLabel(w.data.status)}</span>
                  <span class="card-ov-title">{w.data.title}</span>
                </span>
              </div>
            </div>
          )
        )}
        <div class="card-meta" style="max-width: var(--measure);">
          <p class="card-summary">{w.data.summary}</p>
          {w.data.stack.length > 0 && (
            <ul class="card-stack">
              {w.data.stack.map((t) => <li>{t}</li>)}
            </ul>
          )}
          {(w.data.live || w.data.github) && (
            <p class="card-actions">
              {w.data.live && (
                <a href={w.data.live} target="_blank" rel="noopener noreferrer">live ↗</a>
              )}
              {w.data.github && (
                <a href={w.data.github} target="_blank" rel="noopener noreferrer">github ↗</a>
              )}
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .section-label {
    font-weight: 300;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-transform: lowercase;
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
  }

  .workshop-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .workshop-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-link,
  .card-link:hover {
    text-decoration: none;
    display: block;
  }

  .card-hero {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-rule);
    box-shadow: var(--shadow-card);
    transition: box-shadow 200ms ease;
  }
  .card-link:hover .card-hero,
  .card-link:focus-visible .card-hero { box-shadow: var(--shadow-card-hover); }
  .card-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .card-link:hover .card-hero :global(img) {
    transform: scale(1.02);
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-summary {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.6;
  }

  .card-stack {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .card-stack li {
    font-weight: 300;
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .card-actions {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    display: flex;
    gap: 1.25rem;
  }
  .card-actions a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .card-actions a:hover {
    color: var(--color-accent);
  }
</style>
