---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ReadingBar from '../../components/ReadingBar.astro';
import ChapterPlayer from '../../components/ChapterPlayer.astro';
import AlbumSwitchDirector from '../../components/AlbumSwitchDirector';

export async function getStaticPaths() {
  const projects = (await getCollection('projects'))
    .filter((p) => !p.data.draft && !p.data.external)
    .sort((a, b) => b.data.year - a.data.year);

  return projects.map((project, i) => {
    const prev = projects[i + 1] ?? null; // older
    const next = projects[i - 1] ?? null; // newer
    return {
      params: { slug: project.id },
      props: {
        project,
        prev: prev ? { id: prev.id, title: prev.data.title } : null,
        next: next ? { id: next.id, title: next.data.title } : null,
      },
    };
  });
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);

// The album page: case study as record. Sections come from h2s; read time from body.
const sections = headings.filter((h) => h.depth === 2);
const body = project.body ?? '';
const words = body.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 200));

// Track "durations" — each section's words at ~200wpm, rounded to :05.
// These size the chapter player's segments, like track lengths on a record.
const h2Matches = [...body.matchAll(/^##\s+.*$/gm)];
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const tracks = sections.map((h, i) => {
  const m = h2Matches[i];
  const start = m ? (m.index ?? 0) + m[0].length : 0;
  const end = h2Matches[i + 1]?.index ?? body.length;
  const w = body.slice(start, end).split(/\s+/).filter(Boolean).length;
  const seconds = Math.max(30, Math.round((w / 200) * 60 / 5) * 5);
  return {
    slug: h.slug,
    title: h.text,
    note: project.data.trackNotes?.[h.slug],
    seconds,
    label: fmt(seconds),
  };
});
const totalSeconds = tracks.reduce((a, t) => a + t.seconds, 0);

// Album header copy — per the Paper frame "case study — detail (aug 4 edit)":
// short title, discipline eyebrow, "@company, timeframe" meta.
const shortTitle = project.data.title.split('—')[0].trim();
const eyebrow = project.data.discipline ?? project.data.role ?? 'case study';
const metaLine = [
  project.data.company ? `@${project.data.company}` : null,
  project.data.timeframe ?? String(project.data.year),
]
  .filter(Boolean)
  .join(', ');
---

<Base
  title={`${project.data.title} — Shellie Hu`}
  description={project.data.summary}
  deck="none"
  fog={true}
  quietDock={true}
>
  <a href="/projects" class="crumb">
    <svg class="crumb-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.5 6H1.5" /><path d="M5.5 2 1.5 6l4 4" />
    </svg>
    <span>work</span>
  </a>

  <header class="album-header">
    <div class="album-cover">
      {project.data.cover && (
        <Image
          src={project.data.cover}
          alt={`${project.data.title} — cover`}
          widths={[400, 800]}
          sizes="200px"
        />
      )}
    </div>
    <div class="album-copy">
      <span class="album-eyebrow">{eyebrow}</span>
      <h1 class="album-title">{shortTitle}</h1>
      <p class="album-summary">{project.data.summary}</p>
      <span class="album-meta">{metaLine}</span>
      <div class="album-actions">
        <a href="#read" class="album-read">
          <svg class="album-play" width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
            <path d="M1.5 0.8 9 5 1.5 9.2Z" />
          </svg>
          <span>{readMinutes} min</span>
        </a>
      </div>
    </div>
  </header>

  {tracks.length > 0 && (
    <nav class="tracklist" aria-label="Sections">
      {tracks.map((t, i) => (
        <a href={`#${t.slug}`} class="track" style={`--ri: ${tracks.length - 1 - i}; --i: ${i}`}>
          <span class="track-n">{i + 1}</span>
          <span class="track-title">{t.title}</span>
          {t.note && <span class="track-note">{t.note}</span>}
          <span class="track-time">{t.label}</span>
        </a>
      ))}
    </nav>
  )}

  {tracks.length > 0 && (
    <div class="read-hint" aria-hidden="true">
      <span>scroll to read</span>
      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M1 1l4 4 4-4" /></svg>
    </div>
  )}

  <article class="prose" id="read">
    <Content />
    <footer class="mt-10 pt-8 border-t border-[var(--color-rule)]">
      <a href="/projects" class="text-sm no-underline hover:text-[var(--color-accent)]">
        ← back to work
      </a>
    </footer>
  </article>

  {tracks.length > 0 ? (
    <ChapterPlayer
      title={project.data.title.split('—')[0].trim()}
      cover={project.data.cover}
      tracks={tracks}
      totalLabel={fmt(totalSeconds)}
      nextHref={next ? `/projects/${next.id}` : null}
      nextLabel={next?.title}
    />
  ) : (
    <ReadingBar
      title={project.data.title}
      prevHref={prev ? `/projects/${prev.id}` : null}
      prevLabel={prev?.title}
      nextHref={next ? `/projects/${next.id}` : null}
      nextLabel={next?.title}
    />
  )}

  {import.meta.env.DEV && <AlbumSwitchDirector client:only="react" />}
</Base>

<style>
  .crumb {
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: var(--measure);
    margin-inline: auto;
    font-weight: 300;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .crumb-arrow { flex-shrink: 0; }
  .crumb:hover { color: var(--color-accent); }

  /* The switch — one absolute point (html[data-reading], granted by the
     script below), no scrubbed in-between. At rest: album + tracklist, no
     player. On the switch: rows pour downward bottom-first and are caught
     by the player; the cover flies down into the player's thumbnail (the
     which-project avatar); the article rises. All timed transitions. */
  .album-header {
    display: flex;
    align-items: flex-end;
    gap: 1.75rem;
    padding: 1.5rem 0 1.75rem 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 1.5rem;
    max-width: var(--measure);
    margin-inline: auto;
    max-height: 340px;
    /* exit (returning to the album): expand after the article has cleared */
    transition:
      max-height 420ms cubic-bezier(0.5, 0, 0.3, 1) 160ms,
      padding 420ms cubic-bezier(0.5, 0, 0.3, 1) 160ms,
      margin-bottom 420ms cubic-bezier(0.5, 0, 0.3, 1) 160ms,
      border-color 200ms ease 160ms;
  }
  :global(html[data-reading]) .album-header {
    max-height: 0;
    padding-block: 0;
    margin-bottom: 0;
    border-color: transparent;
    /* enter: collapse once the cover has left and the rows are pouring */
    transition:
      max-height var(--sw-collapse-dur, 300ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-collapse-delay, 140ms),
      padding var(--sw-collapse-dur, 300ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-collapse-delay, 140ms),
      margin-bottom var(--sw-collapse-dur, 300ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-collapse-delay, 140ms),
      border-color 200ms ease var(--sw-collapse-delay, 140ms);
  }
  .album-cover {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    background: var(--color-rule);
    border-radius: 16px;
    overflow: hidden;
    /* exit: return home mid-sequence, materializing on the way */
    transition:
      translate 460ms cubic-bezier(0.4, 0, 0.25, 1) 240ms,
      scale 460ms cubic-bezier(0.4, 0, 0.25, 1) 240ms,
      opacity 200ms ease 240ms;
  }
  :global(html[data-reading]) .album-cover {
    /* flies to the player thumbnail's MEASURED seat (--fly-x/y, set by the
       script) and hands off only on arrival, as the player surfaces */
    translate: var(--fly-x, 270px) var(--fly-y, 52vh);
    /* a hair above the pill's true 0.26 — the dart dissolves mid-flight
       (fade at 210ms of 380ms), a gesture toward the thumb, not a merge */
    scale: var(--sw-fly-scale, 0.31);
    opacity: 0;
    transition:
      translate var(--sw-fly-dur, 380ms) cubic-bezier(0.55, 0, 0.25, 1),
      scale var(--sw-fly-dur, 380ms) cubic-bezier(0.55, 0, 0.25, 1),
      opacity 140ms ease var(--sw-fly-fade-delay, 210ms);
  }
  .album-copy {
    /* exit: the words return last, once their shelf is back */
    transition: opacity 240ms ease 320ms, translate 300ms ease 320ms, filter 240ms ease 320ms;
  }
  :global(html[data-reading]) .album-copy {
    opacity: 0;
    translate: 0 14px;
    /* enter: the words exhale first — a soft dissolve (the recede's calm,
       borrowed), cheap here because it's one small text block */
    filter: blur(var(--sw-copy-blur, 4.5px));
    transition: opacity 260ms ease 80ms, translate 380ms ease 80ms, filter 320ms ease 80ms;
  }
  .album-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .album-copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-bottom: 0.25rem;
    min-width: 0;
  }
  .album-eyebrow {
    font-weight: 300;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
  }
  .album-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .album-summary {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.55;
    max-width: 32.5rem;
  }
  .album-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }
  .album-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 0.375rem;
  }
  .album-read {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 1.25rem;
    background: var(--color-ink);
    color: var(--color-bg);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .album-play { flex-shrink: 0; }
  .album-read:hover { color: var(--color-bg); background: var(--color-accent); }

  .tracklist {
    display: flex;
    flex-direction: column;
    max-width: var(--measure);
    margin-inline: auto;
    margin-bottom: 1rem;
    max-height: 480px;
    /* exit: the shelf reopens early so returning rows have somewhere to land */
    transition:
      max-height 400ms cubic-bezier(0.5, 0, 0.3, 1) 120ms,
      margin-bottom 400ms cubic-bezier(0.5, 0, 0.3, 1) 120ms;
  }
  :global(html[data-reading]) .tracklist {
    max-height: 0;
    margin-bottom: 0;
    overflow: hidden;
    pointer-events: none;
    transition:
      max-height var(--sw-shelf-dur, 330ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-shelf-delay, 170ms),
      margin-bottom var(--sw-shelf-dur, 330ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-shelf-delay, 170ms);
  }
  .track {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    text-decoration: none;
    /* exit: rows deal back in top-first (--i is the forward index) */
    transition:
      translate 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 280ms ease,
      scale 320ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(200ms + var(--i, 0) * 40ms);
  }
  :global(html[data-reading]) .track {
    /* The pour — rows fall toward the player bottom-first (--ri is the
       reverse index), accelerating, and are caught by its segments.
       --sw-top-first flips the deal to top-first (0 or 1). */
    translate: 0 var(--sw-fall, 54px);
    scale: var(--sw-fall-scale, 0.945);
    opacity: 0;
    transition:
      translate var(--sw-fall-dur, 300ms) var(--sw-fall-ease, cubic-bezier(0.55, 0, 0.7, 0.5)),
      opacity var(--sw-fall-fade, 240ms) ease,
      scale var(--sw-fall-dur, 300ms) var(--sw-fall-ease, cubic-bezier(0.55, 0, 0.7, 0.5));
    /* 16ms: tight by choice — the pour reads as one sheet, not a dealt hand */
    transition-delay: calc(
      (var(--ri, 0) * (1 - var(--sw-top-first, 0)) + var(--i, 0) * var(--sw-top-first, 0)) *
        var(--sw-stagger, 16ms)
    );
  }
  .track-n {
    width: 1.5rem;
    flex-shrink: 0;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .track-title {
    width: 285px;
    flex-shrink: 0;
    font-size: var(--text-base);
    color: var(--color-ink);
    transition: color var(--motion-micro) ease;
  }
  .track:hover .track-title { color: var(--color-accent); }
  .track-note {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-time {
    margin-left: auto; /* holds the lane when a row has no note */
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  /* The hint — the album view's only invitation. Gone once reading. */
  .read-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    max-width: var(--measure);
    margin-inline: auto;
    padding-bottom: 2rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    transition: opacity 180ms ease;
  }
  .read-hint svg { animation: hint-bob 2.2s ease-in-out infinite; }
  @keyframes hint-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 3px; }
  }
  :global(html[data-reading]) .read-hint { opacity: 0; }

  .prose {
    margin-inline: auto; /* centered reading column, matching the player */
    padding-bottom: 7.5rem; /* clears the chapter player */
    opacity: 0;
    translate: 0 var(--sw-rise, 42px);
    /* exit: the article clears immediately so the album can take the stage */
    transition: opacity 200ms ease, translate 240ms ease;
  }
  :global(html[data-reading]) .prose {
    opacity: 1;
    translate: 0 0;
    /* enter: the long exhale — rises through the collapse and well past it */
    transition:
      opacity var(--sw-rise-dur, 880ms) ease var(--sw-rise-delay, 300ms),
      translate var(--sw-rise-dur, 880ms) cubic-bezier(0.22, 1, 0.36, 1) var(--sw-rise-delay, 300ms);
  }
  /* Arriving as the rows land — the catch reads as one gesture. */
  :global(html[data-reading]) :global(.chapter-player) {
    transition-delay: var(--sw-player-delay, 40ms);
  }

  /* ── Motion experiment: ?motion=recede ─────────────────────────────
     An alternative switch to compare against the pour: nothing travels
     except the cover — the album recedes into depth (soft blur, slight
     shrink, fade) while the article rises over it. Calmer, less vertical
     violence; the cover flight stays as the signature. */
  :global(html[data-motion='recede'][data-reading]) .track {
    translate: 0 0;
    scale: 1;
    transition: opacity 300ms ease;
    transition-delay: 0ms;
  }
  :global(html[data-motion='recede'][data-reading]) .tracklist,
  :global(html[data-motion='recede'][data-reading]) .album-copy {
    filter: blur(var(--sw-recede-blur, 3.5px));
    scale: var(--sw-recede-scale, 0.955);
    opacity: 0;
    transition:
      filter 380ms ease,
      scale 420ms cubic-bezier(0.4, 0, 0.3, 1),
      opacity 360ms ease,
      max-height var(--sw-shelf-dur, 330ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-shelf-delay, 170ms),
      margin-bottom var(--sw-shelf-dur, 330ms) cubic-bezier(0.5, 0, 0.3, 1) var(--sw-shelf-delay, 170ms);
  }
  :global(html[data-motion='recede']) .tracklist,
  :global(html[data-motion='recede']) .album-copy {
    transform-origin: 50% 20%;
    transition: filter 320ms ease 160ms, scale 360ms ease 160ms, opacity 320ms ease 160ms,
      max-height 400ms cubic-bezier(0.5, 0, 0.3, 1) 120ms,
      margin-bottom 400ms cubic-bezier(0.5, 0, 0.3, 1) 120ms;
  }
  /* Chapter jumps land with air above the heading */
  .prose :global(h2) { scroll-margin-top: 2.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .album-header,
    .album-cover,
    .album-copy,
    .tracklist,
    .track,
    .read-hint,
    .prose,
    :global(html[data-reading]) :global(.chapter-player) {
      transition: none;
      transition-delay: 0ms;
    }
    .read-hint svg { animation: none; }
  }

  @media (max-width: 768px) {
    .album-header {
      flex-direction: column;
      align-items: flex-start;
      max-height: 640px; /* stacked layout runs taller at rest */
    }
    .album-cover { width: 100%; height: auto; aspect-ratio: 8 / 5; }
    :global(html[data-reading]) .album-cover { translate: 0 40vh; }
    .track-title { width: auto; flex: 1; }
    .track-note { display: none; } /* the note column needs the desktop lane */
  }
</style>

<script>
  // The switch — one absolute point, no scrubbed in-between. Crossing a
  // small scroll threshold grants html[data-reading]: the album plays its
  // exit (rows pour into the player, cover flies to the thumbnail), the
  // article rises. Scrolling back to the very top reverses it. Hysteresis
  // keeps the boundary from chattering.
  function wireAlbumRead() {
    const header = document.querySelector('.album-header') as HTMLElement | null;
    if (!header || header.dataset.readWired) return;
    header.dataset.readWired = '1';

    const root = document.documentElement;
    root.removeAttribute('data-reading'); // a soft-nav may have leaked it (see below)
    root.setAttribute('data-album-fold', ''); // player waits for data-visible
    const player = document.querySelector('[data-chapter-player]');
    const cover = document.querySelector('.album-cover');
    const thumb = player?.querySelector('.cp-thumb');

    /* ── SWITCH TUNING ────────────────────────────────────────────────
       Experiment via URL, no rebuild needed:
         ?enter=140        the absolute point (px scrolled)
         ?land=44          where the switch deposits the reader
         ?motion=recede    alternative choreography (see CSS above)
       In dev, AlbumSwitchDirector's dials write window.__albumSwitch and
       win over these; URL params seed the defaults so links still work. */
    const q = new URLSearchParams(location.search);
    const num = (key: string, fallback: number) => {
      const v = Number(q.get(key));
      return Number.isFinite(v) && v > 0 ? v : fallback;
    };
    const seed = { enter: num('enter', 80), land: num('land', 42), settle: num('settle', 500) };
    const cfg = () => {
      const t = (window as any).__albumSwitch ?? {};
      const enter = t.enter ?? seed.enter; // the absolute point
      const exit = Math.min(20, enter - 10); // a true return-to-top reopens
      /* land only needs to clear exit (or landing would instantly reopen
         the album) — above enter is fine, reading persists until y < exit */
      const land = Math.max(exit + 10, t.land ?? seed.land);
      const settle = t.settle ?? seed.settle; // ms the pin holds against inertia
      return { enter, exit, land, settle };
    };
    if (q.get('motion')) root.setAttribute('data-motion', q.get('motion')!);
    let reading = false;

    /* The cover flies to the player thumbnail's real seat — measured
       center-to-center at switch time, so the merge lands on every
       viewport instead of at a guessed offset. */
    function aimCoverFlight() {
      if (!cover || !thumb) return;
      const c = cover.getBoundingClientRect();
      const t = thumb.getBoundingClientRect();
      if (!c.height || !t.height) return;
      root.style.setProperty('--fly-x', `${t.left + t.width / 2 - (c.left + c.width / 2)}px`);
      root.style.setProperty('--fly-y', `${t.top + t.height / 2 - (c.top + c.height / 2)}px`);
    }

    function set(r: boolean) {
      if (reading === r) return;
      reading = r;
      if (r) aimCoverFlight();
      root.toggleAttribute('data-reading', r);
      if (player) {
        if (r) player.setAttribute('data-visible', '');
        else player.removeAttribute('data-visible');
      }
    }
    let settleTimer: ReturnType<typeof setTimeout> | undefined;
    function update() {
      const y = window.scrollY;
      const { enter, exit, land, settle } = cfg();
      if (!reading && y > enter) {
        const fromAlbum = y < 300; // a real switch, not a deep-link landing
        set(true);
        if (fromAlbum) {
          /* The collapse removes ~700px above the article — pin the reader
             to a predictable first line instead of momentum roulette. */
          const lenis = (window as any).lenis;
          if (lenis?.scrollTo) {
            lenis.scrollTo(land, { immediate: true });
            /* A hard flick's trackpad inertia keeps feeding Lenis after the
               pin, carrying the reader past the article's first line — hold
               the wheel dead until the tail passes, so every entry starts
               the case study from the top. */
            if (settle > 0) {
              lenis.stop();
              clearTimeout(settleTimer);
              settleTimer = setTimeout(() => lenis.start(), settle);
            }
          } else window.scrollTo(0, land);
        }
      } else if (reading && y < exit) set(false);
    }
    update(); // deep links land mid-article → reading immediately
    /* Dials replay the switch in place, no scrolling — note a forced enter
       at the top undoes itself on the next scroll (y < exit), by design. */
    const onForce = (e: Event) => set(!!(e as CustomEvent).detail);
    /* Soft navigations re-wire per page — unhook the last page's listeners
       so stale closures (over swapped-out covers/players) stop stacking. */
    const w = window as any;
    w.__albumSwitchUnwire?.();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('album-switch:force', onForce);
    w.__albumSwitchUnwire = () => {
      window.removeEventListener('scroll', update);
      window.removeEventListener('album-switch:force', onForce);
    };
  }
  wireAlbumRead();
  document.addEventListener('astro:page-load', wireAlbumRead);
  /* ClientRouter swaps the body but keeps <html> — without this, finishing
     one case study leaves data-reading on the root and every next one opens
     pre-collapsed, article already up, the switch never seen. Clearing
     before the swap means the incoming album renders at rest from its very
     first frame; update() above re-grants reading for true deep links. */
  document.addEventListener('astro:before-swap', () =>
    document.documentElement.removeAttribute('data-reading')
  );
</script>
