---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ReadingBar from '../../components/ReadingBar.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects'))
    .filter((p) => !p.data.draft && !p.data.external)
    .sort((a, b) => b.data.year - a.data.year);

  return projects.map((project, i) => {
    const prev = projects[i + 1] ?? null; // older
    const next = projects[i - 1] ?? null; // newer
    return {
      params: { slug: project.id },
      props: {
        project,
        prev: prev ? { id: prev.id, title: prev.data.title } : null,
        next: next ? { id: next.id, title: next.data.title } : null,
      },
    };
  });
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);

// The album page: case study as record. Sections come from h2s; read time from body.
const sections = headings.filter((h) => h.depth === 2);
const words = (project.body ?? '').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 200));
---

<Base
  title={`${project.data.title} — Shellie Hu`}
  description={project.data.summary}
  deck="none"
>
  <a href="/projects" class="crumb">← work</a>

  <header class="album-header">
    <div class="album-cover">
      {project.data.cover && (
        <Image
          src={project.data.cover}
          alt={`${project.data.title} — cover`}
          widths={[400, 800]}
          sizes="200px"
        />
      )}
    </div>
    <div class="album-copy">
      <span class="album-eyebrow">case study</span>
      <h1 class="album-title">{project.data.title}</h1>
      <p class="album-summary">{project.data.summary}</p>
      <span class="album-meta">
        {project.data.year}
        {project.data.role && ` · ${project.data.role}`}
        {project.data.company && ` · ${project.data.company}`}
        {sections.length > 0 && ` · ${sections.length} sections, ${readMinutes} min`}
      </span>
      <div class="album-actions">
        <a href="#read" class="album-read">▶ read</a>
        {next && <a href={`/projects/${next.id}`} class="album-next">next project →</a>}
      </div>
    </div>
  </header>

  {sections.length > 0 && (
    <nav class="tracklist" aria-label="Sections">
      {sections.map((h, i) => (
        <a href={`#${h.slug}`} class="track">
          <span class="track-n">{i + 1}</span>
          <span class="track-title">{h.text.toLowerCase()}</span>
        </a>
      ))}
    </nav>
  )}

  <article class="prose" id="read">
    <Content />
    <footer class="mt-10 pt-8 border-t border-[var(--color-rule)]">
      <a href="/projects" class="text-sm no-underline hover:text-[var(--color-accent)]">
        ← back to work
      </a>
    </footer>
  </article>

  <ReadingBar
    title={project.data.title}
    prevHref={prev ? `/projects/${prev.id}` : null}
    prevLabel={prev?.title}
    nextHref={next ? `/projects/${next.id}` : null}
    nextLabel={next?.title}
  />
</Base>

<style>
  .crumb {
    font-weight: 300;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .crumb:hover { color: var(--color-accent); }

  .album-header {
    display: flex;
    align-items: flex-end;
    gap: 1.75rem;
    padding: 1.5rem 0 1.75rem 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 1.5rem;
  }
  .album-cover {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    background: var(--color-rule);
    border-radius: 16px;
    overflow: hidden;
  }
  .album-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .album-copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-bottom: 0.25rem;
    min-width: 0;
  }
  .album-eyebrow {
    font-weight: 300;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
  }
  .album-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .album-summary {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.55;
    max-width: 32.5rem;
  }
  .album-meta {
    font-family: var(--font-serif);
    font-style: italic;
    font-stretch: 87.5%;
    font-size: var(--text-base);
    color: var(--color-ink-faint);
  }
  .album-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 0.375rem;
  }
  .album-read {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 1.25rem;
    background: var(--color-ink);
    color: var(--color-bg);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .album-read:hover { color: var(--color-bg); background: var(--color-accent); }
  .album-next {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .album-next:hover { color: var(--color-accent); }

  .tracklist {
    display: flex;
    flex-direction: column;
    max-width: var(--measure);
    margin-bottom: 2.5rem;
  }
  .track {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
  }
  .track:last-child { border-bottom: none; }
  .track-n {
    width: 1.5rem;
    flex-shrink: 0;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .track-title {
    font-size: var(--text-base);
    color: var(--color-ink);
    transition: color var(--motion-micro) ease;
  }
  .track:hover .track-title { color: var(--color-accent); }

  .prose { padding-bottom: 3.5rem; /* clears the reading bar */ }

  @media (max-width: 768px) {
    .album-header { flex-direction: column; align-items: flex-start; }
    .album-cover { width: 100%; height: auto; aspect-ratio: 8 / 5; }
  }
</style>
