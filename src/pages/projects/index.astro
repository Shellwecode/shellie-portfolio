---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

// Work index: hero project as the emphasis card, everything else in the grid.
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.year - a.data.year);

const heroProject = projects.find((p) => p.data.hero) ?? projects[0] ?? null;
const rest = projects.filter((p) => p !== heroProject);
const row1 = rest.slice(0, 1); // shares the top row with the emphasis card
const row2 = rest.slice(1);

const href = (p: (typeof projects)[number]) => p.data.external ?? `/projects/${p.id}`;
const shortTitle = (title: string) => title.split('—')[0].trim();
const tag = (p: (typeof projects)[number]) =>
  p.data.tags.find((t) => t !== 'work') ?? p.data.year;
---

<Base
  title="Work — Shellie Hu"
  description="Case studies and professional work by Shellie Hu."
>
  <div class="page-head">
    <h1 class="page-title">work</h1>
    <p class="page-sub">
      client and professional work — things i've built on my own live in the
      <a href="/workshop">workshop</a>.
    </p>
  </div>

  <div class="cards-row">
    {heroProject && (
      <a href={href(heroProject)} class="card card-emphasis">
        <div class="card-cover" style={heroProject.data.coverZoom ? `--cover-zoom: ${heroProject.data.coverZoom}` : undefined}>
          {heroProject.data.cover && (
            <Image
              src={heroProject.data.cover}
              alt={`${heroProject.data.title} cover`}
              widths={[600, 1200]}
              sizes="(max-width: 768px) 100vw, 640px"
            />
          )}
          {heroProject.data.coverVideo && (
            <video class="card-video" src={heroProject.data.coverVideo} muted loop playsinline preload="metadata" aria-hidden="true"></video>
          )}
          <span class="card-veil" aria-hidden="true"></span>
          <span class="card-overlay">
            <span class="card-tag">{tag(heroProject)}</span>
            <span class="card-ov-title">{shortTitle(heroProject.data.title)}</span>
            <span class="card-ov-sub">{heroProject.data.tagline ?? heroProject.data.summary}</span>
          </span>
          <span class="card-go" aria-hidden="true">↗</span>
        </div>
      </a>
    )}
    {row1.map((p) => (
      <a href={href(p)} class="card">
        <div class="card-cover" style={p.data.coverZoom ? `--cover-zoom: ${p.data.coverZoom}` : undefined}>
          {p.data.cover && (
            <Image
              src={p.data.cover}
              alt={`${p.data.title} cover`}
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 320px"
            />
          )}
          {p.data.coverVideo && (
            <video class="card-video" src={p.data.coverVideo} muted loop playsinline preload="metadata" aria-hidden="true"></video>
          )}
          <span class="card-veil" aria-hidden="true"></span>
          <span class="card-overlay">
            <span class="card-tag">{tag(p)}</span>
            <span class="card-ov-title">{shortTitle(p.data.title)}</span>
            <span class="card-ov-sub">{p.data.tagline ?? p.data.summary}</span>
          </span>
          <span class="card-go" aria-hidden="true">↗</span>
        </div>
      </a>
    ))}
  </div>

  {row2.length > 0 && (
    <div class="cards-row cards-row-secondary">
      {row2.map((p) => (
        <a href={href(p)} class="card">
          <div class="card-cover card-cover-short" style={p.data.coverZoom ? `--cover-zoom: ${p.data.coverZoom}` : undefined}>
            {p.data.cover && (
              <Image
                src={p.data.cover}
                alt={`${p.data.title} cover`}
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 320px"
              />
            )}
            {p.data.coverVideo && (
              <video class="card-video" src={p.data.coverVideo} muted loop playsinline preload="metadata" aria-hidden="true"></video>
            )}
            <span class="card-veil" aria-hidden="true"></span>
            <span class="card-overlay">
              <span class="card-tag">{tag(p)}</span>
              <span class="card-ov-title">{shortTitle(p.data.title)}</span>
              <span class="card-ov-sub">{p.data.tagline ?? p.data.summary}</span>
            </span>
            <span class="card-go" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  )}
</Base>

<style>
  .page-head { margin-bottom: 1.5rem; }
  .page-title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .page-sub {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.55;
    max-width: var(--measure);
  }

  .cards-row { display: flex; gap: 1.25rem; margin-bottom: 1.5rem; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    text-decoration: none;
  }
  .card-emphasis { flex: 2; }
  .card-cover {
    position: relative;
    width: 100%;
    height: 240px;
    background: var(--color-rule);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: box-shadow 200ms ease;
  }
  .card:hover .card-cover,
  .card:focus-visible .card-cover { box-shadow: var(--shadow-card-hover); }
  .card-cover-short { height: 170px; }
  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--cover-zoom, 1));
    transition: transform var(--motion-content) ease-out;
  }
  .card:hover .card-cover :global(img) { transform: scale(calc(var(--cover-zoom, 1) * 1.02)); }
  /* overlay reveal (veil, tag, title, sub, ↗ chip) is shared — global.css */

  @media (max-width: 768px) {
    .cards-row { flex-direction: column; }
    .card-emphasis { flex: 1; }
  }
</style>
