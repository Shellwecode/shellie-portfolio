---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArchiveRow from '../components/ArchiveRow.astro';
import MeStrip from '../components/MeStrip.astro';

// Home: greeting + intro (the greeting owns the name; the intro never repeats it),
// selected work with the current project as the emphasis card, recent writing rows.
const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);
const heroProject = allProjects.find((p) => p.data.hero) ?? allProjects[0] ?? null;
const otherProjects = allProjects
  .filter((p) => p !== heroProject)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 1);

// Card titles are the short form, Title Case per DS v0.3:
// "Cortex — Voice AI Agent Builder" → "Cortex".
const shortTitle = (title: string) => title.split('—')[0].trim();

const writing = (await getCollection('writing'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const projectHref = (p: (typeof allProjects)[number]) =>
  p.data.external ?? `/projects/${p.id}`;
---

<Base
  title="Shellie Hu — Product Designer"
  description="Product designer in Boston working on AI agent experiences. Designing Cortex, a voice AI agent builder."
>
  {/* Hero — greeting + intro. No illustration, no hairline, per the Landing frame. */}
  <section class="hero">
    <div class="hero-copy">
      <h1 class="greeting">Hello, I'm Shellie.</h1>
      <p class="intro">
        a product designer working on AI agent experiences — currently
        designing <a href="/projects/cortex">Cortex</a>, a voice AI agent builder
        platform.
      </p>
      <p class="intro intro-muted">
        i also <a href="/workshop">build things</a>, <a href="/writing">write</a>,
        and <a href="/doodles">draw</a>.
      </p>
    </div>
  </section>

  {/* Selected work — one card anatomy; the current project is the emphasis variant. */}
  <section class="work">
    <div class="section-head">
      <h2 class="section-title">Selected work</h2>
      <a href="/projects" class="section-link">show all →</a>
    </div>
    <div class="cards">
      {heroProject && (
        <a href={projectHref(heroProject)} class="card">
          <div class="card-cover">
            {heroProject.data.cover && (
              <Image
                src={heroProject.data.cover}
                alt={`${heroProject.data.title} cover`}
                widths={[420, 840]}
                sizes="(max-width: 768px) 100vw, 410px"
              />
            )}
          </div>
          <span class="card-text">
            <span class="card-title">{shortTitle(heroProject.data.title)}</span>
            <span class="card-sub">{heroProject.data.tagline ?? heroProject.data.summary}</span>
          </span>
        </a>
      )}
      {otherProjects.map((p) => (
        <a href={projectHref(p)} class="card">
          <div class="card-cover">
            {p.data.cover && (
              <Image
                src={p.data.cover}
                alt={`${p.data.title} cover`}
                widths={[420, 840]}
                sizes="(max-width: 768px) 100vw, 410px"
              />
            )}
          </div>
          <span class="card-text">
            <span class="card-title">{shortTitle(p.data.title)}</span>
            <span class="card-sub">{p.data.tagline ?? p.data.summary}</span>
          </span>
        </a>
      ))}
      <a href="/workshop" class="card">
        <div class="card-cover"></div>
        <span class="card-text">
          <span class="card-title">Workshop</span>
          <span class="card-sub">Vibe code experiments, ongoing</span>
        </span>
      </a>
    </div>
  </section>

  {/* Foot row — writing and (me) as sibling columns, per mock/home-1. */}
  <div class="foot">
    {writing.length > 0 && (
      <section class="writing">
        <h2 class="section-title">Writing</h2>
        <div>
          {writing.map((w) => (
            <ArchiveRow
              plain
              title={w.data.title}
              href={`/writing/${w.id}`}
              date={w.data.date}
              external={false}
            />
          ))}
        </div>
      </section>
    )}
    <MeStrip />
  </div>
</Base>

<style>
  .hero {
    display: flex;
    margin-bottom: 1.75rem;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--hero-gap);
    padding-bottom: var(--hero-pad-b);
    flex: 1;
  }
  .greeting {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 22px;
  }
  .intro {
    font-size: var(--text-lg);
    line-height: 1.45;
    max-width: var(--intro-measure);
    color: var(--color-ink-muted);
  }
  .intro-muted { color: var(--color-ink-muted); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 22px;
  }
  .section-link {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .section-link:hover { color: var(--color-accent); }

  .work { margin-bottom: 1.75rem; }
  .cards {
    display: flex;
    gap: var(--card-gap);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    min-width: 0;
    text-decoration: none;
  }
  .card-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .card-cover {
    position: relative;
    width: 100%;
    height: var(--card-cover-h); /* one height across the row — widths differ, height never */
    background: var(--color-rule);
    border-radius: 16px;
    overflow: hidden;
  }
  /* hairline image outline — sits above the image, keeps cover edges crisp */
  .card-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px oklch(0 0 0 / 0.08);
    pointer-events: none;
  }
  :global(html[data-theme='dark']) .card-cover::after {
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.08);
  }
  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-content) ease-out;
  }
  .card:hover .card-cover :global(img) { transform: scale(1.02); }
  .card-title {
    font-size: 1rem;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-ink);
    transition: color var(--motion-micro) ease;
  }
  .card:hover .card-title { color: var(--color-accent); }
  .card-sub {
    font-weight: 300;
    font-size: 0.75rem;
    line-height: 16px;
    color: var(--color-ink-muted);
  }

  .foot {
    display: flex;
    align-items: flex-start;
    gap: 3rem;
  }
  .foot > .writing { flex: 0 1 600px; min-width: 0; }
  /* The strip's content (the dish) wins the shrink fight — writing gives way */
  .foot > :global(.me) { flex: 0 1 624px; min-width: 560px; }
  .writing .section-title { margin-bottom: 0.875rem; } /* header→first row rhythm matches (me) */

  @media (max-width: 768px) {
    .cards { flex-direction: column; }
    .foot { flex-direction: column; gap: 2.5rem; }
    .foot > .writing,
    .foot > :global(.me) { flex: none; width: 100%; }
  }
</style>
