---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArchiveRow from '../components/ArchiveRow.astro';
import HeroGreeting from '../components/HeroGreeting.astro';
import Opening from '../components/Opening.astro';
import OpeningInk from '../components/OpeningInk.astro';
import OpeningFill from '../components/OpeningFill.astro';

// Front-door variant: 'galaxy' (stippled SVG morph), 'ink' (generative
// gold-ink print / falling comet, Opening B), 'fill' (idea 4 — the girl
// as loading bar, color pours in as texture), or 'none' (no opening).
// Galaxy/ink parked 2026-08-04; fill is the active exploration (2026-08-18).
const OPENING_VARIANT: 'galaxy' | 'ink' | 'fill' | 'none' = 'fill';

// Home: greeting + intro (the greeting owns the name; the intro never repeats it),
// selected work with the current project as the emphasis card, recent writing rows.
const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);
const heroProject = allProjects.find((p) => p.data.hero) ?? allProjects[0] ?? null;
// Second and third cards are hand-picked so new entries don't reshuffle the
// locked bento: the sci-fi research brings the self-directed side, the early MIT
// project balances the two 2026 ones.
const secondProject = allProjects.find((p) => p.id === 'feminist-scifi') ?? null;
const thirdProject = allProjects.find((p) => p.id === 'saving-face') ?? null;
// The bento's three: the agent builder anchors, the other two stack right.
const featured = [heroProject, secondProject, thirdProject].filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

// Card titles are the short form, Title Case per DS v0.3:
// "Voice AI Agents — Enterprise Agent Builder" → "Voice AI Agents".
const shortTitle = (title: string) => title.split('—')[0].trim();

const writing = (await getCollection('writing'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const projectHref = (p: (typeof allProjects)[number]) =>
  p.data.external ?? `/projects/${p.id}`;
---

<Base
  description="Product designer in Boston working on AI agent experiences. Designing Five9 Voice AI Agents."
  opening={OPENING_VARIANT !== 'none'}
>
  {/* Front door — blooms in, then hands off to the entrance rise. */}
  {OPENING_VARIANT === 'galaxy' && <Opening />}
  {OPENING_VARIANT === 'ink' && <OpeningInk />}
  {OPENING_VARIANT === 'fill' && <OpeningFill />}

  {/* Hero — greeting + intro. No illustration, no hairline, per the Landing frame. */}
  <section class="hero">
    <div class="hero-copy">
      <div class="enter" style="--enter-i: 0"><HeroGreeting /></div>
      <p class="intro intro-lead enter" style="--enter-i: 1">
        I design software that talks, to us and to each other.
      </p>
      <p class="intro enter" style="--enter-i: 2">
        I'm building Five9's first <a href="/projects/voice-ai-agents">voice AI agent builder</a>;
        before that, I researched human-computer interaction and made creative tools.
      </p>
      <p class="intro intro-muted enter" style="--enter-i: 3">
        Constantly inspired by sci-fi, mathematics, and curiosity about how
        things work.
      </p>
    </div>
  </section>

  {/* Selected work — bento, Shellie's dial-tuned composition (aug 2):
      The builder anchors 64%, twin 282px cells stack right. Cards are pure image
      at rest; hover reveals tag, title, subtitle (shared styles, global.css) */}
  <section class="work">
    <div class="section-head enter" style="--enter-i: 3">
      <h2 class="section-title">Selected work</h2>
      {/* The arrow is riso ink like the menu: grey at rest, catching the
          rust on hover — the icons' language echoed once more on the page. */}
      <a href="/projects" class="section-link">show all
        <span class="section-link-arrow">
          <svg width="15" height="10" viewBox="0 0 15 10" aria-hidden="true">
            <path d="M1.2 5.4 C 4.2 4.7, 7.6 4.9, 10.4 5.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none" />
            <path fill="currentColor" d="M9.6 1.5 C 11 2.9, 12.5 4.1, 14 4.9 C 12.5 5.9, 11 7.1, 9.7 8.5 C 9.3 8.2, 9.4 7.9, 9.6 7.5 C 10.1 6.7, 10.6 5.8, 10.7 5 C 10.6 4.2, 10 3.4, 9.4 2.5 C 9.2 2.2, 9.3 1.8, 9.6 1.5 Z" />
          </svg>
        </span>
      </a>
    </div>
    <div class="cards">
      {featured.map((p, i) => (
        <a href={projectHref(p)} class="card enter" data-i={i} style={`--enter-i: ${4 + i}`}>
          <div class="card-cover" style={p.data.coverZoom ? `--cover-zoom: ${p.data.coverZoom}` : undefined}>
            {p.data.cover && (
              <Image
                src={p.data.cover}
                alt={`${p.data.title} cover`}
                widths={[420, 840, 1320]}
                sizes="(max-width: 768px) 100vw, 660px"
              />
            )}
            {p.data.coverVideo && (
              <video class="card-video" src={p.data.coverVideo} muted loop playsinline preload="metadata" aria-hidden="true"></video>
            )}
            <span class="card-veil" aria-hidden="true"></span>
            <span class="card-overlay">
              <span class="card-tag">{p.data.tags.find((t) => t !== 'work') ?? p.data.year}</span>
              <span class="card-ov-title">{shortTitle(p.data.title)}</span>
              <span class="card-ov-sub">{p.data.tagline ?? p.data.summary}</span>
            </span>
            <span class="card-go" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Writing — single column per the Landing frame; (me) strip parked for now. */}
  {writing.length > 0 && (
    <section class="writing">
      <h2 class="section-title enter" style="--enter-i: 7">Writing</h2>
      <div class="writing-list">
        {writing.map((w, i) => (
          <div class="enter" style={`--enter-i: ${8 + i}`}>
            <ArchiveRow
              plain
              title={w.data.title}
              href={w.data.external ?? `/writing/${w.id}`}
              date={w.data.dateLabel ?? w.data.date}
              external={Boolean(w.data.external)}
            />
          </div>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    display: flex;
    margin-bottom: 1.75rem;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--hero-gap);
    padding-bottom: var(--hero-pad-b);
    flex: 1;
  }
  .intro {
    font-size: var(--text-lg);
    line-height: 1.45;
    max-width: var(--intro-measure);
    color: var(--color-ink-muted);
    text-wrap: balance; /* even rag on the few hero lines; p keeps pretty elsewhere */
  }
  .intro-lead { color: var(--color-ink); } /* the claim carries full ink; the rest stays quiet */
  .intro-muted { color: var(--color-ink-muted); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 22px;
  }
  .section-link {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--motion-micro) ease;
  }
  /* hover catches the same rust as the icon menu — one ink system */
  .section-link:hover { color: #D36B41; }
  .section-link-arrow {
    display: inline-block;
    vertical-align: -1px;
    transition: translate var(--motion-micro) ease-out;
  }
  .section-link-arrow svg { display: inline; }
  .section-link:hover .section-link-arrow { translate: var(--arrow-nudge, 3px) 0; }

  .work { margin-bottom: 2.625rem; } /* 14 section pad + 28 main gap, per frame */
  /* Bento — Shellie's dial-tuned composition (locked 2026-08-02, anchor
     widened 2026-08-20): 70% agent-builder anchor, twin 282px cells
     stacked right */
  .cards {
    display: grid;
    gap: var(--card-gap);
    grid-template-columns: calc(70% - var(--card-gap) / 2) 1fr;
    grid-template-areas: 'a b' 'a c';
  }
  .card[data-i='0'] { grid-area: a; }
  .card[data-i='2'] { grid-area: b; }
  .card[data-i='1'] { grid-area: c; }
  .card[data-i='0'] .card-cover { height: auto; flex: 1; }
  .card[data-i='2'] .card-cover { height: 282px; }
  .card[data-i='1'] .card-cover { height: 282px; }
  .card {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    text-decoration: none;
  }
  .card-cover {
    position: relative;
    width: 100%;
    height: var(--card-cover-h); /* one height across the row — widths differ, height never */
    background: var(--color-rule);
    border-radius: 16px;
    overflow: hidden;
    /* layered elevation replaces the hairline outline — ring + two soft layers */
    box-shadow: var(--shadow-card);
    transition: box-shadow 200ms ease;
  }
  .card:hover .card-cover,
  .card:focus-visible .card-cover { box-shadow: var(--shadow-card-hover); }
  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--cover-zoom, 1));
    transition: transform var(--hover-card-ms, var(--motion-content)) ease-out;
  }
  .card:hover .card-cover :global(img) { transform: scale(calc(var(--cover-zoom, 1) * var(--hover-card-scale, 1.02))); }
  /* overlay reveal (veil, tag, title, sub, ↗ chip) is shared — global.css */

  .writing { max-width: var(--measure); } /* 768 — the frame's writing column */
  .writing .section-title { margin-bottom: 0.875rem; }
  .writing-list {
    display: flex;
    flex-direction: column;
    gap: 6px; /* row rhythm per frame: 10 pad + 6 gap + 10 pad */
  }
  .writing-list :global(.archive-row--plain) { padding-block: 10px; }

  @media (max-width: 768px) {
    .cards { display: flex; flex-direction: column; }
    .card[data-i='0'] .card-cover { height: 240px; flex: none; }
  }
</style>
