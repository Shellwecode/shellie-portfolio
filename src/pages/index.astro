---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArchiveRow from '../components/ArchiveRow.astro';

// Home: greeting + intro (the greeting owns the name; the intro never repeats it),
// selected work with the current project as the emphasis card, recent writing rows.
const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);
const heroProject = allProjects.find((p) => p.data.hero) ?? allProjects[0] ?? null;
const otherProjects = allProjects
  .filter((p) => p !== heroProject)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2);

const writing = (await getCollection('writing'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const projectHref = (p: (typeof allProjects)[number]) =>
  p.data.external ?? `/projects/${p.id}`;
---

<Base
  title="Shellie Hu — Product Designer"
  description="Product designer in Boston working on AI agent experiences. Designing Cortex, a voice AI agent builder."
>
  {/* Hero — greeting + intro, grounded by a hairline. Illustration drops into .hero-illo. */}
  <section class="hero">
    <div class="hero-copy">
      <h1 class="greeting">hello, i'm shellie.</h1>
      <p class="intro">
        a product designer in Boston working on AI agent experiences — currently
        designing <a href="/projects/cortex">Cortex</a>, a voice AI agent builder
        platform.
      </p>
      <p class="intro intro-muted">
        i also <a href="/workshop">build things</a>, <a href="/writing">write</a>,
        and <a href="/doodles">draw</a>.
      </p>
    </div>
    <div class="hero-illo" aria-hidden="true">
      <img src="/illo-suitcase.png" alt="" width="160" height="293" loading="eager" />
    </div>
  </section>

  {/* Selected work — one card anatomy; the current project is the emphasis variant. */}
  <section class="work">
    <div class="section-head">
      <h2 class="section-title">selected work</h2>
      <a href="/projects" class="section-link">show all →</a>
    </div>
    <div class="cards">
      {heroProject && (
        <a href={projectHref(heroProject)} class="card card-emphasis">
          <div class="card-cover">
            {heroProject.data.cover && (
              <Image
                src={heroProject.data.cover}
                alt={`${heroProject.data.title} cover`}
                widths={[600, 1200]}
                sizes="(max-width: 768px) 100vw, 640px"
              />
            )}
          </div>
          <span class="card-title">{heroProject.data.title.toLowerCase()}</span>
          <span class="card-meta">case study · {heroProject.data.year} · current</span>
        </a>
      )}
      {otherProjects.map((p) => (
        <a href={projectHref(p)} class="card">
          <div class="card-cover">
            {p.data.cover && (
              <Image
                src={p.data.cover}
                alt={`${p.data.title} cover`}
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 320px"
              />
            )}
          </div>
          <span class="card-title">{p.data.title.toLowerCase()}</span>
          <span class="card-meta">case study · {p.data.year}</span>
        </a>
      ))}
    </div>
  </section>

  {/* Writing — section header per addendum; rows are the existing archive pattern. */}
  {writing.length > 0 && (
    <section class="writing" style="max-width: var(--measure);">
      <h2 class="section-title">writing</h2>
      <div>
        {writing.map((w) => (
          <ArchiveRow
            kind="essay"
            title={w.data.title}
            href={`/writing/${w.id}`}
            date={w.data.date}
            external={false}
          />
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    display: flex;
    align-items: flex-end;
    gap: 2rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 2rem;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-bottom: 1.75rem;
    flex: 1;
  }
  .greeting {
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .intro {
    font-size: var(--text-lg);
    line-height: 1.55;
    max-width: 34rem;
  }
  .intro-muted { color: var(--color-ink-muted); }
  .hero-illo {
    width: 160px;
    flex-shrink: 0;
    align-self: flex-end;
    margin-bottom: -6px; /* feet on the hairline, per mock */
    margin-right: 8rem;
  }
  .hero-illo img { width: 160px; height: auto; display: block; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }
  .section-title {
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .section-link {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .section-link:hover { color: var(--color-accent); }

  .work { margin-bottom: 2.5rem; }
  .cards {
    display: flex;
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    text-decoration: none;
  }
  .card-emphasis { flex: 2; }
  .card-cover {
    width: 100%;
    height: 210px; /* one cover height across the row — widths differ, height never */
    background: var(--color-rule);
    border-radius: 16px;
    overflow: hidden;
  }
  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-content) ease-out;
  }
  .card:hover .card-cover :global(img) { transform: scale(1.02); }
  .card-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color var(--motion-micro) ease;
  }
  .card:hover .card-title { color: var(--color-accent); }
  .card-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .writing .section-title { margin-bottom: 0.5rem; }

  @media (max-width: 768px) {
    .hero-illo { display: none; }
    .cards { flex-direction: column; }
    .card-emphasis { flex: 1; }
  }
</style>
