---
import { Image } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import Base from '../layouts/Base.astro';
import PhotoPile from '../components/PhotoPile.astro';
import doodleSuitcase from '../assets/about/cutouts/shellie-with-suitcase.png';
import doodleWalking from '../assets/about/cutouts/shellie-walking.png';
import doodleReading from '../assets/about/cutouts/shellie-reading-lamp.png';

const education = [
  { school: 'Wellesley College (B.A.)', href: 'https://www.wellesley.edu/', program: 'Mathematics & HCI', dates: '2020–2024' },
  { school: 'Massachusetts Institute of Technology', program: 'Cross-registered, Media Arts and Sciences', dates: '2021–2023' },
  { school: 'RISD Precollege', program: 'Graphic Design', dates: '2018' },
];

const experience = [
  { org: 'Five9', href: 'https://www.five9.com/', role: 'Product Designer', dates: 'Jul 2025–Present' },
  { org: 'Ikigai Labs', href: 'https://ikigailabs.io/', role: 'UX Designer', dates: 'Feb–Jul 2025' },
  { org: 'UberJets / Virtual Hangar', href: 'https://virtualhangar.com/', role: 'Lead UX/UI Designer', dates: 'Aug–Dec 2024' },
  { org: 'Neural Image AI', role: 'Product Engineering Intern', dates: 'May–Nov 2023' },
  { org: 'MIT Media Lab', href: 'https://www.media.mit.edu/', role: 'Designer, Researcher', dates: 'Jan 2021–Dec 2022' },
  { org: 'MIT CSAIL', href: 'https://www.csail.mit.edu/', role: 'HCI Student Researcher', dates: 'May–Sept 2022' },
];

// Vector set: Lucide (ISC) — mail, linkedin, instagram; the X mark is a
// stroke adaptation of the x.com logo so it sits with the Lucide set.
// Resume stays a worded link — it's the row's highest-intent action and
// has no universal glyph; the socials are recognizable as marks alone.
const resumeHref = '/Shellie_Hu_resume_2026.pdf';
const contacts = [
  {
    label: 'Email',
    href: 'mailto:shelliehxx@outlook.com',
    glyph:
      '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/shelliehu/',
    glyph:
      '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/shellwedraw/',
    glyph:
      '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  },
  {
    label: 'X',
    href: 'https://x.com/shellwetwit1',
    glyph:
      '<path d="M4 4l11.733 16H20L8.267 4z"/><path d="M4 20l6.768-6.768"/><path d="M12.58 12.58 20 4"/>',
  },
];
---

<Base
  description="Product designer in Boston. Currently designing Five9's Voice AI Agents."
>
  {/* no single cap — text blocks keep the reading measure, the pile
      breaks out to its own wider stage (the page's one full breath) */}
  <div class="about-page">
    <div class="about-hero" data-drag-zone>
      {/* the tree in the menu already says where we are — no serif "About"
          repeating it. The h1 stays for the document outline, unseen. */}
      <h1 class="sr-title">About</h1>

      {/* the doodled selves escaped the pile — they keep the intro company
          (and still drag; the whole hero is their yard). Day gets the
          travelers; night gets the reading lamp. */}
      <figure class="hero-doodle hero-doodle--light enter" data-draggable style="--enter-i: 1; right: 4%; top: 10px; --rot: 4deg">
        <Image src={doodleSuitcase} alt="A drawing of me with my suitcase" widths={[320]} sizes="160px" loading="eager" draggable={false} />
      </figure>
      <figure class="hero-doodle hero-doodle--light enter" data-draggable style="--enter-i: 2; right: 24%; top: 64px; --rot: -5deg">
        <Image src={doodleWalking} alt="A drawing of me mid-stride, luggage in tow" widths={[320]} sizes="150px" loading="eager" draggable={false} />
      </figure>
      <figure class="hero-doodle hero-doodle--dark enter" data-draggable style="--enter-i: 1; right: 8%; top: 4px; --rot: -2deg">
        <Image src={doodleReading} alt="A drawing of me reading under a lamp at night" widths={[520]} sizes="260px" loading="eager" draggable={false} />
      </figure>

      <div class="about-copy">
      <p class="intro intro-lead enter" style="--enter-i: 0">
        I was born in Chengdu, China. Growing up with a love of doodling, I
        learned to understand things by drawing them. I spent my high school
        years in Auckland, New Zealand, where I learned to walk in the
        mountains, by the coastlines, on the trail of sunrise. Now, I live in
        Boston with my cat, designing at Five9.
      </p>
      <p class="intro enter" style="--enter-i: 1">
        I studied mathematics and human-computer interaction in college. I
        like sitting with abstract problems before they have a shape, and
        decomposing them by asking (sometimes wild) questions. I also like
        sitting with real people and asking them how their day is.
      </p>
      </div>
    </div>

    <div class="pile-stage enter" style="--enter-i: 2">
      <PhotoPile />
    </div>

    <section class="cv-section enter" style="--enter-i: 3">
      <h2 class="section-title">Experience</h2>
      <div class="cv-list mt-3">
        {experience.map((x) => (
          <div class="cv-row">
            <div class="cv-body">
              {x.href ? (
                <a class="cv-name" href={x.href} target="_blank" rel="noopener noreferrer">
                  {x.org}<span class="text-[var(--color-ink-faint)]"> <Arrow dir="out" size={11} /></span>
                </a>
              ) : (
                <span class="cv-name">{x.org}</span>
              )}
              <span class="cv-role">{x.role}</span>
            </div>
            <span class="cv-date">{x.dates}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="cv-section enter" style="--enter-i: 4">
      <h2 class="section-title">Education</h2>
      <div class="cv-list mt-3">
        {education.map((e) => (
          <div class="cv-row">
            <div class="cv-body">
              {e.href ? (
                <a class="cv-name" href={e.href} target="_blank" rel="noopener noreferrer">
                  {e.school}<span class="text-[var(--color-ink-faint)]"> <Arrow dir="out" size={11} /></span>
                </a>
              ) : (
                <span class="cv-name">{e.school}</span>
              )}
              <span class="cv-role">{e.program}</span>
            </div>
            <span class="cv-date">{e.dates}</span>
          </div>
        ))}
      </div>
    </section>

    <p class="contact-row enter mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" style="--enter-i: 5">
      <span class="contact-lead">find me</span>
      <a class="contact-resume" href={resumeHref} target="_blank" rel="noopener noreferrer">Resume <Arrow dir="out" size={12} /></a>
      {contacts.map((c) => (
        <a
          class="contact-link"
          href={c.href}
          target={c.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={c.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          aria-label={c.label}
          title={c.label}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={c.glyph}
          />
        </a>
      ))}
    </p>
  </div>
</Base>

<style>
  /* The landing page's DS: serif-italic section voice, the intro measure,
     whitespace instead of rules between sections. Longer paragraphs here
     get taller leading than the landing's three-liners. */
  .about-page {
    padding-bottom: 7.5rem; /* clears the dock's corner (no pill on this page) */
  }
  /* the hero is the doodles' yard — full page width so they can wander */
  .about-hero {
    position: relative;
  }
  .about-hero > .about-copy {
    max-width: var(--measure);
  }
  /* the page's h1, for the outline and screen readers only */
  .sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .hero-doodle {
    position: absolute;
    width: 160px;
    margin: 0;
    rotate: var(--rot, 0deg);
    cursor: grab;
    touch-action: none;
    user-select: none;
    will-change: translate;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.12));
  }
  .hero-doodle.dragging {
    cursor: grabbing;
    rotate: calc(var(--rot, 0deg) * 0.4);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.18));
    transition: rotate 200ms ease;
  }
  .hero-doodle :global(img) {
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .hero-doodle { display: none; } /* no yard to wander on narrow screens */
  }
  /* each theme keeps one company: the travelers by day, the reading lamp
     by night (its glow is the one warm thing on the dark page) */
  .hero-doodle--dark { display: none; }
  :global(:root[data-theme='dark']) .hero-doodle--light { display: none; }
  :global(:root[data-theme='dark']) .hero-doodle--dark {
    display: block;
    width: 260px; /* a seated scene, not a cutout stride — it earns more room */
    filter: none; /* no paper-light shadow in the dark */
  }
  .about-page > :not(.pile-stage, .about-hero) {
    max-width: var(--measure);
  }
  .pile-stage {
    max-width: min(1000px, 100%); /* the one wide element on the page */
  }
  .section-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 22px;
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: var(--hero-gap);
    padding-top: 1rem;
    padding-bottom: 2.625rem; /* the section beat, not the hero's tighter pad */
  }
  .intro {
    font-size: var(--text-lg);
    line-height: 1.65; /* fuller paragraphs than the landing's — more air per line */
    max-width: var(--intro-measure);
    color: var(--color-ink-muted);
    text-wrap: pretty; /* balance fights multi-line paragraphs; pretty just tends the rag */
  }
  .intro-lead { color: var(--color-ink); } /* the claim carries full ink; the rest stays quiet */
  .cv-section { margin-top: 2.625rem; } /* the landing's section rhythm */
  .cv-section .section-title { margin-bottom: 0.875rem; }

  .cv-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .cv-row:last-child { border-bottom: none; }
  .cv-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .cv-name {
    font-weight: 500;
    color: var(--color-ink);
  }
  a.cv-name {
    text-decoration: none;
  }
  a.cv-name:hover {
    color: var(--color-accent);
  }
  .cv-role {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.5;
  }
  .cv-date {
    font-weight: 300;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .cv-row { grid-template-columns: 1fr; }
    .cv-date { order: -1; margin-bottom: 0.1rem; }
  }

  /* the row's grammar: a whispered name, the one worded action, then marks.
     Icons carry no ↗ — outbound is their idiom; worded links keep the arrow. */
  .contact-lead {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }
  .contact-resume {
    color: var(--color-ink-muted);
  }
  .contact-resume:hover {
    color: var(--color-accent);
  }
  .contact-link {
    display: inline-flex;
    padding: 0.25rem; /* nudges each hit target toward 28px without loosening the row */
    color: var(--color-ink-muted);
    transition: color 150ms ease;
  }
  .contact-link:hover {
    color: var(--color-accent);
  }
</style>

<script>
  import { riseEnter } from '../scripts/enter-rise';
  const riseAbout = () => riseEnter('.about-page .enter');
  riseAbout();
  document.addEventListener('astro:page-load', riseAbout);
</script>
