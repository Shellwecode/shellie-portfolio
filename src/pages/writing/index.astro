---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchiveRow from '../../components/ArchiveRow.astro';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title="Writing — Shellie Hu"
  description="Notes on design, people, and the threads between."
>
  <div class="page-head">
    <h1 class="page-title">Writing</h1>
    <p class="page-sub">
      I write to slow down, think more deeply and creatively, and articulate
      what might otherwise go unspoken.
    </p>
  </div>
  <div style="max-width: var(--measure);">
    {
      posts.map((post) => (
        <ArchiveRow
          kind={post.data.kind ?? 'writing'}
          title={post.data.title}
          href={post.data.external ?? `/writing/${post.id}`}
          date={post.data.dateLabel ?? post.data.date}
          external={Boolean(post.data.external)}
          quiet
        />
      ))
    }
  </div>
</Base>

<style>
  /* same head voice as the work page */
  .page-head { margin-bottom: 1.5rem; }
  .page-title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .page-sub {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.55;
    max-width: var(--measure);
  }
</style>
