---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchiveRow from '../../components/ArchiveRow.astro';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  description="Notes on design, people, and the threads between."
>
  {/* Entrance parity with the landing: head first, rows follow one by one
      (late rows share a seat so a long archive never waits seconds). */}
  <div class="writing-page">
    <div class="page-head enter" style="--enter-i: 0">
      <h1 class="page-title">Writing</h1>
      <p class="page-sub">
        I write to slow down, think more deeply and creatively, and articulate
        what might otherwise go unspoken.
      </p>
    </div>
    <div style="max-width: var(--measure);">
      {
        posts.map((post, i) => (
          <div class="enter" style={`--enter-i: ${Math.min(1 + i, 7)}`}>
            <ArchiveRow
              kind={post.data.kind ?? 'writing'}
              title={post.data.title}
              href={post.data.external ?? `/writing/${post.id}`}
              date={post.data.dateLabel ?? post.data.date}
              external={Boolean(post.data.external)}
              quiet
            />
          </div>
        ))
      }
    </div>
  </div>
</Base>

<script>
  import { riseEnter } from '../../scripts/enter-rise';
  const riseWriting = () => riseEnter('.writing-page .enter');
  riseWriting();
  document.addEventListener('astro:page-load', riseWriting);
</script>

<style>
  /* same head voice as the work page */
  .page-head { margin-bottom: 1.5rem; }
  .page-title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .page-sub {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.55;
    max-width: var(--measure);
  }
</style>
