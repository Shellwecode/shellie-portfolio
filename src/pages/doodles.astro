---
import Base from '../layouts/Base.astro';

// The doodle shelf is resting until the notebook scans are ready — the
// collection plumbing lives in git history (getCollection('doodles')),
// ready to come back when the drawings do.
---

<Base
  description="Small drawings. A way to slow down."
>
  <div class="doodles-page">
    <div class="mb-12 space-y-4 text-[var(--text-lg)] leading-relaxed enter" style="max-width: var(--measure); --enter-i: 0">
      <h1 class="text-xl font-medium">Doodles</h1>
      <p class="text-[var(--color-ink-muted)]">
        Small drawings, mostly from my notebooks. More on <a
          href="https://www.instagram.com/shellwedraw/">Instagram</a
        >.
      </p>
    </div>

    <p class="coming-soon enter" style="--enter-i: 1">coming soon — I'm still scanning the notebooks.</p>
  </div>
</Base>

<script>
  import { riseEnter } from '../scripts/enter-rise';
  const riseDoodles = () => riseEnter('.doodles-page .enter');
  riseDoodles();
  document.addEventListener('astro:page-load', riseDoodles);
</script>

<style>
  /* the work shelf's empty-note voice — a whisper, not an apology */
  .coming-soon {
    margin-top: 4rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }
</style>
