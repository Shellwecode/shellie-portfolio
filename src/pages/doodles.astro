---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const doodles = (await getCollection('doodles'))
  .filter((d) => !d.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title="Doodles — Shellie Hu"
  description="Small drawings. A way to slow down."
>
  <div class="mb-12 space-y-4 text-[var(--text-lg)] leading-relaxed" style="max-width: var(--measure);">
    <h1 class="text-xl font-medium">Doodles</h1>
    <p class="text-[var(--color-ink-muted)]">
      Small drawings, mostly from my notebooks. More on <a
        href="https://www.instagram.com/shellwedraw/">Instagram</a
      >.
    </p>
  </div>

  <div class="space-y-16" style="max-width: var(--measure);">
    {
      doodles.map((d) => (
        <figure id={d.id}>
          <Image
            src={d.data.image}
            alt={d.data.alt}
            class="w-full rounded-2xl"
          />
          {d.data.caption && (
            <figcaption class="mt-3 text-sm text-[var(--color-ink-muted)]">
              <span class="font-mono text-xs mr-2">
                {d.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
              </span>
              {d.data.caption}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
</Base>
